#!/usr/bin/env bash
# Usage: kit [<command> [args]]; run a shared command from scripts/agents/kit.d/ or one of the
# project's own from the folder named by "commands" in scripts/agents/kit.json.
set -euo pipefail
kit_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=scripts/agents/kit-lib.sh
source "$kit_dir/kit-lib.sh"
KIT_ROOT=$(kit_root)

# KIT_COMMANDS_DIR (tests) replaces both folders.
if [[ -n ${KIT_COMMANDS_DIR:-} ]]; then
  folders=("$KIT_COMMANDS_DIR") headings=('Commands')
else
  folders=("$kit_dir/kit.d") headings=('Shared commands')
  own=$(kit_setting .commands)
  if [[ -n $own ]]; then
    [[ $own == /* ]] || own=$KIT_ROOT/$own
    # A "commands" naming the shared folder adds nothing; kit doctor says so.
    [[ $own -ef ${folders[0]} ]] || { folders+=("$own"); headings+=('Project commands'); }
  fi
fi

names=() files=() summaries=() groups=()
declare -A shared=()
width=0
for group in "${!folders[@]}"; do
  start=${#names[@]}
  for file in "${folders[group]}"/*; do
    base=${file##*/}
    [[ -f $file && -x $file && $base != [._]* ]] || continue
    name=${base%.*}
    summary=''
    count=0
    while IFS= read -r line || [[ -n $line ]]; do
      count=$((count + 1))
      if [[ $line == *'# kit: '* || $line == *'// kit: '* ]]; then
        [[ $line =~ (#\ kit:\ |//\ kit:\ ) ]]
        summary=${line#*"${BASH_REMATCH[0]}"}
        break
      fi
      (( count < 15 )) || break
    done < "$file"
    if (( group == 0 )); then shared[$name]=1
    elif [[ -n ${shared[$name]-} ]]; then summary="(hidden by the shared $name; kit doctor names the clash)${summary:+ $summary}"
    fi
    # Sort by the command name within its folder, which can differ from the filename's order.
    position=${#names[@]}
    while (( position > start )) && [[ ${names[position-1]} > "$name" ]]; do
      names[position]=${names[position-1]}
      files[position]=${files[position-1]}
      summaries[position]=${summaries[position-1]}
      groups[position]=${groups[position-1]}
      position=$((position - 1))
    done
    names[position]=$name files[position]=$file summaries[position]=$summary groups[position]=$group
    (( ${#name} <= width )) || width=${#name}
  done
done

list_commands() {
  local index group=-1
  printf 'Usage: kit <command> [args]\n'
  for index in "${!names[@]}"; do
    if (( groups[index] != group )); then
      group=${groups[index]}
      printf '\n%s:\n' "${headings[group]}"
    fi
    printf '  %-*s  %s\n' "$width" "${names[index]}" "${summaries[index]}"
  done
  printf "Run 'kit <command> --help' for a command's usage.\n"
}

command=${1-}
case $command in ''|help|--help|-h) list_commands; exit 0 ;; esac
shift
# The first match is the shared command: a project command never hides a shared one (kit doctor names the clash).
command_file=''
for index in "${!names[@]}"; do
  if [[ ${names[index]} == "$command" ]]; then command_file=${files[index]}; break; fi
done
if [[ -z $command_file ]]; then
  # A broken settings file hides the project folder; say so instead of only "unknown".
  unreadable='' settings_file=$(kit_settings_file)
  if [[ -z ${KIT_COMMANDS_DIR:-} && -f $settings_file ]] && ! jq empty "$settings_file" > /dev/null 2>&1; then
    unreadable=' (scripts/agents/kit.json unreadable; run kit doctor)'
  fi
  printf "kit: unknown command '%s'%s\n" "$command" "$unreadable" >&2
  list_commands >&2
  kit_result fail "unknown command $command$unreadable"
  exit 2
fi

last_result=false
partial=false
child_pid=''
signal_status=0
enforce_result=true
# Help for a subcommand (`kit wait pid --help`) is usage text, not a run.
for arg in "$@"; do
  case $arg in --help|-h) enforce_result=false; break ;; esac
done

finish() {
  local status=$?
  trap - EXIT INT TERM HUP
  if (( signal_status )); then status=$signal_status; fi
  if [[ $enforce_result == true && $last_result == false ]]; then
    [[ $partial == false ]] || printf '\n'
    if (( signal_status )); then
      kit_result fail "$command interrupted"
    elif (( status == 0 )); then
      kit_result ok "$command finished"
    else
      kit_result fail "$command exited $status without a RESULT line"
    fi
  fi
  exit "$status"
}
interrupted() {
  signal_status=$((128 + $2))
  if [[ -n $child_pid ]]; then
    kill -s "$1" "$child_pid" 2>/dev/null || :
  else
    exit "$signal_status"
  fi
}
trap finish EXIT
trap 'interrupted INT 2' INT
trap 'interrupted TERM 15' TERM
trap 'interrupted HUP 1' HUP

kit_node || :
KIT_MAIN_ROOT=$(kit_main_root)
export KIT_ROOT KIT_MAIN_ROOT
export KIT_LIB="$kit_dir/kit-lib.sh" KIT_LIB_MJS="$kit_dir/kit-lib.mjs"

# A coprocess lets the parent remember the last line without buffering stdout.
# Preserve stdin explicitly: a coprocess otherwise replaces it with a pipe.
exec {input_fd}<&0
coproc KIT_CHILD {
  # Bash ignores SIGINT in asynchronous jobs; restore it before launching.
  trap - INT TERM HUP
  # Wait until the parent has saved the pipe descriptor, even for instant exits.
  IFS= read -r _start
  exec "$command_file" "$@" <&"$input_fd"
}
child_pid=$!
exec {output_fd}<&"${KIT_CHILD[0]}"
control_fd=${KIT_CHILD[1]}
printf '\n' >&"$control_fd"
exec {control_fd}>&-
exec {input_fd}<&-
pending=''
while :; do
  line=''
  read_status=0
  IFS= read -r -u "$output_fd" line || read_status=$?
  # Signals can interrupt read halfway through a line; keep its prefix intact.
  if (( read_status > 128 )); then pending+=$line; continue; fi
  line=$pending$line
  pending=''
  if [[ -n $line || $read_status == 0 ]]; then
    printf '%s' "$line"
    last_result=false
    [[ $line != 'RESULT: '* ]] || last_result=true
    partial=true
    if (( read_status == 0 )); then printf '\n'; partial=false; fi
  fi
  (( read_status == 0 )) || break
done
exec {output_fd}<&-
status=0
wait "$child_pid" || status=$?
exit "$status"
