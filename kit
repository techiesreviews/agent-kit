#!/usr/bin/env bash
# Usage: kit [<command> [args]]; run a shared command from $KIT_HOME/kit.d/ or one of the
# project's own from the folder named by "commands" in scripts/agents/kit.json.
set -euo pipefail
kit_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# KIT_HOME is the shared kit: this folder unless a person set it (a kit checkout tried against this project).
# A front door marks the KIT_HOME it fills in itself (KIT_HOME_DEFAULT), so a nested kit in another
# worktree keeps its own folder while a person's choice reaches every nested kit.
home=$kit_dir chosen=false
if [[ -n ${KIT_HOME:-} && $KIT_HOME != "${KIT_HOME_DEFAULT:-}" ]]; then home=$KIT_HOME chosen=true; fi
if ! KIT_HOME=$(cd -- "$home" 2>/dev/null && pwd -P) || [[ ! -f $KIT_HOME/kit-lib.sh ]]; then
  printf 'kit: KIT_HOME %s is not a kit folder (no kit-lib.sh)\n' "$home" >&2
  printf 'RESULT: fail no kit at KIT_HOME %s\n' "$home"
  exit 2
fi
if [[ $chosen == true ]]; then unset KIT_HOME_DEFAULT; else export KIT_HOME_DEFAULT=$KIT_HOME; fi
export KIT_HOME
# shellcheck source=kit-lib.sh
source "$KIT_HOME/kit-lib.sh"
# --home prints this kit's folder, as the launcher does, so a launcher older than its --home still answers it.
if [[ ${1-} == --home && $# == 1 ]]; then printf '%s\n' "$KIT_HOME"; exit 0; fi
# The project root, the RESULT line and URL hiding are kit-lib.mjs's (one copy each, TOOLS-395), so everything after
# this needs Node >=24: without it, or with an older one, the front door says so and runs nothing but kit update.
if ! kit_node; then
  # kit update is how a machine gets the next kit, and it needs no project: a timer whose service was installed
  # before it carried a PATH may not reach Node 24. Its RESULT line holds back each URL it could not hide, and the
  # front door still ends a run that stops without one.
  if [[ ${1-} == update ]]; then
    last='' status=0
    exec {update_fd}< <(KIT_LIB=$KIT_HOME/kit-lib.sh "$KIT_HOME/kit.d/update" "${@:2}")
    update_pid=$!
    while IFS= read -r -u "$update_fd" line || [[ -n $line ]]; do printf '%s\n' "$line"; last=$line; done
    wait "$update_pid" || status=$?
    if [[ $last != 'RESULT: '* ]]; then
      if (( status == 0 )); then kit_result ok 'update finished'; else kit_result fail "update exited $status without a RESULT line"; fi
    fi
    exit "$status"
  fi
  kit_node_missing
  exit 2
fi
# Outside git the project is the one around this front door, not around KIT_HOME (kitRoot names the rule).
if ! KIT_ROOT=$(kit_root "$kit_dir"); then
  printf '%s\n' 'RESULT: fail kit-lib.mjs did not run (its error is above)'
  exit 2
fi

# KIT_COMMANDS_DIR (tests) replaces both folders.
if [[ -n ${KIT_COMMANDS_DIR:-} ]]; then
  folders=("$KIT_COMMANDS_DIR") headings=('Commands')
else
  folders=("$KIT_HOME/kit.d") headings=('Shared commands')
  # Without jq, kit_setting names it on stderr and the shared commands still run, so kit doctor can report it.
  own=$(kit_setting .commands) || own=''
  if [[ -n $own ]]; then
    [[ $own == /* ]] || own=$KIT_ROOT/$own
    # A "commands" naming the shared folder adds nothing; kit doctor says so.
    [[ $own -ef ${folders[0]} ]] || { folders+=("$own"); headings+=('Project commands'); }
  fi
fi

names=() files=() summaries=() groups=() inside=()
declare -A shared=()
width=0
for group in "${!folders[@]}"; do
  start=${#names[@]}
  for file in "${folders[group]}"/*; do
    base=${file##*/}
    [[ -f $file && -x $file && $base != [._]* ]] || continue
    name=${base%.*}
    summary='' helper=false
    count=0
    while IFS= read -r line || [[ -n $line ]]; do
      count=$((count + 1))
      # An inside helper (# kit-inside: …) runs by name and stays out of the list: kit version, which kit doctor shows.
      if [[ $line == '# kit-inside: '* || $line == '// kit-inside: '* ]]; then helper=true; break; fi
      if [[ $line == *'# kit: '* || $line == *'// kit: '* ]]; then
        [[ $line =~ (#\ kit:\ |//\ kit:\ ) ]]
        summary=${line#*"${BASH_REMATCH[0]}"}
        break
      fi
      (( count < 15 )) || break
    done < "$file"
    if (( group == 0 )); then shared[$name]=1
    elif [[ -n ${shared[$name]-} ]]; then summary="(hidden by the shared $name; kit doctor names the clash)${summary:+ $summary}"
    fi
    # Sort by the command name within its folder, which can differ from the filename's order.
    position=${#names[@]}
    while (( position > start )) && [[ ${names[position-1]} > "$name" ]]; do
      names[position]=${names[position-1]}
      files[position]=${files[position-1]}
      summaries[position]=${summaries[position-1]}
      groups[position]=${groups[position-1]}
      inside[position]=${inside[position-1]}
      position=$((position - 1))
    done
    names[position]=$name files[position]=$file summaries[position]=$summary groups[position]=$group inside[position]=$helper
    [[ $helper == true ]] || (( ${#name} <= width )) || width=${#name}
  done
done

list_commands() {
  local index group=-1
  printf 'Usage: kit <command> [args]\n'
  for index in "${!names[@]}"; do
    [[ ${inside[index]} == false ]] || continue
    if (( groups[index] != group )); then
      group=${groups[index]}
      printf '\n%s:\n' "${headings[group]}"
    fi
    printf '  %-*s  %s\n' "$width" "${names[index]}" "${summaries[index]}"
  done
  printf "Run 'kit <command> --help' for a command's usage.\n"
}

command=${1-}
case $command in ''|help|--help|-h) list_commands; exit 0 ;; esac
shift
# The first match is the shared command: a project command never hides a shared one (kit doctor names the clash).
command_file=''
for index in "${!names[@]}"; do
  if [[ ${names[index]} == "$command" ]]; then command_file=${files[index]}; break; fi
done
# Commands the trim cut or merged (TOOLS-235, Lex 2026-11-14; release 2 on 2026-11-15) answer with where the job went, not "unknown command".
if [[ -z $command_file && -z ${KIT_COMMANDS_DIR:-} ]]; then
  moved=''
  case $command in
    ask) moved='retired kit ask was retired on 2026-11-13: it spent paid API credit, which ran out on 2026-11-11. Write with a subscription helper instead: a T3 delegate_task to Sonnet or Opus' ;;
    status) moved='cut kit status was cut on 2026-11-14 (TOOLS-235): scripts/agents/kit ticket list shows the cards, T3 shows the linked pull requests and their checks, and the weekly kit sweep lists flaky spec files' ;;
    feedback) moved='cut kit feedback was cut on 2026-11-14 (TOOLS-235): Lex'"'"'s corrections go to the chat memory, which the weekly learning (kit sweep --learn) reads' ;;
    learn) moved='moved kit learn is now kit sweep --learn (TOOLS-235), with the same --since and --project' ;;
    slice) moved='cut kit slice was cut on 2026-11-15 (TOOLS-235): a build runs as a T3 helper thread (delegate_task with isolation "worktree") with scripts/agents/kit brief <KEY> as its task; the helper builds, proves each Done when item and lands with scripts/agents/kit pr' ;;
    fix) moved='cut kit fix was cut on 2026-11-15 (TOOLS-235): the helper fixes its own review findings in its own thread and runs kit pr again; for a new helper, scripts/agents/kit brief <KEY> --stage fix writes its brief' ;;
    next) moved='cut kit next was cut on 2026-11-15 (TOOLS-235): the Board drive schedule picks the next cards by Lex'"'"'s priorities; scripts/agents/kit ticket list shows them' ;;
    heartbeat) moved='cut kit heartbeat was cut on 2026-11-15 (TOOLS-235): the Board drive schedule (a T3 schedule_task every 2 hours) checks the helper threads and restarts stalled work' ;;
    card) moved='moved kit card was merged into the session-start hook (TOOLS-235): the card shows when a session starts; node "$(scripts/agents/kit --home)/context-card.mjs" prints it' ;;
  esac
  if [[ -n $moved ]]; then
    printf '%s\n' "${moved#* }"
    kit_result fail "$command ${moved%% *}"
    exit 2
  fi
fi
if [[ -z $command_file ]]; then
  # A broken settings file, or no jq to read it, hides the project folder; say so instead of only "unknown".
  unreadable='' settings_file=$(kit_settings_file)
  if [[ -n ${KIT_COMMANDS_DIR:-} || ! -f $settings_file ]]; then :
  elif ! command -v jq > /dev/null; then unreadable=' (jq is not installed; install jq)'
  elif ! jq empty "$settings_file" > /dev/null 2>&1; then unreadable=' (scripts/agents/kit.json unreadable; run kit doctor)'
  fi
  printf "kit: unknown command '%s'%s\n" "$command" "$unreadable" >&2
  list_commands >&2
  kit_result fail "unknown command $command$unreadable"
  exit 2
fi

last_result=false last_running=false
partial=false
child_pid=''
signal_status=0
enforce_result=true
# Help for a subcommand (`kit wait pid --help`) is usage text, not a run.
for arg in "$@"; do
  case $arg in --help|-h) enforce_result=false; break ;; esac
done

finish() {
  local status=$?
  trap - EXIT INT TERM HUP
  if (( signal_status )); then status=$signal_status; fi
  if [[ $last_running == true && $status == 75 ]]; then :
  elif [[ $enforce_result == true && $last_result == false ]]; then
    [[ $partial == false ]] || printf '\n'
    if (( signal_status )); then
      kit_result fail "$command interrupted"
    elif (( status == 0 )); then
      kit_result ok "$command finished"
    else
      kit_result fail "$command exited $status without a RESULT line"
    fi
  fi
  exit "$status"
}
interrupted() {
  signal_status=$((128 + $2))
  if [[ -n $child_pid ]]; then
    kill -s "$1" "$child_pid" 2>/dev/null || :
  else
    exit "$signal_status"
  fi
}
trap finish EXIT
trap 'interrupted INT 2' INT
trap 'interrupted TERM 15' TERM
trap 'interrupted HUP 1' HUP

# While kit pr runs spec files alone (ticket ke-88) no other kit job starts; help and the commands that only read or
# wait go on.
case $command in
  wait|version|rulebook) ;;
  *) [[ $enforce_result == false ]] || kit_quiet_wait ;;
esac

KIT_MAIN_ROOT=$(kit_main_root)
export KIT_ROOT KIT_MAIN_ROOT
# The playwright setting reaches commands as KIT_PLAYWRIGHT_MODULE, against the real top folder as kit doctor reads it;
# a person's value wins (a relative one read the same way), and KIT_PLAYWRIGHT_MODULE_DEFAULT marks the front door's
# own as KIT_HOME_DEFAULT does.
if [[ -n ${KIT_PLAYWRIGHT_MODULE:-} && $KIT_PLAYWRIGHT_MODULE != "${KIT_PLAYWRIGHT_MODULE_DEFAULT:-}" ]]; then
  playwright=$KIT_PLAYWRIGHT_MODULE own=false
else
  playwright=$(kit_setting .playwright 2>/dev/null) || playwright=''
  own=true
fi
unset KIT_PLAYWRIGHT_MODULE KIT_PLAYWRIGHT_MODULE_DEFAULT
if [[ -n $playwright ]]; then
  if [[ $playwright != /* ]]; then
    # A KIT_ROOT that cannot be entered stays as given; kit doctor fails on it anyway.
    top=$(cd -- "$KIT_ROOT" 2>/dev/null && pwd -P) || top=$KIT_ROOT
    playwright=$top/$playwright
  fi
  export KIT_PLAYWRIGHT_MODULE=$playwright
  [[ $own == false ]] || export KIT_PLAYWRIGHT_MODULE_DEFAULT=$playwright
fi
export KIT_LIB="$KIT_HOME/kit-lib.sh" KIT_LIB_MJS="$KIT_HOME/kit-lib.mjs"

# A coprocess lets the parent remember the last line without buffering stdout.
# Preserve stdin explicitly: a coprocess otherwise replaces it with a pipe.
exec {input_fd}<&0
coproc KIT_CHILD {
  # Bash ignores SIGINT in asynchronous jobs; restore it before launching.
  trap - INT TERM HUP
  # Wait until the parent has saved the pipe descriptor, even for instant exits.
  IFS= read -r _start
  exec "$command_file" "$@" <&"$input_fd"
}
child_pid=$!
exec {output_fd}<&"${KIT_CHILD[0]}"
control_fd=${KIT_CHILD[1]}
printf '\n' >&"$control_fd"
exec {control_fd}>&-
exec {input_fd}<&-
pending=''
while :; do
  line=''
  read_status=0
  IFS= read -r -u "$output_fd" line || read_status=$?
  # Signals can interrupt read halfway through a line; keep its prefix intact.
  if (( read_status > 128 )); then pending+=$line; continue; fi
  line=$pending$line
  pending=''
  if [[ -n $line || $read_status == 0 ]]; then
    printf '%s' "$line"
    last_result=false
    [[ $line != 'RESULT: '* ]] || last_result=true
    # kit go's RUNNING line stands in for the RESULT line, when go exits 75 (its job still runs).
    last_running=false
    [[ $command != go || $line != 'RUNNING: '* ]] || last_running=true
    partial=true
    if (( read_status == 0 )); then printf '\n'; partial=false; fi
  fi
  (( read_status == 0 )) || break
done
exec {output_fd}<&-
status=0
wait "$child_pid" || status=$?
exit "$status"
