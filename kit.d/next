#!/usr/bin/env node
// kit: pick the tickets that may start now and their builders; --start claims and starts them
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { basename, isAbsolute, join, normalize, relative, resolve } from "node:path";
import { kitBranch, kitDevRoot, kitHome, kitResult, kitSettings } from "../kit-lib.mjs";
import { loadTickets, parseTicket, resolveTickets } from "../tickets.mjs";

// Settings from scripts/agents/kit.json; an unreadable file still lets --help print, with placeholders.
let settings = null, settingsProblem = "";
try { settings = kitSettings(); } catch (error) { settingsProblem = error.message; }
const land = settings ? kitBranch("land", settings) : "<land>";
const mapsDir = settings?.maps || "";
const devRoot = settings ? kitDevRoot(settings) : process.env.KIT_DEV_ROOT || null;

const usage = `Usage: kit next [map…] [--start] [--max N]
       kit next --run-group --branch BRANCH --builder MODEL --ticket FILE [--ticket FILE…]
Lists the running slices (running:), the open frontier tickets that may start now (next:)
and why the rest wait (waits:),
read from origin/${land} in the dev worktree, the running slice-* jobs of every worktree
and the running kit-slice-* systemd user units.
Maps go in the order given, else alphabetical; tickets by number within a map.
Tickets sharing a group: slug are one hand-out (next: group <slug> tickets=…) once every open one
may start; a blocker inside the group counts as met, as its slices run in blocked_by order.
--start claims each next: ticket or group on ${land} (assignee, commit, push), makes its worktree and
starts its kit slice under kit bg (a group: one job running its slices in order through
--run-group); delegated (opencode/…) tickets are only claimed.
--max N lowers the cap of 5 running slices; it never raises it.
--run-group runs kit slice for each ticket in order here, stopping at the first failure: the first
on BRANCH, each later one on its own BRANCH-<NN> from the fetched origin/${land}. A rerun skips
tickets closed on origin/${land} or merged by their saved slice and resumes a slice with saved state
on its branch.`;

// Pins quoted from docs/agents/kitchen.md#who-cooks-pins-from-2026-10-22:
//   | Builder, every slice | `claude-opus-5-5`, high | `kit slice --builder claude-opus-5-5`; `builder: sol` lines in tickets are superseded |
//   | Builder, tiny fully specified fix | free OpenCode model | T3 `delegate_task`, only once T3 lists a verified zero-cost model |
//   "Sol never builds."
const pins = { "": "claude-opus-5-5", claude: "claude-opus-5-5", sol: "claude-opus-5-5" };
const reviewModel = "claude-opus-5-5";
const cap = 5;
// sharedFile: the one file two slices may share (rule 3); none when unset.
const mainTs = settings?.sharedFile || null;

// Test seams: a fake kit (bg --list and bg <name>), a fake systemctl and a fake worktree.sh.
const fakeKit = process.env.KIT_NEXT_KIT;
const worktreeScript = process.env.KIT_NEXT_WORKTREE || resolve(import.meta.dirname, "../worktree.sh");

class UsageError extends Error {}

function options(args) {
  const flags = { maps: [], start: false, max: cap, maxGiven: false, runGroup: false, branch: "", builder: "", tickets: [] };
  const value = (i, flag) => {
    if (!args[i + 1] || args[i + 1].startsWith("-")) throw new UsageError(`${flag} needs a value`);
    return args[i + 1];
  };
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === "--help" || arg === "-h") flags.help = true;
    else if (arg === "--start") flags.start = true;
    else if (arg === "--run-group") flags.runGroup = true;
    else if (arg === "--branch") flags.branch = value(i++, arg);
    else if (arg === "--builder") flags.builder = value(i++, arg);
    else if (arg === "--ticket") flags.tickets.push(value(i++, arg));
    else if (arg === "--max") {
      if (!/^\d+$/.test(args[i + 1] ?? "")) throw new UsageError("--max needs a whole number");
      flags.max = Math.min(cap, Number(args[++i]));
      flags.maxGiven = true;
    } else if (/^[\w-]+$/.test(arg) && !arg.startsWith("-")) { if (!flags.maps.includes(arg)) flags.maps.push(arg); }
    else throw new UsageError(`invalid argument: ${arg}`);
  }
  if (flags.runGroup !== Boolean(flags.branch || flags.builder || flags.tickets.length)) throw new UsageError("--branch, --builder and --ticket go with --run-group");
  if (flags.runGroup && (!flags.branch || !flags.builder || !flags.tickets.length || flags.start || flags.maxGiven || flags.maps.length)) throw new UsageError("--run-group needs --branch, --builder and --ticket, and no maps, --start or --max");
  return flags;
}

function run(command, args, { cwd = devRoot, env = process.env } = {}) {
  const result = spawnSync(command, args, { cwd, env, encoding: "utf8", maxBuffer: 32 * 1024 * 1024, stdio: ["ignore", "pipe", "pipe"] });
  if (result.error) throw result.error;
  return result;
}

function git(args, cwd = devRoot) {
  const result = run("git", ["-C", cwd, ...args]);
  if (result.status !== 0) throw new Error(`git ${args[0]} failed: ${(result.stderr || result.stdout).trim().split("\n").at(-1)}`);
  return result.stdout;
}

const tryGit = (args, cwd = devRoot) => run("git", ["-C", cwd, ...args]).status === 0;

function builderFor(builder) {
  if (builder.startsWith("opencode/")) return { model: builder, delegate: true, label: `delegate ${builder}` };
  const model = pins[builder] ?? builder;
  return { model, delegate: false, label: model };
}

// The build README names the owner prefix (`prefix: sf`) and holds `**Not started:**` until the lead starts the build.
function buildReadme(map) {
  const show = run("git", ["-C", devRoot, "show", `origin/${land}:${mapsDir}/${map}/build/README.md`]);
  const source = show.status === 0 ? show.stdout : "";
  const prefix = /^prefix:\s*`?([a-z][a-z0-9-]*)`?\s*$/m.exec(source)?.[1] ?? map;
  const top = source.split(/^## /m)[0];
  return { prefix, notStarted: /^\*\*Not started:\*\*/m.test(top) };
}

function number(slug) { return /^(\d+)-/.exec(slug)?.[1] ?? slug; }

// A map numbers tickets/ and build/tickets/ separately, so map tickets get an "m" before the number.
function naming(ticket, prefix) {
  const nn = `${ticket.file.includes("/build/tickets/") ? "" : "m"}${number(ticket.slug)}`;
  const owner = `${prefix}-${nn}`;
  return { owner, job: `slice-${prefix}${nn}`, branch: `build/${owner}-${ticket.slug.replace(/^\d+-/, "")}` };
}

// A group gets "g-" and its slug in place of a number: owner sf-g-fonts, job slice-sfg-fonts.
function groupNaming(group, prefix) {
  const owner = `${prefix}-g-${group}`;
  return { owner, job: `slice-${prefix}g-${group}`, branch: `build/${owner}` };
}

const byNumber = (a, b) => a.map.localeCompare(b.map) || a.slug.localeCompare(b.slug, "en", { numeric: true });

// One hand-out: its tickets in slice order, and the union of their Files for the fixed rules.
function unitOf(tickets, group = "") {
  return {
    group, tickets, map: tickets[0]?.map ?? "", files: [...new Set(tickets.flatMap(ticket => ticket.files))],
    runs_alone: tickets.some(ticket => ticket.runs_alone),
    label: group ? `group ${group} tickets=${tickets.map(ticket => ticket.slug).join(",")}` : tickets.map(ticket => ticket.file).join(","),
  };
}

// Hand-outs in frontier order: an ungrouped frontier ticket alone; a group once, at its first
// member that may start, holding every member not closed or wontfix in blocked_by order. A
// group waits while any member is blocked from outside it or not open.
function handOuts(tickets, frontier) {
  const index = new Map(tickets.map(ticket => [`${ticket.map}/${ticket.slug}`, ticket]));
  const groups = new Map();
  for (const ticket of tickets) {
    if (!ticket.group || !ticket.valid || ["closed", "wontfix"].includes(ticket.status)) continue;
    const key = `${ticket.map}/${ticket.group}`;
    groups.set(key, [...(groups.get(key) ?? []), ticket]);
  }
  const units = frontier.filter(ticket => !ticket.group).map(ticket => ({ first: ticket, ...unitOf([ticket]) }));
  for (const members of groups.values()) {
    members.sort(byNumber);
    const blockers = ticket => ticket.blocked_by.map(blocker => index.get(`${ticket.map}/${blocker.slug}`));
    const free = members.filter(ticket => ticket.status === "open" && blockers(ticket).every(blocker => members.includes(blocker) || blocker?.status === "closed"));
    if (!free.length) continue;
    const ordered = [], left = [...members];
    const ready = ticket => blockers(ticket).every(blocker => !members.includes(blocker) || ordered.includes(blocker));
    while (left.some(ready)) ordered.push(...left.splice(left.findIndex(ready), 1));
    const held = members.filter(ticket => !free.includes(ticket)).map(ticket => `${ticket.slug} (${ticket.status === "open" ? "blocked" : ticket.status})`);
    const wait = held.length ? `waits for ${held.join(", ")}` : left.length ? `blocked_by cycle in ${left.map(ticket => ticket.slug).join(", ")}` : "";
    units.push({ first: free[0], ...unitOf([...ordered, ...left], members[0].group), wait });
  }
  return units.sort((a, b) => byNumber(a.first, b.first));
}

function unquote(command) {
  return [...command.matchAll(/'((?:[^']|'\\'')*)'/g)].map(match => match[1].replaceAll("'\\''", "'"));
}

// A running slice's unit (its tickets' Files and map) from its command words, run in cwd. Each ticket is read
// on its own, so one unreadable ticket leaves the others' Files counting. A group job keeps the Files of members
// that already landed until it ends: safe, if broad. A ticket keys by its path inside the worktree holding it
// (the longest match), so an absolute path whose parent folders share the maps folder's name still names the right map.
function sliceUnit(words, cwd, worktrees) {
  const tickets = words.flatMap((word, i) => word === "--ticket" && words[i + 1] ? [words[i + 1]] : []).flatMap(file => {
    if (!cwd && !isAbsolute(file)) return []; // No known working directory: a relative ticket names nothing.
    const path = resolve(cwd, file), home = worktrees.filter(tree => path.startsWith(`${tree}/`)).sort((a, b) => b.length - a.length)[0];
    const key = home ? relative(home, path) : normalize(file);
    try { return [parseTicket(readFileSync(path, "utf8"), key, mapOf(key)).ticket]; }
    catch { return []; }
  });
  return unitOf(tickets, words.includes("--run-group") ? tickets.find(ticket => ticket.group)?.group ?? "" : "");
}

// Slices T3 threads run as systemd user units (`systemd-run --user --unit=kit-slice-<owner> … kit slice --ticket F`,
// so an app restart does not stop them); kit bg does not list those. No systemctl, or none running: none.
// User units are shared by every project on the machine, so a unit none of whose working directory, kit path or
// absolute --ticket lies in this repo's worktrees is another project's and is skipped; a unit naming none of
// them is unknown and still takes a slot (ticket unknown), as an unreadable kit bg job does.
function systemdSlices(worktrees) {
  const systemctl = process.env.KIT_NEXT_SYSTEMCTL || "systemctl";
  const ask = args => spawnSync(systemctl, ["--user", ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], timeout: 5000 });
  const listed = ask(["list-units", "--type=service", "--state=running", "--plain", "--no-legend", "kit-slice-*"]);
  if (listed.error || listed.status !== 0) return [];
  const ours = path => worktrees.some(tree => path === tree || path.startsWith(`${tree}/`));
  return listed.stdout.split("\n").map(row => row.trim().split(/\s+/)[0]).filter(unit => /^kit-slice-.+\.service$/.test(unit)).flatMap(unit => {
    const shown = ask(["show", "-p", "WorkingDirectory", "-p", "ExecStart", unit]).stdout ?? "";
    // An empty or home-relative (`~`) WorkingDirectory is unknown: relative --ticket paths are then unread.
    const cwd = /^WorkingDirectory=(\/.*)$/m.exec(shown)?.[1] ?? null;
    // ExecStart={ path=… ; argv[]=<words, space-separated> ; ignore_errors=… }
    const words = /^ExecStart=.*?\bargv\[\]=(.*?) ; /m.exec(shown)?.[1].split(/\s+/) ?? [];
    // Only a kit word is a place: an interpreter (`/usr/bin/bash -lc …`) says nothing about the project.
    const kitPath = words.find(word => basename(word) === "kit");
    const places = [cwd, kitPath, ...words.flatMap((word, i) => word === "--ticket" ? [words[i + 1]] : [])].filter(path => path && isAbsolute(path));
    if (places.length && !places.some(ours)) return [];
    return [{ name: unit.replace(/\.service$/, ""), worktree: cwd, unit: sliceUnit(words, cwd, worktrees) }];
  });
}

// Running slices: every worktree's `kit bg --list` rows named slice-* and running, and the running kit-slice-*
// systemd units. Each job's recorded command names its tickets (a group job several), read from its worktree.
function runningSlices() {
  const worktrees = git(["worktree", "list", "--porcelain"]).split("\n").filter(line => line.startsWith("worktree ")).map(line => line.slice(9));
  const kit = fakeKit || resolve(import.meta.dirname, "../kit");
  const slices = [];
  for (const worktree of worktrees) {
    if (!existsSync(join(worktree, ".scratch/kit-jobs"))) continue;
    const listed = run(kit, ["bg", "--list"], { cwd: worktree, env: { ...process.env, KIT_ROOT: worktree } });
    if (listed.status !== 0) throw new Error(`kit bg --list failed in ${worktree}`);
    for (const row of listed.stdout.split("\n")) {
      const [name, state] = row.split("\t");
      if (!name?.startsWith("slice-") || state !== "running") continue;
      const directory = join(worktree, ".scratch/kit-jobs", name);
      let words = [], cwd = worktree;
      try {
        words = unquote(readFileSync(join(directory, "command"), "utf8"));
        if (existsSync(join(directory, "cwd"))) cwd = readFileSync(join(directory, "cwd"), "utf8").trim();
      } catch { words = []; /* A slice whose command cannot be read still takes a slot. */ }
      slices.push({ name, worktree, unit: sliceUnit(words, cwd, worktrees) });
    }
  }
  return [...slices, ...systemdSlices(worktrees)];
}

const inside = (directory, path) => directory.endsWith("/") && (directory === "./" || path.startsWith(directory));
const overlaps = (a, b) => a === b || inside(a, b) || inside(b, a);
// The shared file (src/main.ts here) is rule 3's alone: two slices may share it, never any other file.
const shared = (files, others) => files.find(file => file !== mainTs && others.some(other => other !== mainTs && overlaps(file, other)));
const inMain = unit => Boolean(mainTs) && unit.files.some(file => overlaps(file, mainTs));
// The map a project-relative ticket path names: the folder right after the maps folder, which must
// start the path (`myplans/` is not `plans/`); else "".
const mapOf = file => file.startsWith(`${mapsDir}/`) ? /^([^/]+)\//.exec(file.slice(mapsDir.length + 1))?.[1] ?? "" : "";

// Apply the fixed rules in order to each hand-out (a ticket or a whole group, with the union of
// its Files); picked hand-outs count as running. A delegated pick has no kit bg job, so it takes
// no slot toward the cap in any run.
function plan(candidates, running, max) {
  const active = running.map(slice => ({ name: slice.name, unit: slice.unit, slot: true }));
  const runningTickets = new Set(running.flatMap(slice => slice.unit.tickets.map(ticket => ticket.file)));
  const next = [], waits = [];
  for (const candidate of candidates) {
    const { tickets, readme } = candidate;
    const wait = reason => waits.push({ unit: candidate, reason });
    const claimed = tickets.filter(ticket => ticket.assignee);
    if (claimed.length) {
      // A claimed AFK ticket with no running slice is stuck (a failed start) or delegated.
      const owners = [...new Set(claimed.map(ticket => ticket.assignee))].join(", ");
      if (claimed.length < tickets.length) wait(`partly claimed by ${owners}`);
      else if (claimed.every(ticket => ticket.type === "task (AFK)") && !claimed.every(ticket => runningTickets.has(ticket.file))) wait(`claimed by ${owners}, no running job found`);
      continue;
    }
    if (candidate.wait) { wait(candidate.wait); continue; }
    const human = tickets.find(ticket => ticket.type !== "task (AFK)");
    if (human) { wait(`needs Lex (${candidate.group ? `${human.slug} ` : ""}type: ${human.type || "missing"})`); continue; }
    if (readme.notStarted) { wait("build not started (README **Not started:**)"); continue; }
    const builders = [...new Set(tickets.map(ticket => builderFor(ticket.builder).label))];
    if (builders.length > 1) { wait(`builders differ: ${builders.join(", ")}`); continue; }
    const builder = builderFor(tickets[0].builder);
    const slots = active.filter(slice => slice.slot).length;
    if (!builder.delegate && slots >= max) { wait(`cap ${max} slices running`); continue; }
    const main = active.filter(slice => inMain(slice.unit));
    if (inMain(candidate) && main.length >= 2) { wait(`2 slices in ${mainTs}: ${main.map(slice => slice.name).join(", ")}`); continue; }
    const holder = active.find(slice => shared(candidate.files, slice.unit.files));
    if (holder) { wait(`shares ${shared(candidate.files, holder.unit.files)} with ${holder.name}`); continue; }
    const sameMap = active.filter(slice => slice.unit.map === candidate.map);
    if (candidate.runs_alone && sameMap.length) { wait(`runs alone; waits for ${sameMap.map(slice => slice.name).join(", ")}`); continue; }
    const alone = sameMap.find(slice => slice.unit.runs_alone);
    if (alone) { wait(`${alone.name} runs alone`); continue; }
    const names = candidate.group ? groupNaming(candidate.group, readme.prefix) : naming(tickets[0], readme.prefix);
    if (!/^[a-z0-9][a-z0-9._-]*$/.test(names.job)) { wait(`job name ${names.job} is not a kit bg name; add a prefix: line to the build README`); continue; }
    const same = active.find(slice => slice.name === names.job);
    if (same) { wait(`job name ${names.job} already used by ${same.unit.label || same.name}`); continue; }
    const why = builder.delegate ? "delegated, no slot" : `slot ${slots + 1}/${max}`;
    next.push({ unit: candidate, ...names, builder, why: `${why}${inMain(candidate) ? `, ${mainTs} ${main.length + 1}/2` : ""}` });
    active.push({ name: names.job, unit: candidate, slot: !builder.delegate });
  }
  return { next, waits };
}

function setAssignee(source, owner) {
  const lines = source.split("\n");
  const end = lines.findIndex((line, i) => i > 0 && line === "---");
  const at = lines.slice(0, end).findIndex(line => /^assignee:/.test(line));
  if (at > 0) lines[at] = `assignee: ${owner}`;
  else {
    const status = lines.slice(0, end).findIndex(line => /^status:/.test(line));
    lines.splice(status > 0 ? status + 1 : end, 0, `assignee: ${owner}`);
  }
  return lines.join("\n");
}

function push() {
  if (tryGit(["push", "-q", "origin", `HEAD:${land}`])) return "pushed";
  git(["fetch", "-q", "origin"]);
  if (!tryGit(["rebase", "-q", `origin/${land}`])) {
    tryGit(["rebase", "--abort"]);
    throw new Error(`claim conflicts with origin/${land}; rebase aborted`);
  }
  git(["push", "-q", "origin", `HEAD:${land}`]);
  return "pushed after rebase";
}

// Claim on the land branch: fast-forward, recheck the tickets, fill assignee, commit, push (rebase and retry once).
// A group's tickets are claimed together in one commit, or not at all.
function claim(item) {
  git(["fetch", "-q", "origin"]);
  if (git(["branch", "--show-current"]).trim() !== land) throw new Error(`${devRoot} is not on ${land}`);
  if (git(["status", "--porcelain", "--untracked-files=no"]).trim()) throw new Error(`${devRoot} has uncommitted changes`);
  if (git(["rev-list", `origin/${land}..HEAD`]).trim()) throw new Error(`${devRoot} has commits not on origin/${land}`);
  git(["merge", "-q", "--ff-only", `origin/${land}`]);
  const { tickets, map, group } = item.unit;
  const files = tickets.map(ticket => ticket.file);
  const sources = files.map(file => readFileSync(join(devRoot, file), "utf8"));
  for (const [i, ticket] of tickets.entries()) {
    const current = parseTicket(sources[i], ticket.file, map).ticket;
    if (current.assignee || current.status !== "open") return { taken: current.assignee || current.status };
    // A lone ticket that joined a group meanwhile goes out with its group, never alone.
    if (!group && current.group) return { taken: "group changed" };
  }
  if (group) {
    // A ticket that joined or left the group, or a new outside blocker, makes the plan stale.
    const loaded = loadTickets(mapsDir, map, { ref: "HEAD", cwd: devRoot });
    const now = handOuts(loaded.tickets, resolveTickets(loaded.tickets).frontier).find(candidate => candidate.group === group);
    // A member's builder or type changing meanwhile makes the plan stale too.
    const shape = list => list.map(ticket => `${ticket.file}|${ticket.type}|${builderFor(ticket.builder).label}`).join("\n");
    if (!now || now.wait || shape(now.tickets) !== shape(tickets)) return { taken: "group changed" };
  }
  files.forEach((file, i) => writeFileSync(join(devRoot, file), setAssignee(sources[i], item.owner)));
  try {
    git(["commit", "-q", "-m", `docs: claim ${map} ${group ? `group ${group}` : number(tickets[0].slug)}`, "--", ...files]);
    const how = push();
    return { sha: git(["rev-parse", "--short", "HEAD"]).trim(), how };
  } catch (error) {
    // Leave the land branch as its origin, so an unpushed claim never blocks the next run.
    tryGit(["checkout", "-q", "--", ...files]);
    tryGit(["reset", "-q", "--keep", `origin/${land}`]);
    throw error;
  }
}

function start(item) {
  const made = run(worktreeScript, [item.branch, `origin/${land}`], { env: { ...process.env, ASE_OWNER: item.owner } });
  if (made.status !== 0) throw new Error(`worktree.sh ${item.branch} failed: ${made.stderr.trim().split("\n").at(-1)}`);
  const worktree = made.stdout.trim().split("\n").at(-1);
  console.log(`worktree: ${worktree}`);
  const env = { ...process.env, ASE_REVIEW_MODEL: reviewModel, ASE_OWNER: item.owner };
  delete env.KIT_ROOT;
  // The shared kit starts the job; the job runs the worktree's front door, which keeps a person's KIT_HOME, else uses its own kit.
  const kit = fakeKit || join(kitHome(), "kit");
  const { tickets, group } = item.unit;
  const command = group
    ? ["next", "--run-group", "--branch", item.branch, "--builder", item.builder.model, ...tickets.flatMap(ticket => ["--ticket", ticket.file])]
    : ["slice", "--ticket", tickets[0].file, "--builder", item.builder.model];
  const started = run(kit, ["bg", item.job, "--", "scripts/agents/kit", ...command], { cwd: worktree, env });
  if (started.status !== 0) throw new Error(`kit bg ${item.job} failed: ${(started.stdout + started.stderr).trim().split("\n").at(-1)}`);
  console.log(`started: ${item.job}`);
  console.log(`wait: KIT_ROOT=${worktree} scripts/agents/kit wait job ${item.job} --timeout 2h`);
}

// A group's one kit bg job: its slices one after the other in this worktree, with one model and a
// fresh builder session each. kit pr lands each slice by rebase and deletes its branch, so every
// later slice starts on its own branch from the new origin/<land> (<branch>-<NN>, "m<NN>" for a map
// ticket): landed work is not reviewed again and fix rounds, counted per branch, start afresh.
// A rerun skips tickets closed on origin/<land> and returns a slice with saved state to its branch.
function runGroup({ branch, builder, tickets }) {
  const kit = fakeKit || resolve(import.meta.dirname, "../kit");
  const here = process.cwd();
  const stop = (file, i, why) => {
    kitResult("fail", `next group stopped at ${file} (slice ${i + 1}/${tickets.length})${why ? `: ${why}` : ""}`);
    process.exitCode = 1;
  };
  let ran = 0;
  for (const [i, file] of tickets.entries()) {
    try {
      git(["fetch", "-q", "origin"], here);
      // Landed: closed on origin/<land>, or merged by its slice (kit pr deleted the branch) though
      // the builder left the ticket open.
      const shown = run("git", ["-C", here, "show", `origin/${land}:${file}`]);
      const closed = shown.status === 0 && parseTicket(shown.stdout, file, "").ticket.status === "closed";
      let merged = false;
      try { merged = JSON.parse(readFileSync(join(here, ".scratch/kit-slice", basename(file, ".md"), "state.json"), "utf8")).finished?.includes("pr") === true; }
      catch { /* No saved slice, or an unreadable one: not landed. */ }
      if (closed || merged) {
        console.log(`slice ${i + 1}/${tickets.length}: ${file} ${closed ? `closed on origin/${land}` : "merged by its saved slice"}, skipped`);
        continue;
      }
      const target = i === 0 ? branch : `${branch}-${file.includes("/build/tickets/") ? "" : "m"}${number(basename(file, ".md"))}`;
      if (git(["branch", "--show-current"], here).trim() !== target) {
        if (git(["status", "--porcelain", "--untracked-files=all"], here).trim()) throw new Error("worktree not clean after the previous slice");
        const saved = existsSync(join(here, ".scratch/kit-slice", basename(file, ".md"), "state.json"));
        git(i === 0 || saved ? ["switch", "-q", target] : ["switch", "-q", "-C", target, `origin/${land}`], here);
      }
    } catch (error) { return stop(file, i, error.message); }
    console.log(`slice ${i + 1}/${tickets.length}: ${file}`);
    ran++;
    const result = spawnSync(kit, ["slice", "--ticket", file, "--builder", builder], { stdio: "inherit" });
    if (result.error || result.status !== 0) return stop(file, i, result.error?.message);
  }
  kitResult("ok", `next group ${ran} slices done${ran < tickets.length ? `, ${tickets.length - ran} landed before` : ""}`);
}

function main(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    if (!(error instanceof UsageError)) throw error;
    console.error(`${error.message}\n${usage}`);
    kitResult("fail", `next ${error.message}`);
    process.exitCode = 2;
    return;
  }
  if (flags.help) { console.log(usage); return; }
  if (!settings) throw new Error(settingsProblem);
  if (flags.runGroup) { runGroup(flags); return; }
  if (!devRoot) throw new Error("needs a dev worktree; add devRoot to scripts/agents/kit.json");
  if (!mapsDir) throw new Error("needs a maps folder; add maps to scripts/agents/kit.json");
  if (!tryGit(["fetch", "-q", "origin"])) console.log(`problem: fetch failed; using the local origin/${land}`);
  const candidates = [], problems = [];
  for (const map of flags.maps.length ? flags.maps : [undefined]) {
    const loaded = loadTickets(mapsDir, map, { ref: `origin/${land}`, cwd: devRoot });
    const resolved = resolveTickets(loaded.tickets);
    problems.push(...loaded.problems, ...resolved.problems);
    const readmes = new Map();
    for (const candidate of handOuts(loaded.tickets, resolved.frontier)) {
      if (!readmes.has(candidate.map)) readmes.set(candidate.map, buildReadme(candidate.map));
      candidates.push({ ...candidate, readme: readmes.get(candidate.map) });
    }
  }
  for (const problem of problems) console.error(`${problem.file}:${problem.line}: ${problem.message}`);
  if (problems.length) { kitResult("fail", `next ${problems.length} ticket problems`); process.exitCode = 1; return; }
  const running = runningSlices();
  for (const slice of running) console.log(`running: ${slice.name} ${slice.unit.label || "(ticket unknown)"}`);
  const { next, waits } = plan(candidates, running, flags.max);
  for (const item of next) console.log(`next: ${item.unit.label} builder=${item.builder.label} owner=${item.owner} why=${item.why}`);
  for (const { unit, reason } of waits) console.log(`waits: ${unit.label} ${reason}`);
  const summary = `next ${next.length} ready, ${waits.length} waiting`;
  if (!flags.start) { kitResult("ok", summary); return; }
  let started = 0, taken = 0;
  for (const item of next) {
    let claimed;
    try {
      claimed = claim(item);
      if (claimed.taken) { console.log(`waits: ${item.unit.label} claimed meanwhile (${claimed.taken})`); taken++; continue; }
      console.log(`claimed: ${item.unit.label} owner=${item.owner} ${claimed.sha} (${claimed.how})`);
      if (item.builder.delegate) { console.log(`delegate: ${item.unit.label} ${item.builder.model} owner=${item.owner}`); continue; }
      start(item);
      started++;
    } catch (error) {
      const landed = claimed?.sha ? `claimed ${claimed.sha} but not started: ` : "";
      kitResult("fail", `next start ${item.unit.label}: ${landed}${error.message}`);
      process.exitCode = 1;
      return;
    }
  }
  // A ticket or group claimed meanwhile moves from ready to waiting, as its waits: line says.
  kitResult("ok", `next ${next.length - taken} ready, ${waits.length + taken} waiting, ${started} started`);
}

try { main(process.argv.slice(2)); }
catch (error) { kitResult("fail", `next ${error.message}`); process.exitCode = 1; }
