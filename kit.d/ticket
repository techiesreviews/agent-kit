#!/usr/bin/env node
// kit: tickets on the Orbit board: create, read, update, dates, repeats, notes, comments, sub-tasks, next-lex, check, tidy, trash, setup, import, parity, migrate
import { spawn } from "node:child_process";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { kitOwner, kitResult, kitRoot, kitSettings } from "../kit-lib.mjs";
import { OrbitError, OrbitSetupProblem, orbitCardRedactor, orbitClient, orbitLogPath, orbitRedactor, orbitSecrets, readOrbitConfig } from "../orbit-client.mjs";
import { orbitSetup } from "../orbit-setup.mjs";
import { orbitStore, readTidyFolder, showDate, showRepeat, ticketSettings } from "../ticket-store.mjs";
import { importTickets, migrateTickets, ticketParity } from "../ticket-import.mjs";

const usage = `Usage: kit ticket <command> [options]
Tickets on the Orbit board, from any project folder. A card is named by its key, like TOOLS-10.
The card standard (one short card, history in comments, parts as sub-tasks): docs/orbit-card-standard.md in the kit
(scripts/agents/kit --home prints the kit's folder). create and update warn when a description breaks it (exit code stays 0).

Read (anyone):
  get <KEY> [--comments] [--json]                  one card, with its status, assignee_ids, next step, blockers and repeat
  list [--project KEY|all] [--status NAME] [--parent KEY] [--assignee NAME|ID|none] [--q TEXT] [--limit N] [--json]
  sub-tasks <KEY> [--json]                         the card's direct sub-tasks
  labels [--project KEY]                           the label names a board has
  members                                          the workspace members: display name and id (for --assignee)
  check <KEY> | --project KEY | --all [--json]     the cards that break the Orbit card standard, and which rule (changes nothing)

Write (leads only: ORBIT_ROLE=lead; every write takes --dry-run, which prints the exact change and sends nothing):
  create --title T [--description D | --description-file F|-] [--status NAME] [--priority P] [--project KEY]
         [--parent KEY | --no-parent] [--blocked-by KEY,KEY] [--label NAME,NAME] [--assignee NAME|ID|none] [--lex-said "<his exact words>"]
  update <KEY> [--title T] [--description D | --description-file F|- | --clear-description] [--status NAME] [--priority P]
         [--parent KEY|none] [--blocked-by KEY,KEY|none] [--label NAME,NAME | --clear-labels] [--assignee NAME|ID|none] [--lex-said "<his exact words>"]
  dates <KEY> [--start DATE] [--due DATE] --source "<where the date comes from>"   or   dates <KEY> --clear
         A new description keeps the card's "Next step", "Blocked by" and "Planned dates" lines unless it has its own.
  repeat <KEY> --every [N ]day|week|month|year [--on mon,thu] [--from due|completion]   or   repeat <KEY> --stop
         makes the card repeat: closing it (Done or Cancelled) makes Orbit create the next one with the next due date.
         --from due (the default) keeps a fixed calendar from the due date; completion counts from the day it is done.
         --on picks weekdays, for --every week from the due date only. N is 1 to 365. --stop ends the repeat.
  note <KEY> "<text>"                              a comment that starts with today's date (the description is not touched)
  comment <KEY> "<text>"                           a comment on the card
  next-lex <KEY> "<reason>" [--comment "<details>"]
                                                   first description line "Next step (Lex): reason", assigns the member called Lex,
                                                   moves a Backlog or Todo card to In Progress, and posts a comment that starts with
                                                   @Lex and the details (the reason when there are none); the same comment is never posted twice
  clear-next-lex <KEY>                             takes that line out, and Lex off the assignees (only him)
  tidy <KEY> --dir FOLDER [--dry-run]              tidies one card from FOLDER: comments.txt (comments split by a line with only -----)
                                                   are posted, then description.txt is set (the card's Next step, Planned dates and
                                                   Blocked by lines stay), then each entry of subtasks.json ([{title, description, assignee}])
                                                   becomes a sub-task. Each file is optional. A comment, or a sub-task title, already
                                                   there is skipped, so a run again finishes the rest and never doubles anything
  trash <KEY> --lex-said "<his exact words>"       moves the card and its sub-tasks to Orbit's trash (30 days)

Set up once:
  setup [--help]                                   the private Orbit setup file, step by step

Move a project's ticket files to Orbit (run in the project; leads only):
  import [--project KEY] [--dry-run]               a card per ticket file (title, status, type, assignee, blockers,
                                                   body, comments, links); a rerun finds its cards and makes no new ones
  parity [--project KEY]                           compares the files with their cards; lists every difference, fails on one
  migrate [--project KEY] [--parent KEY] [--dry-run]   import, parity, tag, then one PR through kit pr that removes the
                                                   ticket files and sets "tickets": "orbit"; with --parent, cards an
                                                   earlier import made move under it too

Without --project a board comes from "orbit": { "project": "<KEY>", "parent": "<KEY-n>" } in scripts/agents/kit.json;
parent is the card new tickets go under (--no-parent skips it). "tickets": "files"|"orbit" (default files) says which
store this project's kit next, slice, pr, status and init --issues use; with orbit they read and write these cards (a slice
claims its card with status In Progress and a "Claimed by: <owner>" line, kit pr moves it to Done when it lands). kit ticket
itself always talks to Orbit.

The rules it keeps: a move to a Publish status, adding a Publish label and a tick on "Scheduled in Radaar" need --lex-said; a card is never
deleted for good; a date needs a source. A plain date YYYY-MM-DD is a whole day in Europe/Amsterdam (a start begins at
00:00, a due date ends at 23:59); a full time with its offset is taken as it is. The public API has no relations, so blockers
are a "Blocked by: KEY-n, KEY-m" line in the description. It reads the latest version first and tries once more on a
version conflict. Each write adds one line to ~/.local/state/fleet/orbit.log. Like every kit command it ends with a
RESULT line, also after --json: a script drops that last line before it reads the JSON.

How a project moves (kit ticket migrate, from a fresh branch: git switch -c tickets-to-orbit origin/<land>):
1. It refuses while a build runs (an open AFK ticket with an assignee, kit next's claim, or a card In Progress); run it again once the build lands.
2. import: one card per ticket file in every map's tickets/ and build/tickets/, under the project's parent card. The
   card's first line "Imported from: <path> (project <name>)" names its file, then the frontmatter (Type, Assignee,
   Builder, ...), a "Blocked by:" line with the blockers' card keys and the ticket's text; each entry of its "## Comments"
   section becomes a comment. Links to other tickets point at their cards. Status: closed is Done, wontfix Cancelled,
   an open "task (AFK)" Todo, the rest Backlog (a "File status:" line keeps needs-info and the like).
3. parity: any difference stops the move before anything is tagged or removed.
4. A tag tickets-in-files-YYYYMMDD on the commit that still holds the files, pushed to origin.
5. One commit, landed with kit pr: the ticket files removed, "tickets": "orbit" and the board in scripts/agents/kit.json,
   and links in docs that named a ticket file now name its card. Maps, research notes, ADRs and other docs stay.
`;
const setupUsage = `Usage: kit ticket setup [--from-mcp-config [file]] [--from-file file] [--new-pass] [--dry-run]

Connects this computer to Orbit. It takes about 5 minutes and you do it once.

1. In Orbit, open Settings, then API tokens.
2. Create a token named fleet: service account, Tasks set to Write, the projects it should reach, expiry 90 days. Copy it. Orbit shows it one time only.
3. In a terminal, in any project folder, run: scripts/agents/kit ticket setup --from-mcp-config
4. Type yes when it asks to copy the Cloudflare pass. Your Claude settings hold the pass and Orbit's web address, and nothing else there is copied.
5. Paste the token when it asks. The screen shows nothing while you paste. That is normal. Press Enter.
6. It checks the token with Orbit and says "Saved". Say "done" in the Waiting for Lex thread.

Never paste the token in a chat.

If it cannot copy the pass, it asks you to paste the two parts instead. It also asks for Orbit's web address, or which workspace to use, when it cannot find them. The saved file stays private to you, outside every project.

Other ways to start it:
--from-file file     reads the token from that file, then deletes the file. If setup stops after that, make a new token in Orbit.
--from-mcp-config file     copies the pass from that settings file, not from your Claude settings.
--new-pass           asks for a new Cloudflare pass, when the saved one stopped working.
--dry-run            says what it would do and touches nothing.
`;

class UsageProblem extends Error {}
const cardOptions = ["title", "description", "description-file", "status", "priority", "parent", "project", "blocked-by", "label", "assignee", "lex-said"];
const commands = {
  check: { args: [], maybeKey: true, flags: ["json", "all"], values: ["project"] },
  tidy: { args: ["card key"], flags: ["dry-run"], values: ["dir"] },
  get: { args: ["card key"], flags: ["json", "comments"], values: [] },
  list: { args: [], flags: ["json"], values: ["project", "status", "parent", "assignee", "q", "limit"] },
  "sub-tasks": { args: ["card key"], flags: ["json"], values: [] },
  labels: { args: [], flags: [], values: ["project"] },
  members: { args: [], flags: [], values: [] },
  create: { args: [], flags: ["dry-run", "no-parent"], values: cardOptions },
  update: { args: ["card key"], flags: ["dry-run", "clear-description", "clear-labels"], values: cardOptions.filter(name => name !== "project") },
  dates: { args: ["card key"], flags: ["dry-run", "clear"], values: ["start", "due", "source"] },
  repeat: { args: ["card key"], flags: ["dry-run", "stop"], values: ["every", "on", "from"] },
  note: { args: ["card key", "text"], flags: ["dry-run"], values: [] },
  comment: { args: ["card key", "text"], flags: ["dry-run"], values: [] },
  "next-lex": { args: ["card key", "reason"], flags: ["dry-run"], values: ["comment"] },
  "clear-next-lex": { args: ["card key"], flags: ["dry-run"], values: [] },
  trash: { args: ["card key"], flags: ["dry-run"], values: ["lex-said"] },
  setup: { args: [], flags: ["dry-run", "new-pass"], values: ["from-file"], optional: ["from-mcp-config"] },
  import: { args: [], flags: ["dry-run"], values: ["project"] },
  parity: { args: [], flags: [], values: ["project"] },
  migrate: { args: [], flags: ["dry-run"], values: ["project", "parent"] },
};
const moving = new Set(["import", "parity", "migrate"]);
const kitCommand = process.env.KIT_TICKET_KIT || resolve(import.meta.dirname, "../kit");

function parse(name, words) {
  const spec = commands[name], found = { flags: Object.create(null), rest: [] };
  for (let index = 0; index < words.length; index++) {
    const word = words[index];
    if (word === "--") { found.rest.push(...words.slice(index + 1)); break; }
    // Help stands alone: --help anywhere as its own word, -h only right after the command. Text and values stay text.
    if (word === "--help" || (word === "-h" && index === 0)) { found.help = true; continue; }
    if (!word.startsWith("--")) { found.rest.push(word); continue; }
    const flag = word.slice(2);
    if (found.flags[flag] !== undefined) throw new UsageProblem(`--${flag} is given twice`);
    if (spec.flags.includes(flag)) found.flags[flag] = true;
    else if (spec.optional?.includes(flag)) found.flags[flag] = words[index + 1] && !words[index + 1].startsWith("-") ? words[++index] : true;
    else if (spec.values.includes(flag)) {
      // A next word shaped like an option is not a value. A lone "-" is (standard input), and so is text with spaces ("- [x] done").
      if (words[index + 1] === undefined || /^-\S+$/.test(words[index + 1])) throw new UsageProblem(`--${flag} needs a value (a one-word value cannot start with a dash)`);
      found.flags[flag] = words[++index];
    } else {
      const named = word.slice(2, word.includes("=") ? word.indexOf("=") : undefined);
      if (word.includes("=") && (spec.values.includes(named) || spec.optional?.includes(named))) throw new UsageProblem(`${name} does not take ${word}: write it as --${named} <value>`);
      throw new UsageProblem(`${name} does not take ${word}${/\s/.test(word) ? "; put -- before text that starts with dashes" : ""}`);
    }
  }
  if (found.help) return found;
  if (found.rest.length < spec.args.length) throw new UsageProblem(`${name} needs a ${spec.args[found.rest.length]}`);
  const most = spec.args.length + (spec.maybeKey ? 1 : 0);
  if (found.rest.length > most) throw new UsageProblem(`${name} does not take ${found.rest.slice(most).join(" ")}; put quotes around text`);
  return found;
}

function description(flags) {
  if (flags.description !== undefined && flags["description-file"] !== undefined) throw new UsageProblem("use --description or --description-file, not both");
  const file = flags["description-file"];
  if (file === undefined) return flags.description;
  try { return readFileSync(file === "-" ? 0 : resolve(file), "utf8"); }
  catch { throw new OrbitError(`cannot read the description from ${file}`); }
}

// Terminal control characters in card text never reach the screen; a RESULT line is one line.
const printable = value => String(value ?? "").replace(/[^\P{Cc}\n\t]|[\u061C\u200E\u200F\u202A-\u202E\u2066-\u2069]/gu, "");
const assignees = task => (task.assignee_names ?? task.assignee_ids)?.length ? (task.assignee_names ?? task.assignee_ids).join(", ") : "none";
const oneLine = text => String(text).replace(/\s*[\r\n]+\s*/g, " ");
const labelWords = task => task.label_names?.length ? `labels: ${task.label_names.join(", ")}  ` : "";
const cardLine = task => `${task.identifier}  [${task.status_name}]  ${task.priority}  assignees: ${assignees(task)}  ${labelWords(task)}${oneLine(task.title)}`;

// Errors, results and log lines hide all that looks like a secret. Card text on the screen, in --json and in a dry run
// stays whole apart from real secrets, so a script reading it gets the card's own words.
let redact = orbitRedactor(), redactCard = orbitCardRedactor();
const say = line => console.log(redactCard(printable(line)));
const sayAll = (...lines) => lines.forEach(say);
// JSON escapes only the lowest control characters: the others go out as \\uXXXX too, and parse back to the same text.
const sayJson = value => console.log(redactCard(JSON.stringify(value, null, 2)).replace(/[\u007F-\u009F\u061C\u200E\u200F\u202A-\u202E\u2066-\u2069]/g, mark => `\\u${mark.charCodeAt(0).toString(16).padStart(4, "0")}`));
function finish(status, message, code = status === "ok" ? 0 : 1) {
  kitResult(status, redact(printable(`ticket ${message}`)).replace(/\s+/g, " "));
  process.exitCode = code;
}

// What a card text breaks of the Orbit card standard: a warning each, and the exit code stays 0.
function showWarnings(list) {
  if (!list?.length) return;
  for (const { where, message } of list) say(`Warning: ${where ? `${where}: ` : ""}${message}`);
  say("The standard: docs/orbit-card-standard.md in the kit (scripts/agents/kit --home prints the kit's folder).");
}
const showDry = ({ method, path, body }) => { say(`Would send: ${method} ${path}`); if (body) sayJson(body); };

function report(name, outcome) {
  showWarnings(outcome.warnings?.map(({ message }) => ({ message })));
  if (outcome.dry) {
    for (const dry of outcome.dries ?? [outcome.dry]) showDry(dry);
    if (name === "trash") say(`Its sub-tasks (${outcome.subTasks} directly under it) would go to the trash with it.`);
    say("Dry run: nothing was sent.");
    return finish("ok", `${name} ${outcome.key} dry run`);
  }
  if (outcome.unchanged) {
    // A next step already on the card can still leave Lex unassigned: say so.
    if (outcome.assign?.note) say(`${outcome.key}: ${outcome.assign.note}`);
    return finish("ok", `${name} ${outcome.key} already as asked; nothing to send`);
  }
  if (outcome.task?.url && name !== "trash") say(`${outcome.key}  ${outcome.task.url}`);
  if (name === "next-lex") {
    say(outcome.assign?.assigned ? `${outcome.key} waits for Lex and is assigned to ${outcome.assign.assigned}.` : `${outcome.key} waits for Lex. ${outcome.assign?.note ?? ""}`.trim());
    if (outcome.fields?.includes("status_id")) say(`${outcome.key} is In Progress.`);
    if (outcome.commented) say(`${outcome.key} has a comment that starts with @Lex.`);
    else if (outcome.commentExisted) say(`${outcome.key} already has this @Lex comment.`);
  }
  if (name === "clear-next-lex") say(outcome.assign?.unassigned ? `${outcome.key} no longer waits for Lex and is no longer assigned to ${outcome.assign.unassigned}.` : `${outcome.key} no longer waits for Lex.${outcome.assign?.note ? ` ${outcome.assign.note}` : ""}`);
  if (name === "trash") say(`${outcome.key} and its sub-tasks (${outcome.subTasks} directly under it) are in Orbit's trash; members can restore them there for 30 days.`);
  finish("ok", `${name} ${outcome.key}${outcome.fields ? ` (${outcome.fields.join(", ")})` : ""}`);
}

async function show(store, key, { json, comments }) {
  const task = await store.read(key);
  const notes = comments ? await store.comments(task.identifier) : null;
  if (json) { sayJson(notes ? { ...task, comments: notes } : task); return finish("ok", `get ${task.identifier}`); }
  say(`${task.identifier}  ${oneLine(task.title)}`);
  say(`Status: ${task.status_name}  Priority: ${task.priority}`);
  say(`Assignees: ${assignees(task)}`);
  if (task.label_names.length) say(`Labels: ${task.label_names.join(", ")}`);
  if (task.next_lex !== null) say(`Next step (Lex): ${task.next_lex}`);
  if (task.blocked_by.length) say(`Blocked by: ${task.blocked_by.join(", ")}`);
  if (task.recurrence) say(`Repeats: ${showRepeat(task.recurrence)}`);
  if (task.due_at) say(`Dates: ${[task.due_start_at && `start ${showDate(task.due_start_at, "start")}`, `due ${showDate(task.due_at, "due")}`].filter(Boolean).join(", ")}`);
  if (task.parent_task_id) say(`Parent: ${task.parent_key ?? `${task.parent_task_id} (this token cannot read it)`}`);
  say(`Version: ${task.version}`);
  if (task.url) say(`Link: ${task.url}`);
  if (task.description) say(`\n${task.description}`);
  for (const note of notes ?? []) say(`\n--- ${note.author_service_account?.name ?? note.author_id ?? "someone"}, ${note.created_at}\n${note.body}`);
  finish("ok", `get ${task.identifier}`);
}

function showList(label, { items, more }, json, moreHint = "") {
  if (json) sayJson(items);
  else for (const task of items) say(cardLine(task));
  finish("ok", `${label}: ${items.length} card${items.length === 1 ? "" : "s"}${more ? `; more exist${moreHint}` : ""}`);
}

async function main() {
  const [name, ...words] = process.argv.slice(2);
  if (name === undefined) { process.stderr.write(usage); throw new UsageProblem("Usage: kit ticket <command>; see kit ticket --help"); }
  if (name === "--help" || name === "-h" || name === "help") return void process.stdout.write(usage);
  if (!Object.hasOwn(commands, name)) throw new UsageProblem(`unknown command ${name}; see kit ticket --help`);
  const { flags, rest, help } = parse(name, words);
  if (help) return void process.stdout.write(name === "setup" ? setupUsage : usage);
  const [key, wording] = rest;

  if (name === "setup") {
    const message = await orbitSetup({ flags: { fromFile: flags["from-file"], fromMcpConfig: flags["from-mcp-config"], dryRun: flags["dry-run"], newPass: flags["new-pass"] }, say });
    return finish("ok", message);
  }

  let settings = {}, settingsProblem = "";
  try { settings = kitSettings(kitRoot()); }
  catch (error) {
    // Moving a project's tickets reads its settings: no kit project, or broken settings, stops it.
    if (moving.has(name)) throw new OrbitError(`${name} runs in a kit project: ${error.message}`);
    if (!/^no scripts\/agents\/kit\.json/.test(error.message)) settingsProblem = error.message;
  }
  const own = ticketSettings(settings);
  const project = moving.has(name) ? flags.project ?? own.project : own.project;
  // kit.json's parent card sits on kit.json's board: another --project board gets no default parent.
  const sameBoard = String(project ?? "").toLowerCase() === String(own.project ?? "").toLowerCase();
  const parent = name === "migrate" && flags.parent !== undefined ? flags.parent : sameBoard ? own.parent : null;

  const config = readOrbitConfig();
  redact = orbitRedactor(orbitSecrets(config));
  redactCard = orbitCardRedactor(orbitSecrets(config));
  const dryRun = Boolean(flags["dry-run"]);
  const store = orbitStore({ client: orbitClient(config), role: process.env.ORBIT_ROLE, who: kitOwner(), logPath: orbitLogPath(), redact, secrets: orbitSecrets(config), dryRun,
    defaults: { project, parent, problem: settingsProblem } });

  switch (name) {
    case "get": return show(store, key, flags);
    case "list": {
      const limit = flags.limit === undefined ? 50 : Number(flags.limit);
      if (!Number.isInteger(limit) || limit < 1 || limit > 1000) throw new UsageProblem("--limit must be a whole number from 1 to 1000");
      return showList("list", await store.list({ project: flags.project, status: flags.status, parent: flags.parent, assignee: flags.assignee, q: flags.q, limit }), flags.json, " (use --limit)");
    }
    case "members": {
      const members = await store.members();
      for (const member of members) say(`${oneLine(member.display_name)}  ${member.user_id}`);
      return finish("ok", `members: ${members.length} member${members.length === 1 ? "" : "s"}`);
    }
    case "labels": {
      const { board, items } = await store.labels(flags.project);
      for (const label of items) say(oneLine(label.name));
      return finish("ok", `labels ${board}: ${items.length} label${items.length === 1 ? "" : "s"}`);
    }
    case "sub-tasks": return showList(`sub-tasks ${key}`, await store.subTasks(key), flags.json);
    case "create": {
      if (flags.parent !== undefined && flags["no-parent"]) throw new UsageProblem("use --parent or --no-parent, not both");
      return report(name, await store.create({ project: flags.project, title: flags.title, description: description(flags), status: flags.status, priority: flags.priority, parent: flags.parent, noParent: flags["no-parent"], blocked: flags["blocked-by"], label: flags.label, assignee: flags.assignee, lexSaid: flags["lex-said"] }));
    }
    case "update": return report(name, await store.update(key, { title: flags.title, description: description(flags), clearDescription: flags["clear-description"], status: flags.status, priority: flags.priority, parent: flags.parent, blocked: flags["blocked-by"], label: flags.label, assignee: flags.assignee, clearLabels: flags["clear-labels"], lexSaid: flags["lex-said"] }));
    case "dates": return report(name, await store.dates(key, { start: flags.start, due: flags.due, source: flags.source, clear: flags.clear }));
    case "repeat": return report(name, await store.repeat(key, { every: flags.every, on: flags.on, from: flags.from, stop: flags.stop }));
    case "note": return report(name, await store.note(key, wording));
    case "check": {
      const chosen = [key !== undefined, flags.project !== undefined, Boolean(flags.all)].filter(Boolean).length;
      if (chosen !== 1) throw new UsageProblem("check needs exactly one of a card key, --project KEY or --all");
      const { total, more, broken, key: card } = await store.check({ key, project: flags.project, all: flags.all });
      const where = key !== undefined ? card : flags.all ? "all boards" : flags.project;
      if (flags.json) sayJson(broken);
      else if (key !== undefined && !broken.length) say(`${card} follows the standard.`);
      else for (const item of broken) { say(`${item.identifier}  [${item.status}]  ${oneLine(item.title)}`); for (const problem of item.problems) say(`  - ${problem}`); }
      return finish("ok", `check ${where}: ${broken.length} of ${total} card${total === 1 ? "" : "s"} ${total === 1 ? "breaks" : "break"} the standard${more ? "; more exist, only the first 1000 were read" : ""}`);
    }
    case "tidy": {
      if (flags.dir === undefined) throw new UsageProblem("tidy needs --dir FOLDER (with description.txt, comments.txt and subtasks.json)");
      const folder = readTidyFolder(resolve(flags.dir));
      const done = await store.tidy(key, folder, { step: ({ message, dry }) => { say(message); if (dry) showDry(dry); } });
      showWarnings(done.warnings);
      const count = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
      if (dryRun) { say("Dry run: nothing was sent."); return finish("ok", `tidy ${done.key} dry run: ${count(done.comments, "comment")} to post, description ${done.description === "set" ? "to set" : done.description === "absent" ? "not in the folder" : "already set"}, ${count(done.subTasks, "sub-task")} to create`); }
      if (!done.comments && done.description !== "set" && !done.subTasks) return finish("ok", `tidy ${done.key}: nothing to do`);
      return finish("ok", `tidy ${done.key}: ${count(done.comments, "comment")}, description ${done.description === "set" ? "set" : done.description === "absent" ? "not in the folder" : "already set"}, ${count(done.subTasks, "sub-task")}`);
    }
    case "comment": return report(name, await store.comment(key, wording));
    case "next-lex": return report(name, await store.nextLex(key, wording, { comment: flags.comment }));
    case "clear-next-lex": return report(name, await store.clearNextLex(key));
    case "trash": return report(name, await store.trash(key, flags["lex-said"]));
    case "import": {
      if (!project) throw new UsageProblem('which board? Add --project <KEY>, or "orbit": { "project": "<KEY>" } to scripts/agents/kit.json');
      const done = await importTickets({ store, root: kitRoot(), settings, project, dryRun, say: sayAll });
      if (dryRun) say("Dry run: nothing was sent.");
      return finish("ok", `import ${done.tickets} tickets into ${done.board}${dryRun ? " (dry run)" : ""}: ${done.created} ${dryRun ? "to create" : "created"}, ${done.updated} ${dryRun ? "to update" : "updated"}, ${done.unchanged} unchanged, ${done.comments} comment${done.comments === 1 ? "" : "s"} ${dryRun ? "to add" : "added"}`);
    }
    case "parity": {
      if (!project) throw new UsageProblem('which board? Add --project <KEY>, or "orbit": { "project": "<KEY>" } to scripts/agents/kit.json');
      const { differences, tickets, cards, board } = await ticketParity({ store, root: kitRoot(), settings, project });
      for (const line of differences) say(line);
      if (differences.length) return finish("fail", `parity ${board}: ${differences.length} difference${differences.length === 1 ? "" : "s"} (${tickets} files, ${cards} cards)`);
      return finish("ok", `parity ${board}: ${tickets} files and ${cards} cards match`);
    }
    case "migrate": {
      const root = kitRoot();
      // kit pr's lines show as they come, indented under step 5, so the last line at the margin is migrate's own RESULT.
      const runPr = args => new Promise(done => {
        const child = spawn(kitCommand, args, { cwd: root, stdio: ["ignore", "pipe", "pipe"], env: process.env });
        for (const stream of [child.stdout, child.stderr]) {
          let rest = "";
          stream.setEncoding("utf8").on("data", chunk => {
            const lines = (rest + chunk).split("\n");
            rest = lines.pop();
            for (const line of lines) say(`   ${line}`);
          }).on("end", () => { if (rest) say(`   ${rest}`); });
        }
        child.once("error", () => done(false));
        child.once("close", status => done(status === 0));
      });
      const outcome = await migrateTickets({ store, root, settings, project, parent, moveExisting: flags.parent !== undefined, dryRun, say: sayAll, runPr });
      return finish(outcome.status, outcome.message);
    }
  }
}

try { await main(); }
catch (error) {
  if (error instanceof UsageProblem) finish("fail", error.message, 2);
  else if (error instanceof OrbitError || error instanceof OrbitSetupProblem) finish("fail", error.message);
  // Anything else stays one plain line: a stack or a system error can quote what it was reading.
  else finish("fail", `stopped on an unexpected error (${error?.code ?? error?.name ?? "unknown"})`);
}
