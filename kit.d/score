#!/usr/bin/env node
// kit: print the scoreboard the kit recorded per piece: builder, time, rounds, findings, cost, PR
import { execFileSync } from "node:child_process";
import { existsSync, mkdirSync, readdirSync, readFileSync, realpathSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { allProjectsPage, scorePage } from "../score-page.mjs";
import { feedbackKinds, loadFeedback, loadTickets } from "../tickets.mjs";

const { kitRoot, kitMainRoot, kitMaps, kitProjects, kitResult, kitSettings, kitStateDir, costTotal } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit score [map] [--json] [--snapshot] [--html [--out FILE]]\n       kit score --all [--json] [--html [--out FILE]]\n" +
  "Records: main root .scratch/scoreboard/<map>/<ticket-slug>.json (no map: every map with records).\n" +
  "--json prints the merged data; --snapshot writes <maps>/<map>/build/scoreboard.json for the lead to commit.\n" +
  "--html writes the build's page (one self-contained HTML file) to main root .scratch/scoreboard/<map>/page.html or FILE and prints its path.\n" +
  "--all reads every project in the machine's projects.json where its records are (its main folder's .scratch/scoreboard/ and\n" +
  "<maps>/*/build/feedback.md on its land branch) and prints one table: per project and builder, pieces, rounds, findings by kind, landings, and\n" +
  "Lex's corrections on the project's line; copies nothing; a project that cannot be read gets one line saying why.\n" +
  "With --html the table is a page, main root .scratch/scoreboard/all-projects.html or FILE.\n";

function options(args) {
  const flags = { json: false, snapshot: false, html: false, all: false };
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (["--json", "--snapshot", "--html", "--all"].includes(arg) && !flags[arg.slice(2)]) flags[arg.slice(2)] = true;
    else if (arg === "--out" && flags.out === undefined && args[i + 1] && !args[i + 1].startsWith("-")) flags.out = args[++i];
    else if (flags.map === undefined && /^[\w][\w.-]*$/.test(arg)) flags.map = arg;
    else throw new Error(`invalid option: ${arg}`);
  }
  if (flags.all && flags.map) throw new Error("--all takes no map");
  if (flags.all && flags.snapshot) throw new Error("--snapshot needs a map, not --all");
  if (flags.snapshot && !flags.map) throw new Error("--snapshot needs a map");
  if (flags.html && !flags.map && !flags.all) throw new Error("--html needs a map or --all");
  if (flags.out !== undefined && !flags.html) throw new Error("--out needs --html");
  return flags;
}

// Totals credit the model that did the build; a row also names a later builder of fix rounds.
const label = builder => {
  const built = builder?.built ?? builder?.model;
  if (!built) return "unknown";
  return built === builder.model && builder.effort && builder.effort !== "high" ? `${built} (${builder.effort})` : built;
};
const row = builder => builder?.built && builder.model && builder.built !== builder.model ? `${label(builder)} -> ${builder.model}` : label(builder);

function addCounts(total, counts) {
  for (const [kind, count] of Object.entries(counts ?? {})) if (count) total[kind] = (total[kind] ?? 0) + count;
  return total;
}

// Minutes are the summed phase durations, so time paused between reruns does not count.
function minutes(phases) {
  const spans = (phases ?? []).map(({ start, end }) => Date.parse(end) - Date.parse(start)).filter(span => span >= 0);
  return spans.length ? Math.round(spans.reduce((sum, span) => sum + span, 0) / 6_000) / 10 : null;
}

// Machine-local folders are shown relative to the main root; the per-run cost map stays private.
function piece(name, record, main) {
  const local = path => typeof path === "string" && path.startsWith(`${main}/`) ? relative(main, path) : path;
  const { costs: _costs, ...shown } = record;
  return { piece: name, ...shown, reviews: (record.reviews ?? []).map(review => ({ ...review, dir: local(review.dir) })),
    minutes: minutes(record.phases), findings: (record.reviews ?? []).reduce((total, review) => addCounts(total, review.counts?.kind), {}) };
}

function totals(pieces, key) {
  const groups = {};
  for (const item of pieces) {
    const group = groups[key(item)] ??= { pieces: 0, minutes: 0, rounds: 0, findings: {}, cost: { build: null, review: null } };
    group.pieces++;
    group.minutes = Math.round((group.minutes + (item.minutes ?? 0)) * 10) / 10;
    group.rounds += item.rounds ?? 0;
    addCounts(group.findings, item.findings);
    // Builder and review cost stay apart, so a priced review never reads as the builder's cost.
    for (const role of ["build", "review"]) group.cost[role] = costTotal([group.cost[role], item.cost?.[role]]);
  }
  return Object.fromEntries(Object.entries(groups).sort(([a], [b]) => a.localeCompare(b)));
}

function mapData(map, main, root, maps) {
  const folder = join(main, ".scratch/scoreboard", map), pieces = [];
  const names = existsSync(folder) ? readdirSync(folder).filter(name => name.endsWith(".json")).sort() : [];
  for (const name of names) {
    try { pieces.push(piece(name.slice(0, -5), JSON.parse(readFileSync(join(folder, name), "utf8")), main)); }
    catch (error) { console.error(`problem: scoreboard ${join(folder, name)} unreadable (${error.message})`); }
  }
  let feedback = null;
  // No maps folder: no feedback logs to read.
  if (maps) try { feedback = readFileSync(join(root, maps, map, "build/feedback.md"), "utf8"); } catch { /* No feedback log yet. */ }
  return { map, pieces, totals: { builders: totals(pieces, item => label(item.builder)), kinds: totals(pieces, item => item.kind || "unknown") }, feedback };
}

function writeAtomic(path, text) {
  const temporary = `${path}.${process.pid}.tmp`;
  try {
    writeFileSync(temporary, text);
    renameSync(temporary, path);
  } finally { rmSync(temporary, { force: true }); }
}

// Finished builds are maps with a committed scoreboard snapshot, oldest first by their last merge.
function finishedBuilds(root, maps) {
  const folder = join(root, maps), builds = [];
  for (const map of existsSync(folder) ? readdirSync(folder).sort() : []) {
    let snapshot;
    try { snapshot = JSON.parse(readFileSync(join(folder, map, "build/scoreboard.json"), "utf8")); } catch { continue; }
    const times = (snapshot.pieces ?? []).flatMap(item => [item.landed?.at, ...(item.phases ?? []).map(phase => phase.end)]).filter(Boolean).sort();
    let feedback = null;
    try { feedback = readFileSync(join(folder, map, "build/feedback.md"), "utf8"); } catch { /* No corrections recorded. */ }
    builds.push({ map, at: times.at(-1) ?? "", feedback });
  }
  return builds.sort((a, b) => a.at.localeCompare(b.at) || a.map.localeCompare(b.map));
}

function page(data, root, maps, out) {
  // Every ticket of the map: build tickets are the pieces, and a fix may name a map ticket.
  const { tickets } = loadTickets(join(root, maps), data.map);
  const pieces = data.pieces.map(item => ({ ...item, who: label(item.builder) }));
  mkdirSync(dirname(out), { recursive: true });
  writeAtomic(out, scorePage({ data: { ...data, pieces }, tickets, builds: finishedBuilds(root, maps), maps }));
}

const findingsText = findings => Object.entries(findings).map(([kind, count]) => `${kind} ${count}`).join(", ") || "none";
// Dollars and tokens side by side; ">=" marks dollars that leave out runs which reported tokens only.
const costText = cost => [Number.isFinite(cost?.usd) ? `${cost.partial ? ">=" : ""}$${cost.usd.toFixed(2)}` : "",
  Number.isFinite(cost?.tokens) ? `${(cost.tokens / 1000).toFixed(1)}k tok` : ""].filter(Boolean).join(" ") || "-";
const minutesText = value => value === null || value === undefined ? "-" : String(Math.round(value));

function table(rows) {
  if (!rows.length) return "";
  const widths = rows[0].map((_, column) => Math.max(...rows.map(row => row[column].length)));
  return rows.map(row => row.map((cell, column) => column === row.length - 1 ? cell : cell.padEnd(widths[column])).join("  ").trimEnd()).join("\n");
}

function print(data) {
  console.log(`score: ${data.map} (${data.pieces.length} pieces)`);
  if (!data.pieces.length) return;
  console.log(table([["piece", "builder", "min", "rounds", "findings", "build cost", "review cost", "PR"], ...data.pieces.map(item => [
    item.piece, row(item.builder), minutesText(item.minutes), String(item.rounds ?? 0), findingsText(item.findings), costText(item.cost?.build),
    costText(item.cost?.review), item.landed?.pr ? `#${item.landed.pr}${item.landed.sha ? "" : " open"}` : "-"])]));
  for (const [name, groups] of [["builder", data.totals.builders], ["kind", data.totals.kinds]]) {
    console.log(`totals by ${name}:`);
    console.log(table(Object.entries(groups).map(([key, group]) => [`  ${key}`, `${group.pieces} pieces`, `${minutesText(group.minutes)} min`,
      `${group.rounds} rounds`, findingsText(group.findings), `build ${costText(group.cost.build)}`, `review ${costText(group.cost.review)}`])));
  }
}

const plural = (count, word) => `${count} ${word}${count === 1 ? "" : "s"}`;
const oneLine = text => String(text).replace(/[\n\r]+/g, " ");

// A project's feedback logs, read from its land branch (origin's, else the local one), where they are committed;
// a folder outside git or without that branch is read as it stands. A main folder on an old branch may lack the
// settings file; the settings of the project this command runs in still name its maps folder and land branch.
// A log that cannot be read leaves the project's other numbers standing.
function feedbackLogs(project, root) {
  try { return readFeedbackLogs(project, root); }
  catch (error) { return { problem: oneLine(error.message) }; }
}

function readFeedbackLogs(project, root) {
  let settings;
  try { settings = kitSettings(root); }
  catch (error) {
    let own = null;
    try { own = kitSettings(resolve(kitRoot())); } catch { /* No settings here either. */ }
    if (own?.project !== project) return { problem: oneLine(error.message) };
    settings = own;
  }
  if (!settings.maps) return { problem: "no maps folder in its settings" };
  const land = settings.branches.land;
  for (const ref of [`refs/remotes/origin/${land}`, `refs/heads/${land}`]) {
    try { execFileSync("git", ["-C", root, "rev-parse", "--verify", "--quiet", `${ref}^{commit}`], { stdio: "ignore" }); }
    catch { continue; }
    // Paths from the repository's top, so a root inside a bigger repository reads its own logs.
    const top = execFileSync("git", ["-C", root, "rev-parse", "--show-toplevel"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
    return { logs: loadFeedback(relative(realpathSync(top), join(realpathSync(root), settings.maps)), { ref, cwd: top }) };
  }
  const folder = join(root, settings.maps);
  return existsSync(folder) ? { logs: loadFeedback(folder) } : { problem: `no folder ${folder}` };
}

// Kinds in one order on every row: the review kinds, then any other.
const kindOrder = ["fault", "ticket", "race", "style", "unsorted", "gap"];
const ordered = counts => Object.fromEntries(Object.entries(counts).sort(([a], [b]) =>
  ((kindOrder.indexOf(a) + 1 || 99) - (kindOrder.indexOf(b) + 1 || 99)) || a.localeCompare(b)));

// --all: one listed project's numbers, read where its records already are; nothing is copied or written.
// A feedback line names no builder, so Lex's corrections go on the project's own line, not a builder's.
function projectData(project, entry) {
  const root = typeof entry?.root === "string" && entry.root ? entry.root : null;
  if (!root) return { project, root, problem: 'no "root" in projects.json' };
  try { if (!statSync(root).isDirectory()) return { project, root, problem: `${root} is not a folder` }; }
  catch { return { project, root, problem: `no folder ${root}` }; }
  try {
    const parent = join(root, ".scratch/scoreboard");
    const names = existsSync(parent) ? readdirSync(parent).filter(name => statSync(join(parent, name)).isDirectory()).sort() : [];
    const pieces = names.flatMap(map => mapData(map, root, root, null).pieces);
    const { logs, problem } = feedbackLogs(project, root);
    const corrections = logs ? logs.entries.filter(entry => Object.hasOwn(feedbackKinds, entry.kind)).length : null;
    const group = items => ({ pieces: items.length, rounds: items.reduce((sum, item) => sum + (item.rounds ?? 0), 0),
      findings: ordered(items.reduce((total, item) => addCounts(total, item.findings), {})), landed: items.filter(item => item.landed?.sha).length });
    const builders = Map.groupBy(pieces, item => label(item.builder));
    return { project, root, builders: Object.fromEntries([...builders].sort(([a], [b]) => a.localeCompare(b)).map(([who, items]) => [who, group(items)])),
      total: { ...group(pieces), corrections }, ...problem ? { correctionsProblem: problem } : {} };
  } catch (error) { return { project, root, problem: oneLine(error.message) }; }
}

function printAll(projects) {
  const read = projects.filter(item => !item.problem);
  console.log(`score: all projects (${plural(projects.length, "project")}, ${plural(read.reduce((sum, item) => sum + item.total.pieces, 0), "piece")})`);
  const cells = (project, who, group, corrections) => [project, who, String(group.pieces), String(group.rounds), findingsText(group.findings), String(group.landed), corrections];
  if (read.length) console.log(table([["project", "builder", "pieces", "rounds", "findings", "landed", "corrections"], ...read.flatMap(item => [
    ...Object.entries(item.builders).map(([who, group]) => cells(item.project, who, group, "-")),
    cells(item.project, "all builders", item.total, item.total.corrections === null ? "not read" : String(item.total.corrections))])]));
  for (const item of read.filter(item => item.correctionsProblem)) console.log(`corrections not read: ${item.project} (${item.correctionsProblem})`);
  for (const item of projects.filter(item => item.problem)) console.log(`unreadable: ${item.project} (${item.problem})`);
}

function scoreAll(flags) {
  const listed = kitProjects();
  const projects = Object.keys(listed).sort().map(name => projectData(name, listed[name]));
  const count = projects.reduce((sum, item) => sum + (item.total?.pieces ?? 0), 0), unreadable = projects.filter(item => item.problem).length;
  if (flags.html) {
    const out = flags.out ? resolve(flags.out) : join(resolve(kitMainRoot()), ".scratch/scoreboard/all-projects.html");
    mkdirSync(dirname(out), { recursive: true });
    writeAtomic(out, allProjectsPage({ projects }));
    (flags.json ? console.error : console.log)(`page: ${out}`);
  }
  if (flags.json) console.log(JSON.stringify({ projects }, null, 2));
  else if (!flags.html) {
    if (!projects.length) console.log(`score: no projects in ${join(kitStateDir(), "projects.json")}`);
    else printAll(projects);
  }
  kitResult("ok", `score all ${plural(projects.length, "project")} ${plural(count, "piece")}${unreadable ? `, ${unreadable} unreadable` : ""}`);
  return 0;
}

function score(args) {
  let flags;
  try { flags = options(args); }
  catch (error) { process.stderr.write(usage); kitResult("fail", `score ${error.message}`); return 2; }
  try {
    if (flags.all) return scoreAll(flags);
    const main = resolve(kitMainRoot()), root = resolve(kitRoot()), parent = join(main, ".scratch/scoreboard");
    // Only --snapshot and --html need a maps folder; listing records works without one.
    let mapsDir = null;
    try { mapsDir = kitMaps(); } catch (error) { if (flags.snapshot || flags.html) throw error; }
    const maps = flags.map ? [flags.map] : existsSync(parent) ? readdirSync(parent).filter(name => statSync(join(parent, name)).isDirectory()).sort() : [];
    const data = maps.map(map => mapData(map, main, root, mapsDir)).filter(item => flags.map || item.pieces.length);
    if (flags.snapshot) {
      const map = join(root, mapsDir, flags.map);
      if (!existsSync(join(map, "build"))) throw new Error(`no build folder for map ${flags.map} (${mapsDir}/${flags.map}/build)`);
      const path = join(map, "build/scoreboard.json");
      writeAtomic(path, JSON.stringify(data[0], null, 2) + "\n");
      // --json keeps stdout to the data alone.
      (flags.json ? console.error : console.log)(`snapshot: ${relative(root, path)}`);
    }
    if (flags.html) {
      if (!existsSync(join(root, mapsDir, flags.map))) throw new Error(`no map ${flags.map} (${mapsDir}/${flags.map})`);
      const out = flags.out ? resolve(flags.out) : join(main, ".scratch/scoreboard", flags.map, "page.html");
      page(data[0], root, mapsDir, out);
      (flags.json ? console.error : console.log)(`page: ${out}`);
    }
    const count = data.reduce((sum, item) => sum + item.pieces.length, 0);
    if (flags.json) console.log(JSON.stringify(flags.map ? data[0] : { maps: data }, null, 2));
    else if (!flags.snapshot && !flags.html) {
      if (!data.length) console.log("score: no records");
      data.forEach(print);
    }
    kitResult("ok", `score ${flags.map ?? `${data.length} maps`} ${count} pieces`);
    return 0;
  } catch (error) { kitResult("fail", `score ${error.message}`); return 1; }
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = score(process.argv.slice(2));
