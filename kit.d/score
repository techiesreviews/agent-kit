#!/usr/bin/env node
// kit: print the scoreboard the kit recorded per piece: builder, time, rounds, findings, cost, PR
import { existsSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";

const { kitRoot, kitMainRoot, kitResult, costTotal } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit score [map] [--json] [--snapshot]\nRecords: main root .scratch/scoreboard/<map>/<ticket-slug>.json (no map: every map with records).\n" +
  "--json prints the merged data; --snapshot writes docs/wayfinder/<map>/build/scoreboard.json for the lead to commit.\n";

function options(args) {
  const flags = { json: false, snapshot: false };
  for (const arg of args) {
    if (["--json", "--snapshot"].includes(arg) && !flags[arg.slice(2)]) flags[arg.slice(2)] = true;
    else if (flags.map === undefined && /^[\w][\w.-]*$/.test(arg)) flags.map = arg;
    else throw new Error(`invalid option: ${arg}`);
  }
  if (flags.snapshot && !flags.map) throw new Error("--snapshot needs a map");
  return flags;
}

// Totals credit the model that did the build; a row also names a later builder of fix rounds.
const label = builder => {
  const built = builder?.built ?? builder?.model;
  if (!built) return "unknown";
  return built === builder.model && builder.effort && builder.effort !== "high" ? `${built} (${builder.effort})` : built;
};
const row = builder => builder?.built && builder.model && builder.built !== builder.model ? `${label(builder)} -> ${builder.model}` : label(builder);

function addCounts(total, counts) {
  for (const [kind, count] of Object.entries(counts ?? {})) if (count) total[kind] = (total[kind] ?? 0) + count;
  return total;
}

// Minutes are the summed phase durations, so time paused between reruns does not count.
function minutes(phases) {
  const spans = (phases ?? []).map(({ start, end }) => Date.parse(end) - Date.parse(start)).filter(span => span >= 0);
  return spans.length ? Math.round(spans.reduce((sum, span) => sum + span, 0) / 6_000) / 10 : null;
}

// Machine-local folders are shown relative to the main root; the per-run cost map stays private.
function piece(name, record, main) {
  const local = path => typeof path === "string" && path.startsWith(`${main}/`) ? relative(main, path) : path;
  const { costs: _costs, ...shown } = record;
  return { piece: name, ...shown, reviews: (record.reviews ?? []).map(review => ({ ...review, dir: local(review.dir) })),
    minutes: minutes(record.phases), findings: (record.reviews ?? []).reduce((total, review) => addCounts(total, review.counts?.kind), {}) };
}

function totals(pieces, key) {
  const groups = {};
  for (const item of pieces) {
    const group = groups[key(item)] ??= { pieces: 0, minutes: 0, rounds: 0, findings: {}, cost: { build: null, review: null } };
    group.pieces++;
    group.minutes = Math.round((group.minutes + (item.minutes ?? 0)) * 10) / 10;
    group.rounds += item.rounds ?? 0;
    addCounts(group.findings, item.findings);
    // Builder and review cost stay apart, so a priced review never reads as the builder's cost.
    for (const role of ["build", "review"]) group.cost[role] = costTotal([group.cost[role], item.cost?.[role]]);
  }
  return Object.fromEntries(Object.entries(groups).sort(([a], [b]) => a.localeCompare(b)));
}

function mapData(map, main, root) {
  const folder = join(main, ".scratch/scoreboard", map), pieces = [];
  const names = existsSync(folder) ? readdirSync(folder).filter(name => name.endsWith(".json")).sort() : [];
  for (const name of names) {
    try { pieces.push(piece(name.slice(0, -5), JSON.parse(readFileSync(join(folder, name), "utf8")), main)); }
    catch (error) { console.error(`problem: scoreboard ${join(folder, name)} unreadable (${error.message})`); }
  }
  let feedback = null;
  try { feedback = readFileSync(join(root, "docs/wayfinder", map, "build/feedback.md"), "utf8"); } catch { /* No feedback log yet. */ }
  return { map, pieces, totals: { builders: totals(pieces, item => label(item.builder)), kinds: totals(pieces, item => item.kind || "unknown") }, feedback };
}

const findingsText = findings => Object.entries(findings).map(([kind, count]) => `${kind} ${count}`).join(", ") || "none";
// Dollars and tokens side by side; ">=" marks dollars that leave out runs which reported tokens only.
const costText = cost => [Number.isFinite(cost?.usd) ? `${cost.partial ? ">=" : ""}$${cost.usd.toFixed(2)}` : "",
  Number.isFinite(cost?.tokens) ? `${(cost.tokens / 1000).toFixed(1)}k tok` : ""].filter(Boolean).join(" ") || "-";
const minutesText = value => value === null || value === undefined ? "-" : String(Math.round(value));

function table(rows) {
  if (!rows.length) return "";
  const widths = rows[0].map((_, column) => Math.max(...rows.map(row => row[column].length)));
  return rows.map(row => row.map((cell, column) => column === row.length - 1 ? cell : cell.padEnd(widths[column])).join("  ").trimEnd()).join("\n");
}

function print(data) {
  console.log(`score: ${data.map} (${data.pieces.length} pieces)`);
  if (!data.pieces.length) return;
  console.log(table([["piece", "builder", "min", "rounds", "findings", "build cost", "review cost", "PR"], ...data.pieces.map(item => [
    item.piece, row(item.builder), minutesText(item.minutes), String(item.rounds ?? 0), findingsText(item.findings), costText(item.cost?.build),
    costText(item.cost?.review), item.landed?.pr ? `#${item.landed.pr}${item.landed.sha ? "" : " open"}` : "-"])]));
  for (const [name, groups] of [["builder", data.totals.builders], ["kind", data.totals.kinds]]) {
    console.log(`totals by ${name}:`);
    console.log(table(Object.entries(groups).map(([key, group]) => [`  ${key}`, `${group.pieces} pieces`, `${minutesText(group.minutes)} min`,
      `${group.rounds} rounds`, findingsText(group.findings), `build ${costText(group.cost.build)}`, `review ${costText(group.cost.review)}`])));
  }
}

function score(args) {
  let flags;
  try { flags = options(args); }
  catch (error) { process.stderr.write(usage); kitResult("fail", `score ${error.message}`); return 2; }
  try {
    const main = resolve(kitMainRoot()), root = resolve(kitRoot()), parent = join(main, ".scratch/scoreboard");
    const maps = flags.map ? [flags.map] : existsSync(parent) ? readdirSync(parent).filter(name => statSync(join(parent, name)).isDirectory()).sort() : [];
    const data = maps.map(map => mapData(map, main, root)).filter(item => flags.map || item.pieces.length);
    if (flags.snapshot) {
      const map = join(root, "docs/wayfinder", flags.map);
      if (!existsSync(join(map, "build"))) throw new Error(`no build folder for map ${flags.map} (docs/wayfinder/${flags.map}/build)`);
      const path = join(map, "build/scoreboard.json"), temporary = `${path}.${process.pid}.tmp`;
      try {
        writeFileSync(temporary, JSON.stringify(data[0], null, 2) + "\n");
        renameSync(temporary, path);
      } finally { rmSync(temporary, { force: true }); }
      // --json keeps stdout to the data alone.
      (flags.json ? console.error : console.log)(`snapshot: ${relative(root, path)}`);
    }
    const count = data.reduce((sum, item) => sum + item.pieces.length, 0);
    if (flags.json) console.log(JSON.stringify(flags.map ? data[0] : { maps: data }, null, 2));
    else if (!flags.snapshot) {
      if (!data.length) console.log("score: no records");
      data.forEach(print);
    }
    kitResult("ok", `score ${flags.map ?? `${data.length} maps`} ${count} pieces`);
    return 0;
  } catch (error) { kitResult("fail", `score ${error.message}`); return 1; }
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = score(process.argv.slice(2));
