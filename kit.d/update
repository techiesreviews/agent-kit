#!/usr/bin/env bash
# kit: unpack the newest kit into this machine's copy, or step back one
set -euo pipefail
# shellcheck source=scripts/agents/kit-lib.sh
source "${KIT_LIB:-$(dirname -- "${BASH_SOURCE[0]}")/../kit-lib.sh}"

usage() {
  cat <<'EOF'
Usage: kit update [--previous]
Fetch the kit repo's main (KIT_REPO, which the launcher sets) and unpack it into
${XDG_DATA_HOME:-~/.local/share}/agent-kit/<commit>/, then point current at it in one step.
--previous points current back at the kit it replaced, for every project at once; kit update
then stays there until main moves on (the normal way back is a revert in the kit repo).
EOF
}
previous=false
for argument in "$@"; do
  case $argument in
    --help|-h) usage; exit 0 ;;
    --previous) previous=true ;;
    *) usage >&2; kit_result fail "update unknown argument $argument"; exit 2 ;;
  esac
done

# Same default as the launcher's; the launcher passes its own setting down as KIT_REPO.
repo=${KIT_REPO:-https://github.com/techiesreviews/agent-kit.git}
data=${XDG_DATA_HOME:-}
[[ $data == /* ]] || data=${HOME:-$(cd ~ && pwd -P)}/.local/share
data=$data/agent-kit
mkdir -p -- "$data"
# One update at a time (a timer and a person can overlap).
exec {lock}> "$data/.lock"
if ! command -v flock > /dev/null; then
  printf 'kit update: no flock; updates are not serialised\n' >&2
elif ! flock -w 120 "$lock"; then
  kit_result fail "update another kit update holds $data/.lock"
  exit 1
fi

link() { # link <name> <commit>: replace the link in one rename, so a reader sees the old or the new target
  ln -sfn -- "$2" "$data/.$1.$$"
  mv -fT -- "$data/.$1.$$" "$data/$1"
}
target() { readlink -- "$data/$1" 2>/dev/null || :; }
short() { printf '%s' "${1:0:7}"; }
remove() { chmod -R u+w -- "$1" 2>/dev/null || :; rm -rf -- "$1"; }
# A folder holds a kit when it has what the front door needs: kit to run and kit-lib.sh to source.
has_kit() { [[ -x $1/kit && -f $1/kit-lib.sh ]]; }

current=$(target current) before=$(target previous)
held=''
[[ ! -f $data/held ]] || held=$(< "$data/held")
if [[ $previous == true ]]; then
  # Already stepped back: previous is the kit stepped back from, so swapping again would undo the step.
  if [[ -n $held && $before == "$held" ]]; then
    kit_result ok "update already back on $(short "${current:-none}")"
    exit 0
  fi
  if [[ -z $before || ! -d $data/$before ]]; then
    printf 'kit update: no previous kit in %s\n' "$data" >&2
    kit_result fail "update no previous kit to go back to"
    exit 1
  fi
  if ! has_kit "$data/$before"; then
    printf 'kit update: %s has no kit front door and kit-lib.sh at its top\n' "$data/$before" >&2
    kit_result fail "update previous kit $(short "$before") is incomplete"
    exit 1
  fi
  link current "$before"
  if [[ -n $current ]]; then
    link previous "$current"
    # Its age counts from now, as on a normal update: a command started on it has a day to finish.
    touch -- "$data/$current" 2>/dev/null || :
  fi
  # The commit stepped back from: kit update keeps off it until main moves on (nothing to hold without one).
  if [[ -n $current ]]; then printf '%s\n' "$current" > "$data/held"; else rm -f -- "$data/held"; fi
  printf 'current %s (was %s)\n' "$(short "$before")" "$(short "${current:-none}")"
  kit_result ok "update --previous $(short "$before") (was $(short "${current:-none}"))"
  exit 0
fi

bare=$data/repo.git
[[ -d $bare ]] || git init -q --bare -- "$bare"
if ! GIT_TERMINAL_PROMPT=0 timeout 120 git -C "$bare" fetch -q --depth 1 -- "$repo" main >&2; then
  kit_result fail "update cannot fetch main from $repo"
  exit 1
fi
newest=$(git -C "$bare" rev-parse FETCH_HEAD)

# While main is still the commit --previous stepped back from, current stays on the kit it went back to.
want=$newest
[[ -z $current || -z $held || $newest != "$held" ]] || want=$current
# Staying put needs a whole current folder: a removed or broken one is unpacked again.
if [[ $want == "$current" ]] && has_kit "$data/$current"; then
  if [[ $want == "$newest" ]]; then
    rm -f -- "$data/held"
    result="update already on $(short "$newest")"
  else
    result="update held on $(short "$current"): main is still $(short "$newest"), which kit update --previous stepped back from"
  fi
else
  if ! has_kit "$data/$want"; then
    unpack=$(mktemp -d "$data/.unpack.XXXXXX")
    if ! git -C "$bare" archive "$want" | tar -x -C "$unpack"; then
      remove "$unpack"
      # The shallow fetch keeps an older commit only until its objects go (a fresh repo.git has main alone).
      if [[ $want != "$newest" ]]; then kit_result fail "update cannot refill held $(short "$want")"
      else kit_result fail "update cannot unpack $(short "$newest")"; fi
      exit 1
    fi
    if ! has_kit "$unpack"; then
      remove "$unpack"
      if [[ $want != "$newest" ]]; then kit_result fail "update held $(short "$want") has no kit front door and kit-lib.sh at its top"
      else kit_result fail "update main $(short "$newest") has no kit front door and kit-lib.sh at its top"; fi
      exit 1
    fi
    touch -- "$unpack"
    # A machine copy is never edited in place: kit work happens in a checkout of the kit repo.
    chmod -R a-w -- "$unpack"
    [[ ! -e $data/$want ]] || remove "$data/$want"
    mv -T -- "$unpack" "$data/$want"
    printf 'unpacked %s into %s\n' "$(short "$want")" "$data/$want"
  fi
  link current "$want"
  [[ $want != "$newest" ]] || rm -f -- "$data/held"
  if [[ -n $current && $current != "$want" ]]; then
    link previous "$current"
    # A folder's age counts from when it stopped being current: a command started on it has a day to finish.
    touch -- "$data/$current" 2>/dev/null || :
  fi
  if [[ $current == "$want" ]]; then
    result="update refilled $(short "$want")"
  else
    printf 'current %s (was %s)\n' "$(short "$newest")" "$(short "${current:-none}")"
    result="update $(short "$newest") (was $(short "${current:-none}"))"
  fi
fi

# kit doctor and kit version read the time of the last update that left current on main (or on the held kit);
# a failed fetch or unpack leaves it, so a stale copy keeps warning.
date +%s > "$data/updated"

# Folders (and unfinished unpacks) older than a day go, except the current and previous kits.
current=$(target current) before=$(target previous)
for folder in "$data"/* "$data"/.unpack.*; do
  name=${folder##*/}
  [[ -d $folder && ($name =~ ^[0-9a-f]{40}$ || $name == .unpack.*) && $name != "$current" && $name != "$before" ]] || continue
  [[ -z $(find "$folder" -maxdepth 0 -mmin +1440) ]] || remove "$folder"
done
kit_result ok "$result"
