#!/usr/bin/env node
// kit: review a diff or commit and save the evidence
// The review itself is review-run.mjs, which kit pr calls in its own process.
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { resultLine, review as reviewRun, secondLook } from "../review-run.mjs";

const { kitResult } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit review [--base REF | --commit SHA] [--ticket FILE] [--pr N] [--second-look | --second gpt]\nDefault scope: --base origin/<land> (branches.land in scripts/agents/kit.json). Model: ASE_REVIEW_MODEL or claude-opus-5-5: claude-*, grok-*, gpt-* (also o<digit>…, codex…) or opencode/<model>;\n" +
  "any other name is refused before any call (ASE_AGENT_CLI=codex|opencode picks the CLI for it).\n" +
  "Effort: high (ASE_REVIEW_EFFORT overrides it); a second look takes the table's effort for its model, else medium; an OpenCode model, main review or second look, takes none.\n" +
  "A scope with no change (a no-code merge, an empty diff) has nothing to review: no call, no count, no evidence, and a skip \"nothing to review (…)\" with exit 3\n" +
  "(a second look says \"second look: skipped (nothing to review: …)\"), which kit pr takes as a pass. A reviewer whose CLI crashes (a signal, or an exit above 128) on its first call\n" +
  "counts as unavailable, not as a failed review: a second look hands over to the next model or is skipped; the main review, with no stand-in, still fails.\n" +
  "--second-look: the review kind from the changed paths (agent, ux, dx, code) picks its models, first choice first, in the kit's second-look.json\n" +
  "(ASE_SECOND_LOOK overrides); the next one takes it when a model cannot run; when none can, it skips with exit 3 and says \"second look: skipped (<reason>)\".\n" +
  "GPT (through Codex, at the table's effort) may review since 2026-11-09; Claude Opus stays the main reviewer. A GPT model in the order is never\n" +
  "used for a docs-only change, and once per PR (the same --pr N, or the same branch and history when either look named no PR): a later look goes to the next model.\n" +
  "Docs-only for GPT: every changed file is in paths.docs, or is a .md, .markdown, .rst or .adoc file that paths.tests and paths.css leave out.\n" +
  "One exception (Lex, 2026-11-12): when the free OpenCode model fails (for a reason of its own, not a failed save), times out or hits its limit,\n" +
  "GPT looks again even if it looked once, within ASE_REVIEW_BUDGET_GPT and with a time limit of its own (never for a docs-only change);\n" +
  "it says \"second look: <gpt model> takes it again (…)\".\n" +
  "--second gpt: a GPT second look asked on purpose, for a big or risky change: the kind's GPT model, even when the PR had one (never for a docs-only\n" +
  "change), and no other model in its place (it skips with exit 3 when GPT cannot run, a missing Codex login included). Either way the look is the PR's second look, which kit pr reuses on the same HEAD.\n" +
  "The whole look, fallback included, stops at ASE_SECOND_LOOK_TIMEOUT (25m; GPT taking it again after OpenCode fails gets its own 25m): then it skips as \"<model> timed out after 25m\";\n" +
  "a fallback with under a minute left is not started (\"<model> not started: under a minute left of 25m\").\n" +
  "Weekly budgets for the whole computer: ASE_REVIEW_BUDGET_GPT (12), ASE_REVIEW_BUDGET_GROK (8); not counted: Claude and OpenCode's -free models.\n" +
  "On OpenCode, openai/… counts as GPT and xai/… as Grok; any other paid OpenCode model is refused.\n";

function options(args) {
  const values = {};
  for (let i = 0; i < args.length; i += 2) {
    const flag = args[i], value = args[i + 1];
    if (flag === "--second-look" && !values.secondLook) { values.secondLook = true; i--; continue; }
    if (flag === "--second" && value !== "gpt") throw new Error(value === undefined || value.startsWith("--") ? "--second needs a value: gpt" : `--second takes gpt, not ${value}`);
    if (!["--base", "--commit", "--ticket", "--pr", "--second"].includes(flag) || !value || (value.startsWith("--") && !["--base", "--commit"].includes(flag)) || Object.hasOwn(values, flag.slice(2))) {
      throw new Error(`Invalid option: ${flag}`);
    }
    values[flag.slice(2)] = value;
  }
  if (values.base !== undefined && values.commit !== undefined) throw new Error("--base and --commit are mutually exclusive");
  if (values.second !== undefined && values.secondLook) throw new Error("--second and --second-look are mutually exclusive");
  if (values.pr !== undefined && (!/^[1-9][0-9]*$/.test(values.pr) || !Number.isSafeInteger(Number(values.pr)))) throw new Error("--pr must be a positive integer");
  return values;
}

async function review(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    console.error(`problem: ${error.message}`);
    process.stderr.write(usage);
    kitResult("fail", `${error.message} evidence none`);
    return 2;
  }
  const outcome = flags.secondLook || flags.second ? await secondLook(flags) : await reviewRun(flags);
  console.log(resultLine(outcome));
  return outcome.exit;
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = await review(process.argv.slice(2));
