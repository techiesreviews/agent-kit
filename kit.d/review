#!/usr/bin/env node
// kit: review a diff or commit and save the evidence
import { execFileSync, spawn, spawnSync } from "node:child_process";
import { existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { inferCli, opencodeModelRuns, parseAgentArgs, releaseReviewBudget, reserveReviewBudget } from "../agent-run.mjs";
import { reviewBrief, reviewScope, ticketReviewBrief } from "../review-brief.mjs";
import { saveReviewEvidence } from "../review-evidence.mjs";
import { countsLine, findingsRecord } from "../review-findings.mjs";
import { parseChanges, reviewKinds, secondLookPick, secondLookTable } from "../pr-tier.mjs";
import { durationMilliseconds } from "../sol-run.mjs";

const { kitBranch, kitGhEnv, kitRoot, kitMainRoot, kitOwner, kitResult, kitSettings, kitStateDir, nodeEnv, kitScore, scoreReview } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit review [--base REF | --commit SHA] [--ticket FILE] [--pr N] [--second-look]\nDefault scope: --base origin/<land> (branches.land in scripts/agents/kit.json). Model: ASE_REVIEW_MODEL or claude-opus-5-5: claude-*, grok-*, gpt-* (also o<digit>…, codex…) or opencode/<model>;\n" +
  "any other name is refused before any call (ASE_AGENT_CLI=codex|opencode picks the CLI for it).\n" +
  "--second-look: the review kind from the changed paths (agent, ux, dx, code) picks its model in the kit's second-look.json (ASE_SECOND_LOOK overrides);\n" +
  "the other family takes it when that model cannot run; when neither can, it skips with exit 3 and says \"second look: skipped (<reason>)\".\n" +
  "The whole look, fallback included, stops at ASE_SECOND_LOOK_TIMEOUT (25m): then it skips as \"<model> timed out after 25m\";\n" +
  "a fallback with under a minute left is not started (\"<model> not started: under a minute left of 25m\").\n" +
  "Weekly budgets for the whole computer: ASE_REVIEW_BUDGET_GPT (12), ASE_REVIEW_BUDGET_GROK (8); not counted: Claude and OpenCode's -free models.\n" +
  "On OpenCode, openai/… counts as GPT and xai/… as Grok; any other paid OpenCode model is refused.\n";

function options(args) {
  const values = {};
  for (let i = 0; i < args.length; i += 2) {
    const flag = args[i], value = args[i + 1];
    if (flag === "--second-look" && !values.secondLook) { values.secondLook = true; i--; continue; }
    if (!["--base", "--commit", "--ticket", "--pr"].includes(flag) || !value || (value.startsWith("--") && !["--base", "--commit"].includes(flag)) || Object.hasOwn(values, flag.slice(2))) {
      throw new Error(`Invalid option: ${flag}`);
    }
    values[flag.slice(2)] = value;
  }
  if (values.base !== undefined && values.commit !== undefined) throw new Error("--base and --commit are mutually exclusive");
  if (values.pr !== undefined && (!/^[1-9][0-9]*$/.test(values.pr) || !Number.isSafeInteger(Number(values.pr)))) throw new Error("--pr must be a positive integer");
  return values;
}

// A Grok outage: one of the run log's last five lines starts with an HTTP 5xx status or a connection error
// (only such closing lines, so a review or tool trace that names one is not matched). Returns that line or null.
const outagePattern = /^(?:error:|■)?[\t ]*(?:(?:(?:HTTP|status)[\t ]*)?5\d\d\b.*|(?:\w*Error:[\t ]*)?(?:(?:connect|read|write|getaddrinfo)[\t ]+)?(?:ECONNREFUSED|ECONNRESET|ETIMEDOUT|ENOTFOUND|EAI_AGAIN)\b.*)$/i;
function grokDown(temporary) {
  let log = "";
  try { log = readFileSync(join(temporary, "run.log"), "utf8"); } catch { return null; }
  return log.split(/\r?\n/).filter(line => line.trim()).slice(-5).reverse().map(line => line.trim()).find(line => outagePattern.test(line)) ?? null;
}

function evidenceDirectory() {
  const parent = join(kitMainRoot(), ".scratch/reviews", kitOwner());
  mkdirSync(parent, { recursive: true });
  const time = new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
  for (let suffix = 0; ; suffix++) {
    const directory = join(parent, time + (suffix ? `-${suffix}` : ""));
    try { mkdirSync(directory); return directory; }
    catch (error) { if (error.code !== "EEXIST") throw error; }
  }
}

// One review run, printing all but its RESULT line. A second look (`look`: { kind, model }) sets the
// model and its CLI, so no ASE_AGENT_CLI can send it to Codex, and marks its evidence folder.
async function reviewOnce(flags, look) {
  let evidence = "none", temporary, status = 1, reason = "review failed", label, budget, env, model, effort, reviewedHead;
  let ledger, outOfCredit = false, kept = false, spawned = false, unavailable = false, stderr = "", timedOut = false;
  const ticket = flags.ticket;
  try {
    // The default base comes from the settings file; a settings problem is a failure, not a usage error.
    if (flags.base === undefined && flags.commit === undefined) flags.base = `origin/${kitBranch()}`;
    const root = kitRoot();
    env = nodeEnv();
    if (look) Object.assign(env, { ASE_REVIEW_MODEL: look.model, ASE_AGENT_CLI: inferCli(look.model) ?? "" });
    const scope = reviewScope("", flags, root);
    label = scope.label;
    reviewedHead = scope.head;
    console.log(`scope: ${flags.commit ? `--commit ${flags.commit}` : `--base ${flags.base}`} (${label})`);
    const artifacts = join(root, ".scratch/agent");
    mkdirSync(artifacts, { recursive: true });
    temporary = mkdtempSync(join(artifacts, "kit-review-"));
    const briefPath = join(temporary, "brief.md");
    const resolved = scope.commit ? { commit: scope.commit } : { base: scope.base };
    writeFileSync(briefPath, flags.ticket ? ticketReviewBrief(flags.ticket, resolved, root) : reviewBrief("", "", resolved, root));
    const agentArgs = ["review", root, briefPath, ...(scope.commit ? ["--commit", scope.commit] : ["--base", scope.base]), "--out", temporary];
    let cli;
    ({ model, effort, cli } = parseAgentArgs(agentArgs, env));
    console.log(`model: ${model}`);
    // One count for the computer; this project's old per-project count moves in on first use.
    ledger = { path: join(kitStateDir(env), "review-budget.json"), project: kitSettings(root).project, legacy: join(kitMainRoot(), ".scratch/review-budget.json") };
    try { budget = reserveReviewBudget(ledger, { cli, model }, env); }
    catch (error) { unavailable = /^\S+ review budget used up: /.test(error.message); throw error; }
    if (budget) console.log(`budget: ${budget.family} ${budget.used}/${budget.limit} in ${budget.week}`);
    spawned = true;
    status = await new Promise((accept, reject) => {
      const child = spawn(env.KIT_NODE, [resolve(import.meta.dirname, "../agent-run.mjs"), ...agentArgs], { cwd: root, env, stdio: ["ignore", "pipe", "pipe"] });
      const interrupt = () => child.kill("SIGINT");
      const terminate = () => child.kill("SIGTERM");
      process.once("SIGINT", interrupt);
      process.once("SIGTERM", terminate);
      // A second look's overall limit: the runner stops its CLI's whole process group on SIGTERM.
      // A runner that already exited for its own reason keeps that reason.
      const limit = look?.deadline && setTimeout(() => {
        if (child.exitCode !== null || child.signalCode !== null) return;
        timedOut = true; terminate();
      }, Math.max(0, look.deadline - Date.now()));
      const clear = () => {
        clearTimeout(limit);
        process.removeListener("SIGINT", interrupt);
        process.removeListener("SIGTERM", terminate);
      };
      // Show the report; hide the temporary artifacts path, which is removed below once saved, or named if saving fails.
      let pending = "";
      child.stdout.setEncoding("utf8");
      child.stdout.on("data", chunk => {
        const lines = (pending + chunk).split("\n");
        pending = lines.pop();
        for (const line of lines) if (!line.startsWith("artifacts: ")) process.stdout.write(`${line}\n`);
      });
      child.stdout.once("end", () => { if (pending && !pending.startsWith("artifacts: ")) process.stdout.write(`${pending}\n`); });
      child.stderr.setEncoding("utf8");
      child.stderr.on("data", chunk => { stderr += chunk; process.stderr.write(chunk); });
      child.once("error", error => { clear(); reject(error); });
      child.once("close", code => { clear(); accept(code === 0 ? 0 : 1); });
    });
    reason = timedOut ? `timed out after ${look.limit}` : [...stderr.matchAll(/^problem: (.+)$/gm)].at(-1)?.[1] || "review failed";
    // An empty account is a review that could not run, not one that failed.
    outOfCredit = status !== 0 && /^\S+ out of credit: /.test(reason);
    if (!status && flags.pr) {
      const [head, base] = readFileSync(join(temporary, "refs.txt"), "utf8").trim().split("\n");
      const body = join(temporary, "pr-comment.md");
      const [headName, baseName] = scope.commit ? ["Commit", "Parent"] : ["HEAD", "Base"];
      writeFileSync(body, `${look ? `Second look: ${look.kind}\n` : ""}Model: ${model}\nScope: ${label}\n${headName}: ${head}\n${baseName}: ${base}\n\n${readFileSync(join(temporary, "out.md"), "utf8")}`);
      const posted = spawnSync("gh", ["pr", "comment", flags.pr, "--body-file", body], { cwd: root, env: kitGhEnv(env, root), encoding: "utf8" });
      if (posted.error || posted.status !== 0) throw new Error(`gh pr comment failed: ${posted.error?.message || posted.stderr.trim() || posted.status}`);
    }
  } catch (error) {
    reason = error.message;
    status = 1;
    console.error(`problem: ${reason}`);
  } finally {
    try {
      // A review whose CLI never started (empty diff) is not counted; the runner
      // records the process group as soon as the CLI spawns. A provider usage-limit
      // refusal on the first call spent no review, so it gives the slot back; the
      // runner marks it only when the refusal was all that call printed. An out-of-credit
      // run that failed returned no complete review, so it is given back even after earlier turns,
      // and even when saving its evidence fails below: no review came back either way.
      const run = temporary && join(temporary, "status.json");
      const record = run && existsSync(run) ? JSON.parse(readFileSync(run, "utf8")) : {};
      // The model could not run: its CLI is missing (a spawn ENOENT), refused or hit a usage limit, the account
      // is empty, or the provider is down (OpenCode's error event or no session within its start limit, a Grok
      // run whose closing lines are an HTTP 5xx or a connection error, or one that gave no answer before the
      // timeout: Grok prints its JSON only at the end). Any other failure, including one before the CLI started, is a broken run.
      const missing = status !== 0 && !record.pgid && /^problem: (spawn \S+ ENOENT)$/m.exec(stderr)?.[1];
      const down = !missing && status !== 0 && /^grok failed \(\d+\)/.test(reason) && grokDown(temporary);
      const hung = !missing && status !== 0 && /^grok-/i.test(model) && /^agent exceeded timeout=([^;]+);/.exec(reason)?.[1];
      // OpenCode that opened no session within its start limit on the first call never reached the model;
      // the runner marks it only then, so a silent retry after a call that worked keeps its count.
      const silent = status !== 0 && record.silent === true;
      if (missing || down || hung) {
        reason = missing ? `CLI missing: ${missing}` : down ? `grok unavailable: ${down}` : `grok unavailable: no answer within ${hung}`;
        console.error(`problem: ${reason}`);
      }
      if (status !== 0 && spawned && (record.refused === true || outOfCredit || missing || down || hung ||
        /^\S+ usage limit\b|^OpenCode reported an error: |^opencode unavailable: no session within /.test(reason))) unavailable = true;
      // An outage, like an empty account, returned no review, so its count is given back too.
      if (budget && (!record.pgid || record.refused === true || outOfCredit || down || silent)) releaseReviewBudget(ledger.path, budget, env);
    } catch (error) {
      kept = true;
      console.error(`problem: releasing review budget failed: ${error.message}`);
    }
    try {
      // A second look's folder is marked as soon as it exists, before any review file is copied in, so no
      // lookup ever takes it for Claude's review; `ok` turns true below only for a run that came back.
      const mark = ok => writeFileSync(join(evidence, "second-look.json"), `${JSON.stringify({ kind: look.kind, model, ok })}\n`);
      const { record, cleanup } = saveReviewEvidence(temporary, () => {
        evidence = evidenceDirectory();
        if (look) mark(false);
        return evidence;
      }, text => findingsRecord(text, { model, effort, scope: label, head: reviewedHead }));
      // The evidence is saved; a leftover temporary folder is reported but fails nothing.
      if (cleanup) console.error(`problem: removing ${temporary} failed: ${cleanup}`);
      if (record) {
        console.log(countsLine(record));
        kitScore({ ticket }, score => scoreReview(score, evidence));
      }
      if (look && status === 0 && !outOfCredit) mark(true);
    } catch (error) {
      status = 1;
      outOfCredit = false;
      unavailable = false;
      reason = `saving evidence failed: ${error.message}`;
      console.error(`problem: ${reason}`);
      if (temporary) console.error(`problem: review files kept in ${temporary}`);
    }
  }
  // A run stopped at the limit whose evidence then failed to save fails like any failed save.
  return { status, outOfCredit, unavailable: status !== 0 && unavailable, timedOut: timedOut && /^timed out after /.test(reason), kept, budget, model, evidence, label, reason };
}

/** The RESULT line and exit code of one review run. */
function report({ status, outOfCredit, kept, budget, model, evidence, label, reason }) {
  if (outOfCredit) {
    console.log(`evidence: ${evidence}`);
    console.log(`RESULT: skip review out of credit (${model})${kept && budget ? "; count not given back" : ""}`);
    return 3;
  }
  kitResult(status === 0 ? "ok" : "fail", status === 0 ? `review ${label} evidence ${evidence}` : `${reason} evidence ${evidence}`);
  return status;
}

// The second look after Claude's review: the change's kind picks its model in the table, the other family takes
// over when that one cannot run (a used-up count, no credit, a usage limit, a CLI that is missing or down), and when
// neither can, it is skipped. Any other failure, such as an incomplete answer or a failed save or PR comment, fails.
async function secondLook(flags) {
  let pick, deadline;
  // One limit for the whole look, fallback included (ASE_SECOND_LOOK_TIMEOUT, default 25m): a reviewer that opened
  // a session but never finishes is stopped, and the look is skipped as timed out so the slice or PR goes on.
  const limit = process.env.ASE_SECOND_LOOK_TIMEOUT || "25m";
  try {
    try { deadline = Date.now() + durationMilliseconds(limit); }
    catch { throw new Error(`ASE_SECOND_LOOK_TIMEOUT must be a duration such as 25m (got ${limit})`); }
    if (flags.base === undefined && flags.commit === undefined) flags.base = `origin/${kitBranch()}`;
    const root = kitRoot(), scope = reviewScope("", flags, root);
    const range = scope.commit ? [`${scope.commit}^`, scope.commit] : [`${scope.base}...${scope.head}`];
    const changes = parseChanges(execFileSync("git", ["-C", root, "-c", "core.quotepath=false", "diff", "--name-status", "--no-renames", ...range],
      { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
    if (!changes.length) throw new Error(`nothing to review: ${scope.label} is empty`);
    // One path for the pick and the check below, so a problem names the file that was read.
    const table = process.env.ASE_SECOND_LOOK || resolve(import.meta.dirname, "../second-look.json");
    pick = secondLookPick(changes, kitSettings(root), { ticket: flags.ticket && relative(root, resolve(root, flags.ticket)), table });
    // A paid OpenCode row would be refused when its turn came, before any handover: every kind's row is checked
    // now, so the table is named as broken whichever kind this change picks.
    const rows = secondLookTable(table);
    for (const kind of reviewKinds) {
      const paid = [rows[kind].model, rows[kind].fallback].find(model => /^opencode\//.test(model) && !opencodeModelRuns(model));
      if (paid) throw new Error(`second-look table ${table} ${kind}: ${paid} is a paid OpenCode model; a second look on OpenCode must be a -free model`);
    }
  } catch (error) {
    console.error(`problem: ${error.message}`);
    kitResult("fail", `${error.message} evidence none`);
    return 1;
  }
  console.log(`second look: ${pick.kind} (${pick.path}) ${pick.model}`);
  const missed = [];
  const label = /^\d+$/.test(limit) ? `${limit}s` : limit;
  for (const model of [pick.model, pick.fallback]) {
    // A fallback needs a minute left to start: with less it would reserve a count for a review the limit stops.
    if (missed.length && deadline - Date.now() < 60_000) { missed.push(`${model} not started: under a minute left of ${label}`); break; }
    if (missed.length) console.log(`second look: ${model} takes it (${missed.at(-1)})`);
    const result = await reviewOnce(flags, { kind: pick.kind, model, deadline, limit: label });
    if (result.status === 0 && !result.outOfCredit) return report(result);
    if (!result.unavailable && !result.timedOut) return report(result);
    if (result.evidence !== "none") console.log(`evidence: ${result.evidence}`);
    missed.push(`${model} ${result.outOfCredit ? "out of credit" : result.reason}`.replace(/\s+/g, " "));
    if (result.timedOut) break;
  }
  console.log(`second look: skipped (${missed.join("; ")})`);
  console.log(`RESULT: skip second look (${missed.join("; ")})`);
  return 3;
}

async function review(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    console.error(`problem: ${error.message}`);
    process.stderr.write(usage);
    kitResult("fail", `${error.message} evidence none`);
    return 2;
  }
  return flags.secondLook ? secondLook(flags) : report(await reviewOnce(flags));
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = await review(process.argv.slice(2));
