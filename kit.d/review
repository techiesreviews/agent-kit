#!/usr/bin/env node
// kit: review a diff or commit and save the evidence
import { spawn, spawnSync } from "node:child_process";
import { existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { parseAgentArgs, releaseReviewBudget, reserveReviewBudget } from "../agent-run.mjs";
import { reviewBrief, reviewScope, ticketReviewBrief } from "../review-brief.mjs";
import { saveReviewEvidence } from "../review-evidence.mjs";
import { countsLine, findingsRecord } from "../review-findings.mjs";

const { kitBranch, kitRoot, kitMainRoot, kitOwner, kitResult, kitSettings, kitStateDir, nodeEnv, kitScore, scoreReview } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit review [--base REF | --commit SHA] [--ticket FILE] [--pr N]\nDefault scope: --base origin/<land> (branches.land in scripts/agents/kit.json). Model: ASE_REVIEW_MODEL or claude-opus-5-5 (claude-*, grok-* or Codex).\n" +
  "Weekly budgets for the whole computer: ASE_REVIEW_BUDGET_GPT (12), ASE_REVIEW_BUDGET_GROK (8); Claude is not counted.\n";

function options(args) {
  const values = {};
  for (let i = 0; i < args.length; i += 2) {
    const flag = args[i], value = args[i + 1];
    if (!["--base", "--commit", "--ticket", "--pr"].includes(flag) || !value || (value.startsWith("--") && !["--base", "--commit"].includes(flag)) || Object.hasOwn(values, flag.slice(2))) {
      throw new Error(`Invalid option: ${flag}`);
    }
    values[flag.slice(2)] = value;
  }
  if (values.base !== undefined && values.commit !== undefined) throw new Error("--base and --commit are mutually exclusive");
  if (values.pr !== undefined && (!/^[1-9][0-9]*$/.test(values.pr) || !Number.isSafeInteger(Number(values.pr)))) throw new Error("--pr must be a positive integer");
  return values;
}

function evidenceDirectory() {
  const parent = join(kitMainRoot(), ".scratch/reviews", kitOwner());
  mkdirSync(parent, { recursive: true });
  const time = new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
  for (let suffix = 0; ; suffix++) {
    const directory = join(parent, time + (suffix ? `-${suffix}` : ""));
    try { mkdirSync(directory); return directory; }
    catch (error) { if (error.code !== "EEXIST") throw error; }
  }
}

async function review(args) {
  let evidence = "none", temporary, status = 1, reason = "invalid arguments", label, budget, env, model, effort, reviewedHead, ticket;
  let ledger;
  try {
    status = 2;
    const flags = options(args);
    ticket = flags.ticket;
    status = 1;
    // The default base comes from the settings file; a settings problem is a failure, not a usage error.
    if (flags.base === undefined && flags.commit === undefined) flags.base = `origin/${kitBranch()}`;
    const root = kitRoot();
    env = nodeEnv();
    const scope = reviewScope("", flags, root);
    label = scope.label;
    reviewedHead = scope.head;
    console.log(`scope: ${flags.commit ? `--commit ${flags.commit}` : `--base ${flags.base}`} (${label})`);
    const artifacts = join(root, ".scratch/agent");
    mkdirSync(artifacts, { recursive: true });
    temporary = mkdtempSync(join(artifacts, "kit-review-"));
    const briefPath = join(temporary, "brief.md");
    const resolved = scope.commit ? { commit: scope.commit } : { base: scope.base };
    writeFileSync(briefPath, flags.ticket ? ticketReviewBrief(flags.ticket, resolved, root) : reviewBrief("", "", resolved, root));
    const agentArgs = ["review", root, briefPath, ...(scope.commit ? ["--commit", scope.commit] : ["--base", scope.base]), "--out", temporary];
    let cli;
    ({ model, effort, cli } = parseAgentArgs(agentArgs, env));
    console.log(`model: ${model}`);
    // One count for the computer; this project's old per-project count moves in on first use.
    ledger = { path: join(kitStateDir(), "review-budget.json"), project: kitSettings(root).project, legacy: join(kitMainRoot(), ".scratch/review-budget.json") };
    budget = reserveReviewBudget(ledger, cli, env);
    if (budget) console.log(`budget: ${budget.family} ${budget.used}/${budget.limit} in ${budget.week}`);
    let stderr = "";
    status = await new Promise((accept, reject) => {
      const child = spawn(env.KIT_NODE, [resolve(import.meta.dirname, "../agent-run.mjs"), ...agentArgs], { cwd: root, env, stdio: ["ignore", "pipe", "pipe"] });
      const interrupt = () => child.kill("SIGINT");
      const terminate = () => child.kill("SIGTERM");
      process.once("SIGINT", interrupt);
      process.once("SIGTERM", terminate);
      const clear = () => {
        process.removeListener("SIGINT", interrupt);
        process.removeListener("SIGTERM", terminate);
      };
      // Show the report; hide the temporary artifacts path, which is removed below once saved, or named if saving fails.
      let pending = "";
      child.stdout.setEncoding("utf8");
      child.stdout.on("data", chunk => {
        const lines = (pending + chunk).split("\n");
        pending = lines.pop();
        for (const line of lines) if (!line.startsWith("artifacts: ")) process.stdout.write(`${line}\n`);
      });
      child.stdout.once("end", () => { if (pending && !pending.startsWith("artifacts: ")) process.stdout.write(`${pending}\n`); });
      child.stderr.setEncoding("utf8");
      child.stderr.on("data", chunk => { stderr += chunk; process.stderr.write(chunk); });
      child.once("error", error => { clear(); reject(error); });
      child.once("close", code => { clear(); accept(code === 0 ? 0 : 1); });
    });
    reason = [...stderr.matchAll(/^problem: (.+)$/gm)].at(-1)?.[1] || "review failed";
    if (!status && flags.pr) {
      const [head, base] = readFileSync(join(temporary, "refs.txt"), "utf8").trim().split("\n");
      const body = join(temporary, "pr-comment.md");
      const [headName, baseName] = scope.commit ? ["Commit", "Parent"] : ["HEAD", "Base"];
      writeFileSync(body, `Model: ${model}\nScope: ${label}\n${headName}: ${head}\n${baseName}: ${base}\n\n${readFileSync(join(temporary, "out.md"), "utf8")}`);
      const posted = spawnSync("gh", ["pr", "comment", flags.pr, "--body-file", body], { cwd: root, env, encoding: "utf8" });
      if (posted.error || posted.status !== 0) throw new Error(`gh pr comment failed: ${posted.error?.message || posted.stderr.trim() || posted.status}`);
    }
  } catch (error) {
    reason = error.message;
    status = status === 2 ? 2 : 1;
    console.error(`problem: ${reason}`);
    if (status === 2) process.stderr.write(usage);
  } finally {
    try {
      // A review whose CLI never started (empty diff) is not counted; the runner
      // records the process group as soon as the CLI spawns. A provider usage-limit
      // refusal on the first call spent no review, so it gives the slot back; the
      // runner marks it only when the refusal was all that call printed.
      const run = temporary && join(temporary, "status.json");
      const record = run && existsSync(run) ? JSON.parse(readFileSync(run, "utf8")) : {};
      if (budget && (!record.pgid || record.refused === true)) releaseReviewBudget(ledger.path, budget, env);
    } catch (error) { console.error(`problem: releasing review budget failed: ${error.message}`); }
    try {
      const { record, cleanup } = saveReviewEvidence(temporary, () => (evidence = evidenceDirectory()),
        text => findingsRecord(text, { model, effort, scope: label, head: reviewedHead }));
      // The evidence is saved; a leftover temporary folder is reported but fails nothing.
      if (cleanup) console.error(`problem: removing ${temporary} failed: ${cleanup}`);
      if (record) {
        console.log(countsLine(record));
        kitScore({ ticket }, score => scoreReview(score, evidence));
      }
    } catch (error) {
      status = 1;
      reason = `saving evidence failed: ${error.message}`;
      console.error(`problem: ${reason}`);
      if (temporary) console.error(`problem: review files kept in ${temporary}`);
    }
  }
  kitResult(status === 0 ? "ok" : "fail", status === 0 ? `review ${label} evidence ${evidence}` : `${reason} evidence ${evidence}`);
  return status;
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = await review(process.argv.slice(2));
