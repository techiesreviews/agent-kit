    }
    const pair = `${land}/${release ?? "no release branch"}`;
    pairs.set(pair, [...(pairs.get(pair) ?? []), name]);
    if (exception) exceptions.push(`${name}: ${exception}`);
    if (git(main, "cat-file", "-e", `refs/remotes/origin/${land}:${kitSettingsFile}`).status !== 0) return ["skipped", `skipped: origin/${land} has no ${kitSettingsFile}; land the project's setup first`];

    const branch = "kit/init-pieces", path = `${main}-kit-init-pieces`, tip = `refs/heads/${branch}`;
    const names = (step) => step.stdout.split("\0").filter(Boolean);
    const leftover = git(main, "rev-parse", "--verify", "--quiet", tip).status === 0;
    if (existsSync(path) || leftover) {
      // An earlier run's change that has landed since (the branch merged into origin/<land>, or squashed: its files
      // there as on the branch; the worktree clean) is cleared away; any other leftover waits for a person.
      const base = leftover ? git(main, "merge-base", `refs/remotes/origin/${land}`, tip).stdout.trim() : "";
      const mine = base ? names(git(main, "diff", "-z", "--name-only", base, tip)) : [];
      const differ = new Set(base ? names(git(main, "diff", "-z", "--name-only", `refs/remotes/origin/${land}`, tip)) : []);
      const clean = !existsSync(path) || git(path, "status", "--porcelain").stdout.trim() === "";
      const merged = leftover && git(main, "merge-base", "--is-ancestor", tip, `refs/remotes/origin/${land}`).status === 0;
      if (!clean || !(merged || (mine.length && !mine.some((file) => differ.has(file))))) {
        return ["failed", `${path} or branch ${branch} is left from an earlier run; land or remove it, then rerun`];
      }
      if (existsSync(path)) git(main, "worktree", "remove", "--force", path);
      git(main, "branch", "-D", branch);
      console.log(`${name}: the earlier run's ${branch} has landed on origin/${land}; removed it and its worktree`);
    }
    const added = git(main, "worktree", "add", "-q", "--no-track", "-b", branch, path, `refs/remotes/origin/${land}`);
    if (added.status !== 0) return ["failed", `git worktree add failed: ${said(added)}`];
    // The worktree is this run's own: removed (with its branch) unless a change waits in it.
    const remove = () => { git(main, "worktree", "remove", "--force", path); git(main, "branch", "-D", branch); };
    made = remove;
    const local = { ...env, KIT_ROOT: path };
    // A repo for which git has no user.name or user.email set (in its config or the user's, or as GIT_* in the
    // environment) commits, and runs kit pr, with the missing one taken from the author of its landing branch's last
    // commit; a guess from the host name never stands in. These reach kit pr's checks too, as a person's own would.
    const [author, email] = git(main, "log", "-1", "--format=%an%n%ae", `refs/remotes/origin/${land}`).stdout.split("\n");
    const from = { NAME: ["user.name", author], EMAIL: ["user.email", email] };
    for (const [part, [key, value]] of Object.entries(from)) {
      if (!value || git(path, "config", "--get", key).stdout.trim() || local[`GIT_AUTHOR_${part}`]) continue;
      for (const role of ["AUTHOR", "COMMITTER"]) local[`GIT_${role}_${part}`] ??= value;
      console.log(`${name}: no ${key} set for git; commits as ${value}, from origin/${land}'s last commit`);
    }
    const commit = (...messages) => run("git", ["-C", path, "commit", "-q", ...messages.flatMap((message) => ["-m", message])], { env: local });
    const pieces = run(process.execPath, [join(home, "kit.d/init"), "--pieces"], { cwd: path, env: local });
    if (pieces.status !== 0) { remove(); return ["failed", `adding the pieces failed: ${lastResult(pieces.stdout)?.replace(/^init /, "") ?? said(pieces)}`]; }
    const status = git(path, "status", "--porcelain");
    if (status.status !== 0) { remove(); return ["failed", `git status failed: ${said(status)}`]; }
    if (!status.stdout.trim()) { remove(); return ["current", `nothing missing on origin/${land}`]; }

    git(path, "add", "-A");
    const listed = git(path, "diff", "--cached", "--name-only").stdout.trim().split("\n").filter(Boolean);
    const committed = commit(`Kit setup: add what kit init writes today (kit ${sha})`, `kit init --all added: ${listed.join(", ")}.`);
    if (committed.status !== 0) { remove(); return ["failed", `git commit failed: ${said(committed)}`]; }
    let normalized = 0;
    if (listed.includes(".gitattributes")) {
      // The one-time commit that gives files committed with CRLF the LF endings the new line asks for.
      const renormalized = git(path, "add", "--renormalize", ".");
      if (renormalized.status !== 0) { remove(); return ["failed", `git add --renormalize failed: ${said(renormalized)}`]; }
      normalized = git(path, "diff", "--cached", "--name-only").stdout.trim().split("\n").filter(Boolean).length;
      if (normalized) {
        const again = commit("Normalize line endings (git add --renormalize . after .gitattributes)");
        if (again.status !== 0) { remove(); return ["failed", `git commit of the line endings failed: ${said(again)}`]; }
      }
    }
    // A main checkout with uncommitted changes in any of these files would clash with the landed change: skipped.
    const touched = git(path, "diff", "-z", "--name-only", `refs/remotes/origin/${land}`, "HEAD").stdout.split("\0").filter(Boolean);
    // The whole status, matched here: a renormalize commit can touch more files than one command line holds.
    const dirty = git(main, "status", "--porcelain", "-z", "--untracked-files=all");
    const changedThere = new Set();
    for (let entries = dirty.stdout.split("\0").filter(Boolean), i = 0; i < entries.length; i++) {
      changedThere.add(entries[i].slice(3));
      // A rename or copy is followed by the path it came from.
      if (/^[RC]|^.[RC]/.test(entries[i])) changedThere.add(entries[++i]);
    }
    const busy = touched.filter((file) => changedThere.has(file));
    if (dirty.status !== 0 || busy.length) {
      remove();
      return ["skipped", dirty.status !== 0 ? `skipped: git status in ${main} failed: ${said(dirty)}`
        : `skipped: ${main} has uncommitted changes in ${busy.slice(0, 5).join(", ")}${busy.length > 5 ? ` and ${busy.length - 5} more` : ""}; commit or land them, then rerun`];
    }

    // The project's checks run in kit pr: they find its shared dependencies as in any of its worktrees.
    // As worktree.sh does, the main checkout's worktreeLinks paths are linked in; node_modules comes below.
    let projectSettings = {};
    try { projectSettings = JSON.parse(readFileSync(join(path, kitSettingsFile), "utf8")) ?? {}; } catch {}
    // --all's own choice: a project without sharedNodeModules keeps its own in the main checkout, and that one
    // serves the checks (worktree.sh leaves such a worktree to install its own).
    const shared = typeof projectSettings.sharedNodeModules === "string" ? resolve(main, projectSettings.sharedNodeModules)
      : existsSync(join(main, "node_modules")) ? join(main, "node_modules") : null;
    const links = [...(Array.isArray(projectSettings.worktreeLinks) ? projectSettings.worktreeLinks : [])
      .filter((link) => typeof link === "string" && link && !link.startsWith("/") && !link.split("/").includes(".."))
      .map((link) => [join(main, link), link])];
    for (const [target, link] of links) {
      if (!target || existsSync(join(path, link))) continue;
      try {
        mkdirSync(dirname(join(path, link)), { recursive: true });
        symlinkSync(target, join(path, link));
      } catch {}
    }
    // kit pr wants a clean tree, so node_modules must be one git ignores: a link, or, where .gitignore names
    // "node_modules/" (a folder, which a link is not), a folder of links to its entries. Nothing in the repo's own
    // git settings changes; where nothing ignores node_modules, there is none.
    const modules = join(path, "node_modules");
    if (shared && existsSync(shared) && !existsSync(modules)) {
      try {
        const real = realpathSync(shared);
        symlinkSync(real, modules);
        if (git(path, "check-ignore", "-q", "node_modules").status !== 0) {
          rmSync(modules);
          mkdirSync(modules);
          for (const entry of readdirSync(real)) symlinkSync(join(real, entry), join(modules, entry));
          if (git(path, "check-ignore", "-q", "node_modules/").status !== 0) {
            rmSync(modules, { recursive: true, force: true });
            console.log(`${name}: nothing in git ignores node_modules, so the worktree has none; kit pr's checks run without ${shared}`);
          }
        }
      } catch {}
    }
    const log = join(logs, `${name}.log`);
    mkdirSync(logs, { recursive: true });
    const output = openSync(log, "w");
    // timeout stops kit pr's whole process group (its checks, gh, git), not only the front door.
    const pr = run("timeout", ["-k", "30", String(seconds), join(home, "kit"), "pr", "--title", `Kit setup: add what kit init writes today (kit ${sha})`],
      { cwd: path, env: local, stdio: ["ignore", output, output], timeout: 0 });
    closeSync(output);
    if (pr.status === 124 || pr.status === 137) {
      return ["failed", `kit pr timed out after ${seconds}s and was stopped; the change waits in ${path} on ${branch} (its branch on origin may have moved), log ${log}`];
    }
    const prResult = lastResult(readFileSync(log, "utf8"));
    if (pr.status !== 0) return ["failed", `kit pr failed (${prResult ?? `exit ${pr.status}`}); the change waits in ${path} on ${branch}, log ${log}`];
    // Only a merge has landed it; an opened or queued PR keeps the worktree, so a rerun cannot open a second one.
    if (!/^merged\b/.test(prResult ?? "")) return ["waiting", `waiting: kit pr says ${prResult ?? "ok"}; the change waits in ${path} on ${branch} until it lands, log ${log}`];
    remove();
    return ["updated", `${files(listed.length)} changed${normalized ? `, ${files(normalized)} renormalized` : ""}, through kit pr into ${land}: ${prResult ?? "ok"}`];
  };

  const groups = { updated: [], waiting: [], current: [], skipped: [], failed: [] };
  for (const name of names) {
    const main = projects[name]?.root;
    console.log(`${name}: ${main}`);
    const [group, text] = bring(name, main);
    groups[group].push(name);
    kitResult(group === "failed" ? "fail" : "ok", `init ${name}: ${text}`);
  }
  const count = (group, word) => `${groups[group].length} ${word}${groups[group].length && group !== "current" ? ` (${groups[group].join(", ")})` : ""}`;
  // Each landing/release pair with its count; any pair but dev/main names its projects, an exception its reason.
  const landing = [...pairs].sort(([a], [b]) => (a === "dev/main" ? -1 : b === "dev/main" ? 1 : a.localeCompare(b)))
    .map(([pair, list]) => `${list.length} on ${pair}${pair === "dev/main" ? "" : ` (${list.join(", ")})`}`);
  const branchesNote = landing.length ? `; branches: ${landing.join(", ")}${exceptions.length ? `; exceptions: ${exceptions.join("; ")}` : ""}` : "";
  kitResult(groups.failed.length ? "fail" : "ok", names.length
    ? `init --all: ${count("updated", "updated")}, ${groups.waiting.length ? `${count("waiting", "waiting")}, ` : ""}${count("current", "up to date")}, ${count("skipped", "skipped")}, ${count("failed", "failed")}${branchesNote}`
    : `init --all: no projects in ${join(kitStateDir(), "projects.json")}`);
  process.exit(groups.failed.length ? 1 : 0);
}
