}

// --all: every project in the machine's projects.json gets the pieces kit init writes today, each through its own
// kit pr from a temporary worktree of origin's landing branch, so the main checkout and its work stay as they are.
// One RESULT line per project, then one for the run; it fails when any project failed. Never returns.
function all() {
