#!/usr/bin/env node
// kit: set a project up for the shared kit: settings, launchers, hooks and docs stubs
import { spawnSync } from "node:child_process";
import { chmodSync, closeSync, existsSync, mkdirSync, openSync, readdirSync, readFileSync, realpathSync, renameSync, rmSync, statSync, symlinkSync, writeFileSync } from "node:fs";
import { basename, dirname, join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";

const { kitGhRepo, kitHideUserInfo, kitHome, kitProjects, kitRegisterProject, kitResult, kitRoot, kitSettingsFile, kitSettingsProblems, kitStateDir } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = `Usage: kit init [--light | --full] [--land <branch>] [--release <branch>]
       kit init --check
       kit init --all
       kit init --pieces   (--all's own step, in its temporary worktree)
       kit init --issues [--close]
Set the project around the working folder up for the shared kit; the kit itself is never copied in.
Run it in the project's git repo (from the machine copy, ~/.local/share/agent-kit/current/kit init,
before the project has a launcher). It writes only what is missing and never deletes or overwrites a file:
  scripts/agents/kit.json   project, mainRoot and branches: land dev (or develop, or --land), release main
                            (or master, or --release); a repo with only main gets dev made from it, here and
                            on origin; checks guessed from package.json scripts (printed to confirm)
  scripts/agents/kit, scripts/agents/hooks/run.sh   the kit launcher and the hook launcher
  .claude/settings.json, .codex/hooks.json   the kit's hook entries, merged in; other settings stay
  AGENTS.md                 two lines pointing at scripts/agents/kit rulebook and kit --help
  .gitattributes            the line "* text=auto eol=lf", added at the top, so every checkout keeps LF
                            endings (a note names tracked files with CRLF to renormalize)
Full (the default for a new project) also writes an empty scripts/agents/project.d/ (its own commands),
docs/agents/kitchen.md (a pointer), docs/agents/kitchen-extras.md (from the kit's template),
docs/wayfinder/README.md, and names them in a new kit.json; --light leaves those out. A project with a kit.json
stays as it was set up: full when kit.json names "maps" or "rulebookExtras", else light; --full
adds the full pieces anyway. Pieces named in kit.json's "init": { "skip": [...] } (the name --check prints, or a
file's path for every piece in it) are never written. It lists the project in the machine's projects.json and
ends with kit doctor's result. Run in the main checkout, doctor's failing place check (no builds there) is a
note naming how to make a worktree. A rerun changes nothing and says so. Old kit files in the project
(kit-lib.sh, kit-lib.mjs, kit.d/, the guard hooks) stop it with a list, so the move removes them on purpose.

--check writes nothing: it prints "missing: <name> (<what>)" for each piece kit init would write today, the
name being the one "init.skip" takes (kit doctor shows these as warnings). It needs scripts/agents/kit.json.
--all brings every project in the machine's projects.json up to date, one after another: in a temporary
worktree of origin's landing branch it adds the missing pieces, commits them (and, when .gitattributes was
added, a git add --renormalize . commit), and lands them through the project's own kit pr (its tier from the
changed paths), always into the landing branch: a project whose settings still land on main (or on their release
branch) is skipped and named, unless "branches": { "exception": "<reason>" } says why. One RESULT line per
project, then one for the run: updated (merged), waiting (a PR opened or queued, its worktree kept until it
lands), up to date, skipped or failed, and each landing/release pair (dev/main) with its count and exceptions. A project whose main checkout has
uncommitted changes in the files the change touches is skipped and named, as is one without a git checkout,
an origin or a kit.json; a failed kit pr keeps its worktree and names it and its log. --pieces is that
worktree's step: add the missing pieces only, with no project list entry and no doctor. Each kit pr stops
after KIT_INIT_PR_TIMEOUT seconds (default 7200).

--issues copies the project's open GitHub Issues (gh issue list) into needs-triage tickets, one file each in
<maps>/backlog/tickets/NN-<slug>.md (maps from kit.json, else docs/wayfinder), with the Issue's text, labels,
link and comments, plus <maps>/backlog/map.md if missing; it closes nothing and skips an Issue that has a file
(its frontmatter "issue: <url>": this repo's, or an older name of it). The Issues are origin's repo's, never a
fork's upstream. Copied headings go two levels down. It does no setup and runs no doctor, so old kit files do not
stop it. gh and git fetch stop after KIT_ISSUES_TIMEOUT seconds (default 120).
--issues --close, once those files are on origin's landing branch, closes each open Issue with a comment
linking its file there; it closes nothing while any open Issue's file is missing on that branch.
`;

// fail never returns: it prints the RESULT line and exits, so it also ends expressions such as readJson's catch.
const fail = (text, code = 1) => { kitResult("fail", `init ${text}`); process.exit(code); };
const isObject = (value) => value && typeof value === "object" && !Array.isArray(value);
const options = { light: false, full: false, land: "", release: "", issues: false, close: false, check: false, all: false, pieces: false };
const args = process.argv.slice(2);
for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === "--help" || arg === "-h") { process.stdout.write(usage); process.exit(0); }
  else if (arg === "--light") options.light = true;
  else if (arg === "--full") options.full = true;
  else if (arg === "--check") options.check = true;
  else if (arg === "--all") options.all = true;
  else if (arg === "--pieces") options.pieces = true;
  else if (arg === "--issues") options.issues = true;
  else if (arg === "--close") options.close = true;
  else if (arg === "--land" || arg === "--release") {
    if (!args[i + 1] || args[i + 1].startsWith("-")) { process.stderr.write(usage); fail(`${arg} needs a branch name`, 2); }
    options[arg.slice(2)] = args[++i];
  }
  else { process.stderr.write(usage); fail(`unknown argument ${arg}`, 2); }
}
if (options.close && !options.issues) { process.stderr.write(usage); fail("--close goes with --issues", 2); }
if (options.issues && args.some((arg) => !["--issues", "--close"].includes(arg))) { process.stderr.write(usage); fail("--issues takes only --close", 2); }
if (options.light && options.full) { process.stderr.write(usage); fail("--light and --full do not go together", 2); }
for (const alone of ["--check", "--all", "--pieces"]) {
  if (args.includes(alone) && args.length > 1) { process.stderr.write(usage); fail(`${alone} takes no other arguments`, 2); }
}
if (options.all) all();

const root = kitRoot();
const git = (...gitArgs) => {
  const result = spawnSync("git", ["-C", root, ...gitArgs], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  return result.status === 0 ? result.stdout.trim() : null;
};
if (!git("rev-parse", "--show-toplevel")) fail(`${root} is not in a git repo; run kit init in the project's top folder`);
const at = (path) => resolve(root, path);
const home = kitHome();
if (options.issues) issues();

const old = ["scripts/agents/kit-lib.sh", "scripts/agents/kit-lib.mjs", "scripts/agents/kit.d/",
  "scripts/agents/hooks/bash-guard.sh", "scripts/agents/hooks/agent-cap.sh", "scripts/agents/hooks/session-env.sh"].filter((path) => existsSync(at(path)));
if (old.length && options.check) { kitResult("ok", `init check: old kit files (${old.join(", ")}); the move to the shared kit comes first`); process.exit(0); }
if (old.length) {
  console.log("kit init: this project holds old kit files; remove them on purpose first (the move does):");
  for (const path of old) console.log(`  ${path}`);
  fail(`old kit files: ${old.join(", ")}`);
}

// The file's text is kept beside its value, so a merge can check under the lock that nobody changed it meanwhile.
const readText = (path) => {
  try { return readFileSync(at(path), "utf8"); }
  catch (error) { fail(`${path} is unreadable (${String(error.message).replace(/\n/g, " ")}); fix it first, kit init never overwrites it`); }
};
const readJson = (path, text = readText(path)) => {
  try { return JSON.parse(text); }
  catch (error) { fail(`${path} is unreadable (${String(error.message).replace(/\n/g, " ")}); fix it first, kit init never overwrites it`); }
};
const branchExists = (name) => git("rev-parse", "--verify", "--quiet", `refs/heads/${name}`) !== null ||
  git("rev-parse", "--verify", "--quiet", `refs/remotes/origin/${name}`) !== null || git("symbolic-ref", "--short", "HEAD") === name;
const common = git("rev-parse", "--path-format=absolute", "--git-common-dir");
const gitMain = common ? dirname(common) : root;

const writes = [], kept = [], notes = [];
const extrasPath = "docs/agents/kitchen-extras.md", mapsPath = "docs/wayfinder", commandsPath = "scripts/agents/project.d";

// The settings file: kept as it is when there, else filled from git and package.json.
// unnamed: stub keys an existing settings file lacks, as [key, default, the stub file written there].
let settings, unnamed = [], full = !options.light, makeLand = null;
if (options.check && !existsSync(at(kitSettingsFile))) { kitResult("ok", `init check: no ${kitSettingsFile} (run kit init to set the project up)`); process.exit(0); }
if (options.pieces && !existsSync(at(kitSettingsFile))) fail(`--pieces needs ${kitSettingsFile}`);
if (existsSync(at(kitSettingsFile))) {
  settings = readJson(kitSettingsFile);
  const problems = kitSettingsProblems(settings);
  if (problems.length) fail(`${problems.join("; ")}; fix it first, kit init never overwrites it`);
  kept.push(kitSettingsFile);
  // A project stays as it was set up: full when its settings name the maps or the rulebook extras, or one of those
  // stubs is at its default place (an older kit init wrote them there without naming them), else light. Its own
  // commands folder says nothing: a light project may have one too.
  full = options.full || (!options.light && (["maps", "rulebookExtras"].some((key) => settings[key]) ||
    [`${mapsPath}/README.md`, extrasPath].some((path) => existsSync(at(path)))));
  for (const flag of ["land", "release"]) if (options[flag]) notes.push(`--${flag} ignored: ${kitSettingsFile} already names "branches"`);
  unnamed = full ? [["commands", commandsPath, `${commandsPath}/.gitkeep`], ["maps", mapsPath, `${mapsPath}/README.md`], ["rulebookExtras", extrasPath, extrasPath]]
    .filter(([key]) => !settings[key]) : [];
} else {
  // Work lands on dev and main takes only dev, through kit pr --release (Lex, 2026-10-31; ticket ke-89): a repo
  // with only main (or master) gets dev made from it. --land and --release name other branches.
  const usual = ["main", "master"].find(branchExists);
  const land = options.land || ["dev", "develop"].find(branchExists) || (usual ? "dev" : "");
  if (!land) fail("no dev, develop, main or master branch; name the landing branch with kit init --land <branch>", 2);
  if (git("check-ref-format", "--branch", land) === null) fail(`--land ${land} is not a branch name`, 2);
  const release = options.release || (["dev", "develop"].includes(land) ? usual : undefined);
  if (release && git("check-ref-format", "--branch", release) === null) fail(`--release ${release} is not a branch name`, 2);
  if (release === land) fail(`--release ${release} is the landing branch too; main takes only dev, so name two branches`, 2);
  if (!branchExists(land) && release && branchExists(release)) makeLand = { land, from: release };
  else if (!branchExists(land)) notes.push(`branch ${land} is not here or on origin yet; kit doctor's base check needs origin/${land} once the project has a GitHub repo`);
  const remote = kitHideUserInfo(git("remote", "get-url", "origin") ?? "");
  // The last part of the remote's path, after "/" or the ":" of host:repo (a token in the url never becomes it).
  const project = (remote && remote.replace(/\/+$/, "").split(/[/:]/).at(-1).replace(/\.git$/, "")) || basename(gitMain);
  settings = { project, mainRoot: gitMain, branches: { land, ...(release ? { release } : {}) } };
  const checks = guessChecks();
  if (checks) settings.checks = checks;
  if (full) Object.assign(settings, { commands: commandsPath, maps: mapsPath, rulebookExtras: extrasPath });
  writes.push({ path: kitSettingsFile, text: `${JSON.stringify(settings, null, 2)}\n`, said: `(${project}, lands on ${land})` });
}

// Where the stubs go: the folders and file the settings name, else the defaults a new settings file names.
const named = (key, fallback) => typeof settings[key] === "string" && settings[key].trim() ? settings[key].replace(/\/+$/, "") : fallback;
const commandsDir = named("commands", commandsPath), mapsDir = named("maps", mapsPath), extrasFile = named("rulebookExtras", extrasPath);

// Every piece kit init writes into a project goes through piece(): its name (the one "init.skip" takes and --check
// prints), its file, and what it is. One the project turned off (by name, or by its file's path) is left out;
// the rest are what --check reports missing, kit doctor warns about and --all brings to every project.
if (settings.init !== undefined && !isObject(settings.init)) fail(`"init" in ${kitSettingsFile} must be an object, as in "init": { "skip": [...] }; fix it first`);
const skip = settings.init?.skip ?? [];
if (!Array.isArray(skip) || skip.some((name) => typeof name !== "string")) fail(`"init.skip" in ${kitSettingsFile} must be a list of piece names; fix it first`);
const bare = (name) => name.trim().replace(/\/+$/, "");
const off = [], missing = [];
const turnedOff = (name, path) => skip.some((entry) => [name, path].map(bare).includes(bare(entry)));
const piece = (name, path, what) => {
  if (turnedOff(name, path)) { off.push(name); return false; }
  missing.push(`${name} (${what})`);
  return true;
};

// checks from package.json scripts, run as the lockfile's package manager does; printed for the lead to confirm.
function guessChecks() {
  if (!existsSync(at("package.json"))) { notes.push(`checks: none guessed (no package.json); add "checks" to ${kitSettingsFile}`); return null; }
  const scripts = readJson("package.json")?.scripts ?? {};
  const manager = existsSync(at("pnpm-lock.yaml")) ? "pnpm" : existsSync(at("yarn.lock")) ? "yarn"
    : existsSync(at("bun.lock")) || existsSync(at("bun.lockb")) ? "bun" : "npm";
  const run = (name) => manager === "npm" ? (name === "test" ? "npm test" : `npm run ${name}`) : manager === "yarn" ? `yarn ${name}` : `${manager} run ${name}`;
  const usable = (name) => typeof scripts[name] === "string" && !/no test specified/.test(scripts[name]);
  const checks = {};
  const check = ["check", "typecheck"].find(usable);
  if (check) checks.check = run(check);
  if (usable("test")) checks.test = run("test");
  if (usable("lint")) checks.lint = run("lint");
  const names = Object.entries(checks).map(([key, command]) => `${key}=${command}`);
  notes.push(names.length ? `checks guessed from package.json: ${names.join(", ")}; confirm them in ${kitSettingsFile}`
    : `checks: none guessed (package.json has no check, typecheck, test or lint script); add "checks" to ${kitSettingsFile}`);
  return names.length ? checks : null;
}

// A file written only when missing; one already there is kept as it is.
const template = (path, source, mode, what) => {
  if (existsSync(at(path))) { kept.push(path); return; }
  if (piece(path, path, what)) writes.push({ path, text: readFileSync(join(home, source), "utf8"), mode });
};
template("scripts/agents/kit", "launcher/kit", 0o755, "the kit launcher");
template("scripts/agents/hooks/run.sh", "launcher/hooks-run.sh", 0o755, "the hook launcher");

// Hook entries, merged into each file: a missing entry is added beside the others, nothing is replaced.
const hook = (name) => ({ type: "command", command: `bash "\${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}"/scripts/agents/hooks/run.sh ${name}` });
const agentCap = ["agent-cap"], session = ["session-env", "context-card"];
// brief-guard refuses a child's brief kit brief did not write; stop-guard refuses a turn end while a kit go job runs.
// Codex's PreToolUse sees only Bash, so it gets the Stop hook alone.
const hookFiles = {
  ".claude/settings.json": [["PreToolUse", "Bash", ["bash-guard"]], ["PreToolUse", "Agent|Task", agentCap],
    ["PreToolUse", "mcp__t3-code__delegate_task|Agent|Task", ["brief-guard"]], ["PostToolUse", "Agent|Task", agentCap],
    ["PostToolUseFailure", "Agent|Task", agentCap], ["SubagentStart", undefined, agentCap], ["SubagentStop", undefined, agentCap], ["SessionStart", undefined, session],
    ["Stop", undefined, ["stop-guard"]]],
  ".codex/hooks.json": [["PreToolUse", "Bash", ["bash-guard"]], ["SubagentStart", undefined, agentCap], ["SubagentStop", undefined, agentCap], ["SessionStart", undefined, session],
    ["Stop", undefined, ["stop-guard"]]],
};
for (const [path, entries] of Object.entries(hookFiles)) {
  const there = existsSync(at(path));
  // A file turned off whole is left as it is: counted as left out when it is missing or not a hook file kit init
  // could merge into, else entry by entry below (piece() matches its path), so only an entry it lacks counts.
  if (turnedOff(path, path)) {
    let config;
    try { config = there ? JSON.parse(readFileSync(at(path), "utf8")) : null; } catch {}
    if (!isObject(config) || (config.hooks !== undefined && !isObject(config.hooks)) ||
      entries.some(([event]) => config.hooks?.[event] !== undefined && !Array.isArray(config.hooks[event]))) { off.push(path); continue; }
  }
  const before = there ? readText(path) : null;
  const config = there ? readJson(path, before) : {};
  if (!isObject(config)) fail(`${path} must hold one JSON object; fix it first, kit init never overwrites it`);
  if (config.hooks === undefined) config.hooks = {};
  if (!isObject(config.hooks)) fail(`"hooks" in ${path} must be an object; fix it first, kit init never overwrites it`);
  let added = 0;
  for (const [event, matcher, names] of entries) {
    const groups = config.hooks[event] ?? [];
    if (!Array.isArray(groups)) fail(`"hooks.${event}" in ${path} must be a list; fix it first, kit init never overwrites it`);
    const same = groups.filter((group) => isObject(group) && group.matcher === matcher);
    for (const name of names) {
      const entry = hook(name);
      // Already there under any matcher of the event (say "Bash|Edit"): a second copy would run the hook twice.
      if (groups.some((group) => isObject(group) && Array.isArray(group.hooks) && group.hooks.some((other) => other?.command === entry.command))) continue;
      if (!piece(`${path} ${event} ${name}`, path, `the ${name} hook entry`)) continue;
      config.hooks[event] = groups;
      let group = same.find((candidate) => Array.isArray(candidate.hooks));
      if (!group) { group = { ...(matcher === undefined ? {} : { matcher }), hooks: [] }; groups.push(group); same.push(group); }
      group.hooks.push(entry);
      added++;
    }
  }
  if (!added) { kept.push(path); continue; }
  writes.push({ path, text: `${JSON.stringify(config, null, 2)}\n`, before, said: there ? `(merged ${added} hook entr${added === 1 ? "y" : "ies"})` : "" });
}

// Full only: the project's own commands folder (kept in git by .gitkeep) and the docs stubs.
if (full) {
  if (existsSync(at(commandsDir))) kept.push(`${commandsDir}/`);
  else if (piece(`${commandsDir}/`, commandsDir, "the project's own commands folder")) writes.push({ path: `${commandsDir}/.gitkeep`, text: "" });
  const extrasLink = relative(at("docs/agents"), at(extrasFile));
  const pointer = `# The kitchen

Run \`scripts/agents/kit rulebook\`: it prints the kitchen rulebook, every station from idea to
release, who decides, and the builder and reviewer pins. It has two parts:

- **The shared rulebook,** the same for every project, with the kit (\`docs/kitchen.md\` in the Agent Kit).
- **This project's extras,** which win where they differ: [${extrasFile}](${extrasLink})
  (named by \`rulebookExtras\` in \`scripts/agents/kit.json\`).

A change to the shared kit is a ticket on the kitchen-everywhere board
(\`docs/wayfinder/kitchen-everywhere/build/\` in native-site-editor, on \`dev\`), built only by that
board's orchestrator: write it there, or ask the orchestrator to, and go on with this project's work.
`;
  if (existsSync(at("docs/agents/kitchen.md"))) kept.push("docs/agents/kitchen.md");
  else if (piece("docs/agents/kitchen.md", "docs/agents/kitchen.md", "the kitchen pointer")) writes.push({ path: "docs/agents/kitchen.md", text: pointer });
  if (existsSync(at(extrasFile))) kept.push(extrasFile);
  else if (piece(extrasFile, extrasFile, "the project's kitchen extras")) {
    const land = settings.branches.land, release = settings.branches.release || land;
    const text = readFileSync(join(home, "docs/kitchen-extras-template.md"), "utf8")
      .replaceAll("<project>", () => settings.project).replaceAll("<land>", () => land).replaceAll("<release>", () => release);
    writes.push({ path: extrasFile, text });
  }
  const readme = `# Wayfinder maps

One folder per map, \`${mapsDir}/<map>/\`: its tickets in \`tickets/\` and its build's in
\`build/tickets/\` (\`maps\` in \`scripts/agents/kit.json\`). Run \`scripts/agents/kit rulebook\` for how a
map goes from idea to tickets, and \`scripts/agents/kit next <map>\` to hand its work out.
`;
  if (existsSync(at(`${mapsDir}/README.md`))) kept.push(`${mapsDir}/README.md`);
  else if (piece(`${mapsDir}/README.md`, `${mapsDir}/README.md`, "the maps README")) writes.push({ path: `${mapsDir}/README.md`, text: readme });
}

// The keys an existing settings file lacks are named only when this run writes their stubs, not on every rerun.
const stubsWritten = unnamed.filter(([, , stub]) => writes.some(({ path }) => path === stub));
if (stubsWritten.length) notes.push(`add to ${kitSettingsFile} (kit init never edits it): ${stubsWritten.map(([key, value]) => `"${key}": "${value}"`).join(", ")}`);

// AGENTS.md: the two lines, added to the end when missing.
const agentLines = [
  ["scripts/agents/kit rulebook", "Kitchen rulebook: `scripts/agents/kit rulebook` (stations, who decides, builder and reviewer pins)."],
  ["scripts/agents/kit --help", "Agent commands: `scripts/agents/kit --help`; `scripts/agents/kit <command> --help` for one."],
];
const agents = existsSync(at("AGENTS.md")) ? readText("AGENTS.md") : null;
const absentLines = agentLines.filter(([marker]) => !agents?.includes(marker));
const missingLines = absentLines.filter(([marker]) => piece(`AGENTS.md ${marker.replace("scripts/agents/", "")}`, "AGENTS.md", `the line naming ${marker}`))
  .map(([, line]) => line);
if (!absentLines.length) kept.push("AGENTS.md");
else if (!missingLines.length) { /* every absent line is turned off */ }
else if (agents === null) writes.push({ path: "AGENTS.md", text: `# Agents\n\n${missingLines.join("\n")}\n` });
else writes.push({ path: "AGENTS.md", text: `${agents.replace(/\n*$/, "\n\n")}${missingLines.join("\n")}\n`, before: agents, said: `(added ${missingLines.length} line${missingLines.length === 1 ? "" : "s"})` });

// .gitattributes: LF endings in every checkout, so a Windows clone cannot break tests that read files. The line goes
// at the top, so the project's own lines after it (*.png binary) still win for their files.
const lineEndings = "* text=auto eol=lf";
const attributes = existsSync(at(".gitattributes")) ? readText(".gitattributes") : null;
// A line for every file setting the same two attributes, in any order or spacing, counts as there.
const sameLine = (line) => { const [pattern, ...set] = line.trim().split(/\s+/); return pattern === "*" && set.sort().join(" ") === "eol=lf text=auto"; };
if (attributes?.split(/\r?\n/).some(sameLine)) kept.push(".gitattributes");
else if (piece(".gitattributes", ".gitattributes", `the line "${lineEndings}"`)) {
  const newline = attributes?.includes("\r\n") ? "\r\n" : "\n";
  writes.push(attributes === null ? { path: ".gitattributes", text: `${lineEndings}\n` }
    : { path: ".gitattributes", text: `${lineEndings}${newline}${attributes}`, before: attributes, said: "(added the line-endings line at the top)" });
}

if (options.check) {
  for (const line of missing) console.log(`missing: ${line}`);
  kitResult("ok", `init check: ${missing.length ? `${missing.length} missing` : "nothing missing"}${off.length ? `; ${off.length} turned off in init.skip` : ""}`);
  process.exit(0);
}

// The files are written under the project list's lock, once the name is checked: a name another root holds
// stops the run before anything is written, and two runs cannot both take one name. A new file is created only
// if it is still missing, and a merged one written only if it still holds what was read, so nothing is overwritten.
const projectRoot = settings.mainRoot || gitMain;
const done = [];
const writeAll = () => {
  for (const { path, text, mode, said, before = null } of writes) {
    try {
      mkdirSync(dirname(at(path)), { recursive: true });
      if (before === null) {
        writeFileSync(at(path), text, { flag: "wx" });
        if (mode) chmodSync(at(path), mode);
      } else {
        if (readFileSync(at(path), "utf8") !== before) throw new Error("it changed while kit init ran; run kit init again");
        // A merged file is replaced in one rename, keeping its mode, so a failed write never leaves it cut short.
        const temporary = `${at(path)}.${process.pid}.tmp`;
        try {
          writeFileSync(temporary, text, { flag: "wx", mode: statSync(at(path)).mode & 0o7777 });
          renameSync(temporary, at(path));
