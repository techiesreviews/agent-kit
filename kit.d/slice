#!/usr/bin/env node
// kit: build, commit, review, fix, check the UX of and land one ticket with resumable phases
import { execFileSync, spawn } from "node:child_process";
import { closeSync, existsSync, mkdirSync, openSync, readFileSync, readdirSync, renameSync, writeFileSync } from "node:fs";
import { basename, dirname, join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { afterFixRounds, blockingFindings, completedFixRounds, FIX_ROUNDS, openFindings, reviewCoversHead } from "../review-findings.mjs";
import { builderChecks, spoken } from "../review-brief.mjs";
import { visiblePath } from "../pr-tier.mjs";

const { kitBranch, kitRoot, kitMainRoot, kitOwner, kitResult, kitSettings, nodeEnv, commitBuilderWork, builderAuthor, kitScore, scoreCost, scoreReview } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit slice --ticket FILE --builder MODEL [--effort high] [--rounds 3] [--no-pr]\nResume saved phases under .scratch/kit-slice/<ticket-slug>/.\nAfter the code review and its fix rounds, kit ux checks touched features: broken or looks off gets one kit fix --note round;\nstill broken stops (decide: ux broken <feature>), looks off lands with UX follow-ups in the ticket.\nLast, a second look (kit review --second-look) gets the same fix rounds, then looks again at the new HEAD;\nwhen no model can take it, the slice goes on and says why.\nQueued PRs are awaited for up to 2h; reruns resume the wait.\nOverrides: ASE_SLICE_AGENT, ASE_SLICE_KIT, ASE_SLICE_GH; ASE_SLICE_MERGE_TIMEOUT_MS, ASE_SLICE_MERGE_POLL_MS.\n";

function options(args) {
  const flags = { effort: "high", rounds: FIX_ROUNDS, noPr: false };
  const seen = new Set();
  for (let i = 0; i < args.length; i++) {
    const flag = args[i];
    if (seen.has(flag)) throw new Error(`duplicate option: ${flag}`);
    seen.add(flag);
    if (flag === "--no-pr") { flags.noPr = true; continue; }
    if (!["--ticket", "--builder", "--effort", "--rounds"].includes(flag) || !args[i + 1] || args[i + 1].startsWith("-"))
      throw new Error(`invalid option: ${flag}`);
    flags[flag.slice(2)] = args[++i];
  }
  if (!flags.ticket || !flags.builder) throw new Error("--ticket and --builder are required");
  if (!/^[1-9]\d*$/.test(String(flags.rounds)) || !Number.isSafeInteger(Number(flags.rounds)))
    throw new Error("--rounds must be a positive integer");
  flags.rounds = Number(flags.rounds);
  flags.model = flags.builder === "sol" ? "gpt-6.1-sol" : flags.builder;
  return flags;
}

async function slice(args) {
  let phase = "brief", log, state, directory, started, exit, ended;
  try {
    let flags;
    try { flags = options(args); } catch (error) { process.stderr.write(usage); throw error; }
    const root = resolve(kitRoot()), env = nodeEnv();
    const git = (...argv) => execFileSync("git", ["-C", root, ...argv], { env, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
    const branch = git("branch", "--show-current");
    // The land and release branches (scripts/agents/kit.json) are never a slice's branch; without
    // readable settings they are unknown, so the slice stops with the settings problem.
    const settings = kitSettings(root);
    const refused = [...new Set([kitBranch("land", settings), kitBranch("release", settings)].filter(Boolean))];
    const not = [...refused, "detached HEAD"];
    if (!branch || refused.includes(branch)) throw new Error(`use a build branch, not ${not.slice(0, -1).join(", ")} or ${not.at(-1)}`);
    const ticket = resolve(root, flags.ticket);
    const source = readFileSync(ticket, "utf8");
    const section = name => new RegExp(`^## ${name}\\s*\\n([\\s\\S]*?)(?=^## |$(?![\\s\\S]))`, "m").exec(source)?.[1]?.trim();
    const files = section("Files"), done = section("Done when");
    const title = /^title:\s*(.+)$/m.exec(source)?.[1].trim().replace(/^(["'])(.*)\1$/, "$2");
    if (!title || !files || !done) throw new Error("ticket must have a title, Files and Done when");
    directory = join(root, ".scratch/kit-slice", basename(ticket, ".md"));
    const statePath = join(directory, "state.json");
    const resuming = existsSync(statePath);
    if (!resuming && git("status", "--porcelain", "--untracked-files=all"))
      throw new Error("new slice requires a clean worktree; staged, unstaged or untracked changes exist");
    mkdirSync(directory, { recursive: true });
    state = resuming ? JSON.parse(readFileSync(statePath, "utf8")) : {
      ticket, branch, model: flags.model, effort: flags.effort, head: git("rev-parse", "HEAD"), finished: [], rounds: 0,
    };
    if (state.ticket !== ticket || state.branch !== branch)
      throw new Error("saved slice belongs to a different ticket or branch");
    state.effort ||= "high"; // States saved before effort was recorded ran at the default.
    // States saved before buildModel credit the model they last recorded: a best guess, since a
    // finished build may predate earlier switches. Saved so a later switch cannot replace it.
    if (state.finished.includes("build")) state.buildModel ??= state.model;
    if (state.model !== flags.model || state.effort !== flags.effort) {
      const label = (model, effort) => effort === "high" ? model : `${model} (${effort})`;
      if (state.model !== flags.model)
        state.previousModels = [...(Array.isArray(state.previousModels) ? state.previousModels : []), state.model];
      if (state.effort !== flags.effort)
        state.previousEfforts = [...(Array.isArray(state.previousEfforts) ? state.previousEfforts : []), state.effort];
      // A saved run replays its own model and effort, so a switched slice must not resume it.
      delete state.build;
      console.log(`builder switched: ${label(state.model, state.effort)} -> ${label(flags.model, flags.effort)}`);
      state.model = flags.model; state.effort = flags.effort;
    }
    if (flags.noPr && state.queued && git("rev-parse", "HEAD") !== state.queued.head)
      throw new Error("queued slice HEAD changed; --no-pr cannot reuse the review of the queued HEAD");
    const save = () => {
      writeFileSync(`${statePath}.tmp`, JSON.stringify(state, null, 2) + "\n");
      renameSync(`${statePath}.tmp`, statePath);
    };
    // The scoreboard record: builder and rounds on every write, plus what this phase adds.
    const score = change => kitScore({ ticket, branch, root }, record => {
      // built is the model that did the build; model is the current builder, which fix rounds use.
      record.builder = { model: state.model, effort: state.effort, previousModels: state.previousModels ?? [], built: state.buildModel ?? null };
      record.rounds = Math.max(record.rounds, state.rounds);
      change(record);
    });
    ended = code => score(record => {
      record.phases.push({ name: phase, start: started, end: new Date().toISOString(), exit: code });
      if (code) return;
      if (phase === "build" && state.build) scoreCost(record, state.build);
      if (["review", "fix", "second"].includes(phase) && state.review) scoreReview(record, state.review);
      if (phase === "pr" && state.sha) {
        // kit pr prints a short SHA after recording the full one; keep its SHA and time.
        const same = typeof record.landed?.sha === "string" && record.landed.sha.startsWith(state.sha);
        record.landed = { ...record.landed, pr: Number(state.pr), sha: same ? record.landed.sha : state.sha,
          at: same && record.landed.at || new Date().toISOString() };
      }
    });
    const complete = detail => {
      if (!state.finished.includes(phase)) state.finished.push(phase);
      save();
      ended(0);
      console.log(`slice: ${phase} ok${detail ? ` ${detail}` : ""}`);
    };
    const begin = name => {
      phase = name; log = join(directory, `${name}.log`); started = new Date().toISOString(); exit = 0;
      if (!existsSync(log)) writeFileSync(log, "");
    };
    const assertBranch = () => {
      if (git("branch", "--show-current") !== state.branch) throw new Error("worktree branch changed during slice");
    };
    const assertHead = expected => {
      assertBranch();
      if (git("rev-parse", "HEAD") !== expected) throw new Error("worktree HEAD changed during slice");
    };
    async function execute(command, argv) {
      const previous = readFileSync(log, "utf8");
      const fd = openSync(log, "a");
      let code;
      try {
        code = await new Promise((accept, reject) => {
          const child = spawn(command, argv, { cwd: root, env, stdio: ["ignore", fd, fd] });
          const interrupt = () => child.kill("SIGINT"), terminate = () => child.kill("SIGTERM");
          process.once("SIGINT", interrupt); process.once("SIGTERM", terminate);
          const clear = () => { process.removeListener("SIGINT", interrupt); process.removeListener("SIGTERM", terminate); };
          child.once("error", error => { clear(); reject(error); });
          child.once("close", status => { clear(); accept(status ?? 1); });
        });
      } finally { closeSync(fd); }
      exit = code;
      assertBranch();
      return { code, output: readFileSync(log, "utf8").slice(previous.length) };
    }
    const requireSuccess = result => {
      if (result.code !== 0) {
        // The child's last RESULT names why; a skip (exit 3, such as a review out of credit) keeps its word.
        const [, verb, text] = [...result.output.matchAll(/^RESULT: (fail|skip) (.+)$/gm)].at(-1) ?? [];
        const reason = verb === "skip" ? `skip ${text}` : text;
        throw new Error(`command exited ${result.code}${reason ? `: ${reason}` : ""}; see ${log}`);
      }
      return result.output;
    };
    async function waitForMerge() {
      const timeout = Number(env.ASE_SLICE_MERGE_TIMEOUT_MS || 7_200_000);
      const poll = Number(env.ASE_SLICE_MERGE_POLL_MS || 10_000);
      if (![timeout, poll].every(value => Number.isSafeInteger(value) && value > 0))
        throw new Error("merge timeout and poll interval must be positive integer milliseconds");
      const deadline = Date.now() + timeout;
      for (;;) {
        const output = requireSuccess(await execute(env.ASE_SLICE_GH || "gh", ["pr", "view", state.pr, "--json", "state,mergeCommit,headRefOid"]));
        const pr = JSON.parse(output);
        if (pr.headRefOid !== state.queued.head) throw new Error(`queued PR #${state.pr} head changed; expected ${state.queued.head}`);
        if (pr.state === "MERGED") {
          if (!/^[a-f\d]{40}$/i.test(pr.mergeCommit?.oid || "")) throw new Error("merged PR has no merge SHA");
          state.sha = pr.mergeCommit.oid; delete state.queued;
          complete(`#${state.pr}`); return;
        }
        if (pr.state !== "OPEN") throw new Error(`queued PR #${state.pr} is ${pr.state}, not merged`);
        const remaining = deadline - Date.now();
        if (remaining <= 0) throw new Error(`queued PR #${state.pr} merge wait timed out; rerun slice to resume`);
        await new Promise(accept => setTimeout(accept, Math.min(poll, remaining)));
        assertBranch();
      }
    }
    function reviewEvidence(explicit) {
      let folders;
      if (explicit) folders = [resolve(root, explicit)];
      else {
        // A second look's folder (marked second-look.json) is never Claude's review.
        const parent = join(kitMainRoot(), ".scratch/reviews", kitOwner());
        folders = existsSync(parent) ? readdirSync(parent).sort((a, b) => b.localeCompare(a, "en", { numeric: true })).map(name => join(parent, name))
          .filter(folder => !existsSync(join(folder, "second-look.json"))) : [];
      }
      for (const folder of folders) {
        try {
          if (reviewCoversHead(readFileSync(join(folder, "refs.txt"), "utf8").split(/\r?\n/)[0], git("rev-parse", "HEAD"), ticket, root)) return folder;
        } catch { /* Incomplete evidence cannot cover HEAD. */ }
      }
      throw new Error("no review evidence covers HEAD");
    }
    // Looks off left after the fix round: a `### UX follow-ups` list in the ticket's last `## Done` section (made when
    // missing, as kit pr does), one line per feature (a feature already listed keeps its line), committed alone (a ticket-only commit keeps the review).
    // Images are named from the main root, so the ticket holds no machine path. Returns the new HEAD, or null.
    function uxFollowups(ux, head) {
      const original = readFileSync(ticket, "utf8");
      const start = [...original.matchAll(/^## Done(?:[ \t]+\(\d{4}-\d{2}-\d{2}\))?[ \t]*\r?$/gm)].at(-1)?.index;
      const prefix = start === undefined ? `${original.trimEnd()}\n\n## Done (${new Date().toISOString().slice(0, 10)})` : original.slice(0, start);
      const rest = start === undefined ? "" : original.slice(start);
      const end = rest.slice(1).search(/^## /m), doneEnd = end < 0 ? rest.length : end + 1;
      let done = rest.slice(0, doneEnd);
      const list = /^### UX follow-ups\s*\n([\s\S]*?)(?=^#{1,3} |$(?![\s\S]))/m.exec(done);
      const listed = list?.[1].split(/\r?\n/) ?? [];
      const key = feature => `- UX (looks off): ${feature.id} ${feature.note}`;
      const missing = ux.features.filter(feature => feature.verdict === "off")
        .filter(feature => !listed.some(line => line.startsWith(`- UX (looks off): ${feature.id} `)))
        .map(feature => `${key(feature)}${feature.image ? ` (${relative(kitMainRoot(), resolve(dirname(ux.path), feature.image))})` : ""}`);
      if (!missing.length) return null;
      if (list) {
        const position = list.index + list[0].trimEnd().length;
        done = `${done.slice(0, position)}\n${missing.join("\n")}${done.slice(position)}`;
      } else done = `${done.trimEnd()}\n\n### UX follow-ups\n\n${missing.join("\n")}\n\n`;
      const after = rest.slice(doneEnd);
      writeFileSync(ticket, after ? prefix + done + after : `${(prefix + done).trimEnd()}\n`);
      git("commit", "--quiet", "-m", `docs: ${basename(ticket, ".md")} UX follow-ups`, "--", ticket);
      if (git("rev-parse", "HEAD^") !== head) throw new Error("UX follow-ups commit is not one commit on the checked HEAD");
      return git("rev-parse", "HEAD");
    }
    const findings = () => {
      let text = "";
      try { text = readFileSync(join(state.review, "result.md"), "utf8"); } catch { /* Fail closed. */ }
      return openFindings(text).findings;
    };
    const branchRounds = () => completedFixRounds(join(kitMainRoot(), ".scratch/kit-fix", encodeURIComponent(branch)),
      join(root, ".scratch/kit-fix", encodeURIComponent(branch)));
    const stopping = open => afterFixRounds(branchRounds()) ? blockingFindings(open) : open;
    const kit = env.ASE_SLICE_KIT || resolve(import.meta.dirname, "../kit");
    const agent = env.ASE_SLICE_AGENT || resolve(import.meta.dirname, "../agent.sh");
    const pendingPath = join(root, ".scratch/kit-fix", encodeURIComponent(branch), "pending.json");
    const pendingFix = () => state.pendingFix && existsSync(pendingPath);
    // What a pending kit fix round answers, so a resumed round passes the same review or note.
    const pendingSource = () => {
      try {
        const pending = JSON.parse(readFileSync(pendingPath, "utf8"));
        return typeof pending.note === "string" ? ["--note", pending.note] : typeof pending.review === "string" ? ["--review", pending.review] : null;
      } catch { return null; }
    };
    // A fix round past its builder step finishes under its saved model; a switch applies from the next round.
    const pastBuilder = () => {
      try { return pendingFix() && ["commit", "review"].includes(JSON.parse(readFileSync(pendingPath, "utf8")).phase); }
      catch { return false; }
    };
    // Ticket-only changes preserve review and fixes; landing must cover the new HEAD.
    if (!state.queued && !pendingFix() && state.finished.includes("commit") && state.head !== git("rev-parse", "HEAD")) {
      state.finished = state.finished.filter(name => name !== "pr");
      delete state.sha;
      let covering = false;
      try { covering = reviewEvidence(state.review) === state.review; } catch { /* Re-review other changes. */ }
      if (!covering) {
        state.finished = state.finished.filter(name => !["review", "fix", "second", "ux", "pr"].includes(name));
        delete state.review; delete state.secondLook; delete state.uxFix; delete state.uxReport;
      }
      state.head = git("rev-parse", "HEAD");
      delete state.pendingFix;
    }
    if (!state.queued && !pendingFix() && !state.finished.includes("pr") && state.finished.includes("review")) {
      let covering = false;
      try { covering = reviewEvidence(state.review) === state.review; } catch { /* Re-review stale evidence. */ }
      if (!covering) {
        state.finished = state.finished.filter(name => !["review", "fix", "second", "ux", "pr"].includes(name));
        delete state.secondLook; delete state.uxFix; delete state.uxReport;
      } else if (stopping(findings()).length) {
        state.finished = state.finished.filter(name => !["fix", "second", "ux", "pr"].includes(name));
        delete state.secondLook; delete state.uxReport;
      }
    }
    save();
    begin("brief");
    if (!state.finished.includes(phase)) {
      const brief = join(root, ".scratch/agent-brief.md");
      // The contract names only the checks the project sets (builderChecks).
      const { unit, check } = builderChecks(root, settings);
      // In a TypeScript project (a tsconfig.json) checks.check is the type check; any other command runs every time.
      const when = existsSync(join(root, "tsconfig.json")) ? "when types moved" : "before handing back";
      const validate = `Validate with ${spoken([unit && "scripts/agents/kit unit --affected", "the ticket's focused checks"].filter(Boolean))}${check ? `; run ${check} ${when}` : ""}.`;
      writeFileSync(brief, `Ticket: ${flags.ticket}\n\n## Files\n${files}\n\n## Done when\n${done}\n\n## Builder contract\nDo not run kit review, kit fix, kit slice, kit pr, kit bg or agent.sh (including scripts/agents/kit forms); the slice runs those commands.\nUse Agent Kit at scripts/agents/kit; run doctor first. ${validate} Report their RESULT lines.\nIf you change something a user can see, update \`docs/agents/features.md\` (Try, Good, Files, Steps) or write \`Feature list: no change (<reason>)\` in Done.\nStay within Files. Leave changes unstaged; the runner commits. Do not commit, push, deploy, spawn agents or use git stash.\nDo not mention staging, committing or unstaged changes in the ticket.\nAppend \`## Done (YYYY-MM-DD)\` describing only behaviour, tests and commits; the slice records review decisions and landing. Do not claim a landing result. Set \`status: closed\`, \`assignee: ${kitOwner()}\`.\n`);
      writeFileSync(log, `Brief: ${brief}\n`);
      complete();
    }
    begin("build");
    if (!state.finished.includes(phase)) {
      assertHead(state.head);
      state.build = join(directory, "builder"); state.buildModel = flags.model; save();
      const output = requireSuccess(await execute(agent, ["build", root, ".scratch/agent-brief.md", "--model", flags.model, "--effort", flags.effort, "--out", state.build]));
      assertHead(state.head);
      state.build = resolve(root, /^artifacts: (.+)$/m.exec(output)?.[1] || state.build);
      complete(state.build);
    }
    begin("commit");
    if (!state.finished.includes(phase)) {
      try {
        state.head = commitBuilderWork({ root, branch, head: state.head, message: title, author: builderAuthor(state.buildModel), env });
        writeFileSync(log, `${state.head}\n`);
      } catch (error) { writeFileSync(log, `${error.message}\n`); throw error; }
      complete(state.head);
    }
    begin("review");
    if (!state.finished.includes(phase)) {
      const head = state.head;
      const output = requireSuccess(await execute(kit, ["review", "--ticket", flags.ticket]));
      assertHead(head);
      const evidence = /^RESULT: ok review .+ evidence (.+)$/m.exec(output)?.[1];
      if (!evidence) throw new Error("review did not name its evidence folder");
      state.review = reviewEvidence(evidence); state.reviewedHead = head;
      complete(state.review);
    }
    // One kit fix round answering the review (--review DIR) or a note (--note FILE); it commits and reviews again.
    async function fixRound(source) {
      if (pendingFix()) assertBranch(); // kit fix checks its saved commit/review HEAD.
      else assertHead(state.head);
      state.pendingFix = true; save();
      const builder = pastBuilder() ? [] : ["--builder", flags.model, "--effort", flags.effort];
      const result = await execute(kit, ["fix", "--ticket", flags.ticket, ...source, ...builder,
        ...(state.build ? ["--run", state.build] : [])]);
      // kit fix exits 1 both for command failures and completed reviews with findings.
      const remaining = /^RESULT: fail fix \d+ open findings \((.+)\/result\.md\)$/m.exec(result.output);
      if (result.code !== 0 && !remaining) requireSuccess(result);
      state.review = reviewEvidence(remaining?.[1]);
      state.head = git("rev-parse", "HEAD"); state.reviewedHead = state.head; state.rounds++;
      delete state.pendingFix;
      save();
      score(record => scoreReview(record, state.review));
    }
    begin("fix");
    if (!state.finished.includes(phase)) {
      let open = findings();
      while (stopping(open).length && state.rounds < flags.rounds) {
        await fixRound(["--review", state.review]);
        open = findings();
      }
      if (stopping(open).length) {
        if (!flags.noPr) {
          // Open/update the PR, explicitly prohibit merging even if its review changes.
          const fixStarted = started;
          begin("pr");
          const result = await execute(kit, ["pr", "--ticket", flags.ticket, "--no-merge"]);
          const refused = /^RESULT: fail pr #(\d+) (?:review|second look) has [1-9]\d* open findings \(.+\)$/m.exec(result.output);
          const opened = /^RESULT: ok opened #(\d+) [a-f\d]{7,40}$/m.exec(result.output);
          if (result.code === 1 && refused) state.pr = refused[1];
          else {
            requireSuccess(result);
            if (!opened) throw new Error("PR did not identify an opened, unmerged PR; see phase log");
            state.pr = opened[1];
          }
          save(); phase = "fix"; started = fixStarted;
        }
        // Preserve command output; print only findings in the failure digest.
        log = join(directory, "findings.log");
        writeFileSync(log, open.slice(0, 15).map(item => `${item.group}: ${item.text}`).join("\n") + "\n");
        throw new Error(`${open.length} open findings after ${state.rounds} rounds (${join(state.review, "result.md")})`);
      }
      complete(`${state.rounds} rounds${open.length ? `, ${open.length} follow-ups` : ""}`);
    }
    // The UX gate's check: null when nothing visible was touched, else the ux.json report of the bundle kit ux names.
    const uxCheck = async () => {
      const head = state.head;
      assertHead(head);
      const result = await execute(kit, ["ux", "--ticket", flags.ticket]);
      assertHead(head);
      if (/^RESULT: ok ux nothing visible touched$/m.test(result.output)) return null;
      const path = /^report: (.+)$/m.exec(result.output)?.[1];
      let report;
      try { report = path && JSON.parse(readFileSync(path, "utf8")); } catch { /* A missing report fails below. */ }
      if (!report) { requireSuccess(result); throw new Error(`ux wrote no report; see ${log}`); }
      // A failure that broke no feature (a screens run, the reviewer) is not something a fix round answers.
      if (result.code && !report.broken.length) requireSuccess(result);
      return { ...report, path };
    };
    begin("ux");
    if (!state.finished.includes(phase)) {
      // A report saved before the follow-ups commit is reused, so a rerun after that commit pays no second review.
      const savedReport = () => { try { return { ...JSON.parse(readFileSync(state.uxReport, "utf8")), path: state.uxReport }; } catch { return undefined; } };
      let ux = state.uxReport ? savedReport() : undefined;
      if (ux === undefined) ux = state.uxFix ? undefined : await uxCheck();
      if (ux && !state.uxFix && (ux.broken.length || ux.off.length)) {
        state.uxFix = { note: join(dirname(ux.path), "ux.md"), done: false }; save();
      }
      if (state.uxFix && !state.uxReport) {
        if (!state.uxFix.done) {
          await fixRound(["--note", state.uxFix.note]);
          state.uxFix.done = true; save();
        }
        // The round's own review gets the usual fix rounds, a half-done one resumed first; only what still blocks stops the slice.
        while (pendingFix() || (stopping(findings()).length && state.rounds < flags.rounds)) await fixRound(["--review", state.review]);
        const open = stopping(findings());
        if (open.length) throw new Error(`${open.length} open review findings after the UX fix round (${join(state.review, "result.md")})`);
        ux = await uxCheck();
      }
      if (ux?.broken.length) throw new Error(`decide: ux broken ${ux.broken.join(", ")} (${join(dirname(ux.path), "ux.md")})`);
      if (ux?.off.length) {
        state.uxReport = ux.path; save();
        // Same proof as the check: the reviewed HEAD, nothing uncommitted, right before the ticket is written.
        assertHead(state.head);
        if (git("status", "--porcelain", "--untracked-files=normal")) throw new Error("worktree changed before recording UX follow-ups");
        const head = uxFollowups(ux, state.head);
        if (head) { state.head = head; save(); }
      }
      complete(!ux ? "skipped: nothing visible touched" : `${ux.counts.fine} fine, ${ux.counts.broken} broken${ux.off.length ? `, ${ux.off.length} looks off as follow-ups` : ""}`);
    }
    // The second look, last before landing (after the UX gate, so it sees the final code): its findings get the
    // same fix rounds as Claude's, each answered by Claude's review, then a fresh second look of the new HEAD, so
    // kit pr finds one covering what it lands. When no model can take it, the slice goes on and says why.
    begin("second");
    if (!state.finished.includes(phase)) {
      for (;;) {
        if (state.secondLook?.answering) {
          // A round answering the second look, resumed where it stopped (saved before it started), then Claude's rounds.
          if (!pendingFix() && state.rounds === state.secondLook.round) await fixRound(["--review", state.secondLook.evidence]);
          while (pendingFix() || (stopping(findings()).length && state.rounds < flags.rounds)) await fixRound(pendingSource() ?? ["--review", state.review]);
          const open = stopping(findings());
          if (open.length) throw new Error(`${open.length} open review findings after the second look's fix rounds (${join(state.review, "result.md")})`);
          // Fixes since the HEAD the second look saw that reached a visible path get the UX gate again before
          // landing; when that HEAD cannot be read, the gate runs again to be safe.
          let touched;
          try {
            const seen = readFileSync(join(state.secondLook.evidence, "refs.txt"), "utf8").split(/\r?\n/)[0];
            touched = git("diff", "--name-only", seen, "HEAD").split("\n").filter(Boolean);
          } catch { touched = null; }
          if (!touched || touched.some(path => visiblePath(path, settings))) state.uxAgain = true;
          delete state.secondLook; save();
        }
        if (!state.secondLook) {
          const head = state.head;
          assertHead(head);
          const result = await execute(kit, ["review", "--ticket", flags.ticket, "--second-look"]);
          assertHead(head);
          if (result.code === 3) state.secondLook = { skipped: /^second look: skipped \((.+)\)$/m.exec(result.output)?.[1] || "no reason given" };
          else {
            const evidence = /^RESULT: ok review .+ evidence (.+)$/m.exec(requireSuccess(result))?.[1];
            if (!evidence) throw new Error("second look did not name its evidence folder");
            state.secondLook = { evidence: reviewEvidence(evidence) };
          }
          save();
          // Every second look is scored when saved: one that found something is replaced by a fresh one later.
          if (state.secondLook.evidence) score(record => scoreReview(record, state.secondLook.evidence));
        }
        if (state.secondLook.skipped) {
          console.log(`second look: skipped (${state.secondLook.skipped})`);
          complete(`skipped (${state.secondLook.skipped})`);
          break;
        }
        const result = join(state.secondLook.evidence, "result.md");
        let text = "";
        try { text = readFileSync(result, "utf8"); } catch { /* Fail closed. */ }
        const open = stopping(openFindings(text).findings);
        if (!open.length) {
          if (state.uxAgain) {
            // Once more, without another fix round: still broken stops for a decision, looks off goes to UX follow-ups.
            const ux = await uxCheck();
            if (ux?.broken.length) throw new Error(`decide: ux broken ${ux.broken.join(", ")} after the second look's fixes (${join(dirname(ux.path), "ux.md")})`);
            if (ux?.off.length) {
              assertHead(state.head);
              if (git("status", "--porcelain", "--untracked-files=normal")) throw new Error("worktree changed before recording UX follow-ups");
              const head = uxFollowups(ux, state.head);
              if (head) state.head = head;
            }
            delete state.uxAgain; save();
          }
          complete(result); break;
        }
        if (state.rounds >= flags.rounds) throw new Error(`${open.length} open second-look findings after ${state.rounds} rounds (${result})`);
        Object.assign(state.secondLook, { answering: true, round: state.rounds }); save();
      }
    }
    begin("pr");
    if (!flags.noPr && !state.finished.includes(phase)) {
      if (state.queued) await waitForMerge();
      else {
        assertHead(state.head);
        const result = await execute(kit, ["pr", "--ticket", flags.ticket]);
        state.pr = /#(\d+)/.exec(result.output)?.[1] || state.pr; save();
        const output = requireSuccess(result);
        const merged = /^RESULT: ok merged #(\d+) ([a-f\d]{7,40})$/m.exec(output);
        const queued = /^RESULT: ok queued #(\d+) ([a-f\d]{7,40})$/m.exec(output);
        if (merged) {
          state.pr = merged[1]; state.sha = merged[2]; state.head = git("rev-parse", "HEAD");
          complete(`#${state.pr}`);
        } else if (queued) {
          const head = git("rev-parse", "HEAD");
          if (!head.startsWith(queued[2])) throw new Error("queued PR did not name the current HEAD");
          state.pr = queued[1]; state.queued = { head }; state.head = head;
          save(); await waitForMerge();
        } else throw new Error("PR did not report a merged or queued commit; see phase log");
      }
    } else if (flags.noPr) console.log("slice: pr ok skipped (--no-pr)");
    kitResult("ok", `slice ${flags.ticket} ${flags.noPr ? `reviewed ${findings().length ? "with follow-ups" : "clean"} ${state.head}` : `PR #${state.pr} ${state.sha}`}`);
    return 0;
  } catch (error) {
    if (ended && started) ended(exit || 1);
    console.log(`slice: ${phase} fail`);
    if (log && existsSync(log)) {
      for (const line of readFileSync(log, "utf8").trimEnd().split(/\r?\n/).filter(line => !line.startsWith("RESULT:")).slice(-15)) console.error(`  ${line}`);
    }
    kitResult("fail", `slice ${phase}: ${error.message}`);
    return 1;
  }
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = await slice(process.argv.slice(2));
