to close it once the PR lands.\n';
const kit = process.env.KIT_PR_KIT || resolve(import.meta.dirname, "../kit");
// The kit's own steps kit pr calls in this process (the release check, the review and the second look); tests replace any
// of them with KIT_PR_CALLS, a module exporting releaseCheck, review or secondLook, as KIT_PR_KIT replaces the kit program.
const calls = { releaseCheck: releaseCheckRun, review: reviewRun, secondLook: secondLookRun,
  ...(process.env.KIT_PR_CALLS ? await import(pathToFileURL(resolve(process.env.KIT_PR_CALLS)).href) : {}) };
