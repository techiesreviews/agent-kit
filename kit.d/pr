#!/usr/bin/env node
// kit: open a PR into the land branch, attach the review, merge when checks pass
import { execFileSync, spawn } from "node:child_process";
import { appendFileSync, closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { basename, isAbsolute, join, relative, resolve, sep } from "node:path";
import { pathToFileURL } from "node:url";
import { afterFixRounds, blockingFindings, completedFixRounds, FIX_ROUNDS, openFindings, reviewCoversHead, sameReviewPatch } from "../review-findings.mjs";
import { projectCommand } from "../review-brief.mjs";

const { kitBranch, kitHome, kitRoot, kitMainRoot, kitOwner, kitResult, kitSettings, nodeEnv, kitScore } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const { checkSteps, classify, doneHeading, featureListGuard, featureListProblem, focusedUnitFiles, parseChanges } = await import(pathToFileURL(resolve(import.meta.dirname, "../pr-tier.mjs")).href);
const usage = 'Usage: kit pr [--base <land>] [--title T] [--ticket FILE] [--no-merge] [--dry-run] [--release] [--full] [--waive "<reason>"]\nBranches come from scripts/agents/kit.json: --base defaults to branches.land; --release needs --base branches.release.\n--waive requires a *-lead owner; records the reason for merging with open findings or without a feature-list update.\n';
const kit = process.env.KIT_PR_KIT || resolve(import.meta.dirname, "../kit");

function options(args) {
  const flags = {};
  for (let i = 0; i < args.length; i++) {
    const flag = args[i];
    if (!["--base", "--title", "--ticket", "--no-merge", "--dry-run", "--release", "--full", "--waive"].includes(flag) || Object.hasOwn(flags, flag))
      throw new Error(`unknown or duplicate option: ${flag}`);
    if (["--base", "--title", "--ticket", "--waive"].includes(flag)) {
      const value = args[++i];
      if (!value?.trim() || value.startsWith("-")) throw new Error(`${flag} requires a value`);
      flags[flag] = value;
    } else flags[flag] = true;
  }
  if (flags["--waive"] && !kitOwner().endsWith("-lead")) throw new Error("--waive requires a *-lead owner");
  return { base: flags["--base"], title: flags["--title"], ticket: flags["--ticket"], waive: flags["--waive"],
    noMerge: flags["--no-merge"], dryRun: flags["--dry-run"], release: flags["--release"], full: flags["--full"] };
}

function ticketTitle(file) {
  const text = readFileSync(file, "utf8");
  const front = /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/.exec(text)?.[1];
  const title = /^title:\s*(.+)$/m.exec(front ?? "")?.[1].trim() ?? "";
  return title.replace(/^(["'])(.*)\1$/, "$2");
}

// A clean whole-PR review also survives a rebase that preserves the stable patch ID.
async function savedReview(head, base, patchId, ticket, root) {
  const parent = join(kitMainRoot(), ".scratch/reviews", kitOwner());
  if (!existsSync(parent)) return;
  // Review folder names start with UTC timestamps; numeric sorting handles collision suffixes.
  const folders = readdirSync(parent, { withFileTypes: true }).filter(entry => entry.isDirectory())
    .map(entry => entry.name).sort((a, b) => b.localeCompare(a, "en", { numeric: true }));
  let currentId;
  for (const name of folders) {
    const folder = join(parent, name), refs = join(folder, "refs.txt");
    const result = join(folder, "result.md");
    if (!existsSync(refs) || !existsSync(result)) continue;
    const [reviewedHead, reviewedBase] = readFileSync(refs, "utf8").split(/\r?\n/);
    const resultMd = readFileSync(result, "utf8");
    if (!/^REVIEW_STATUS: complete$/m.test(resultMd)) continue;
    if (reviewedBase === base && reviewCoversHead(reviewedHead, head, ticket, root)) return { folder, samePatch: false };
    if (!reviewedHead || !reviewedBase || openFindings(resultMd).findings.length) continue;
    currentId ??= await patchId(base, head);
    if (sameReviewPatch(await patchId(reviewedBase, reviewedHead), currentId)) return { folder, samePatch: true };
  }
}

const quote = value => `'${String(value).replaceAll("'", "'\\''")}'`;

// Isolate both HEAD and the index: concurrent work must never enter a follow-up commit.
function commitFollowups({ root, branch, head, ticket, content, env }) {
  const run = (args, environment = env) => execFileSync("git", ["-C", root, ...args],
    { cwd: root, env: environment, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
  const file = resolve(root, ticket), path = relative(root, file);
  const assertScope = (expected = head) => {
    if (run(["branch", "--show-current"]) !== branch || run(["rev-parse", "HEAD"]) !== expected)
      throw new Error("worktree branch or HEAD changed during commit; refusing stale work");
    if (readFileSync(file, "utf8") !== content) throw new Error("ticket changed during follow-ups commit");
  };
  assertScope();
  const directory = mkdtempSync(join(tmpdir(), "kit-follow-up-"));
  try {
    const common = run(["rev-parse", "--path-format=absolute", "--git-common-dir"]);
    const gitDir = join(directory, "git"); mkdirSync(gitDir);
    writeFileSync(join(gitDir, "HEAD"), `${head}\n`);
    writeFileSync(join(gitDir, "commondir"), `${common}\n`);
    const indexEnv = { ...env, GIT_INDEX_FILE: join(directory, "index") };
    run(["read-tree", head], indexEnv);
    run(["add", "--", path], indexEnv);
    assertScope();
    const blob = run(["rev-parse", `:${path}`], indexEnv);
    const detachedEnv = { ...indexEnv, GIT_DIR: gitDir, GIT_WORK_TREE: root };
    const message = `docs: ${basename(ticket, ".md")} follow-ups from review`;
    let failure;
    try { run(["commit", "-m", message, "-m", "Co-Authored-By: Agent Kit <noreply@openai.com>"], detachedEnv); }
    catch (error) { failure = error; }
    assertScope();
    if (failure) throw new Error(`git commit failed: ${failure.stderr?.toString().trim() || failure.message}`);
    const next = run(["rev-parse", "HEAD"], detachedEnv);
    const parents = run(["rev-list", "--parents", "-n", "1", next], detachedEnv).split(/\s+/).slice(1);
    if (run(["branch", "--show-current"], detachedEnv) || parents.length !== 1 || parents[0] !== head || next === head)
      throw new Error("follow-ups commit must be one detached commit from the captured HEAD");
    const paths = run(["diff", "--name-only", "--no-renames", "-z", head, next, "--"], detachedEnv).split("\0").filter(Boolean);
    if (paths.length !== 1 || paths[0] !== path || run(["rev-parse", `${next}:${path}`], detachedEnv) !== blob)
      throw new Error("follow-ups commit changed files outside the captured ticket update");
    assertScope();
    run(["update-ref", "--no-deref", "-m", `commit: ${message}`, `refs/heads/${branch}`, next, head], detachedEnv);
    assertScope(next);
    // Refresh only this ticket in the real index; preserve concurrent staging of other files.
    run(["restore", "--staged", "--source", next, "--", path]);
    assertScope(next);
    return next;
  } finally { rmSync(directory, { recursive: true, force: true }); }
}

async function main(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    process.stderr.write(usage);
    kitResult("fail", `invalid arguments: ${error.message}`);
    return 2;
  }
  let step = "guards", directory, land;
  try {
    const root = resolve(kitRoot()), env = nodeEnv();
    directory = join(root, ".scratch/pr", `${new Date().toISOString().replace(/[-:]/g, "")}-${process.pid}`);
    mkdirSync(directory, { recursive: true });
    console.log(`logs: ${directory}`);

    // Keep child RESULT lines in logs, so the command has exactly one final RESULT.
    async function execute(name, command, argv, input) {
      step = name;
      const log = join(directory, `${name}.log`);
      const fd = openSync(log, "a");
      let stdout = "", stderr = "", failure;
      let status;
      try {
        status = await new Promise(accept => {
          const child = spawn(command, argv, { cwd: root, env, stdio: [input === undefined ? "ignore" : "pipe", "pipe", "pipe"] });
          if (child.stdin) {
            child.stdin.on("error", () => { /* An early child exit is handled by its status. */ });
            child.stdin.end(input);
          }
          const interrupt = () => child.kill("SIGINT"), terminate = () => child.kill("SIGTERM");
          process.once("SIGINT", interrupt);
          process.once("SIGTERM", terminate);
          child.stdout.setEncoding("utf8");
          child.stdout.on("data", chunk => { stdout += chunk; appendFileSync(fd, chunk); });
          child.stderr.setEncoding("utf8");
          child.stderr.on("data", chunk => { stderr += chunk; appendFileSync(fd, chunk); });
          child.once("error", error => { failure = error.message; appendFileSync(fd, `${failure}\n`); });
          child.once("close", code => {
            process.removeListener("SIGINT", interrupt);
            process.removeListener("SIGTERM", terminate);
            accept(code ?? 1);
          });
        });
      } finally { closeSync(fd); }
      return { status, stderr, text: stdout, failure };
    }
    async function run(name, command, argv) {
      const result = await execute(name, command, argv);
      if (result.status !== 0) throw new Error(result.failure || result.stderr.trim().split(/\r?\n/).at(-1) || `${command} exited ${result.status}`);
      return result.text.trim();
    }
    const ok = name => console.log(`${name}: ok`);
    const git = (name, argv) => run(name, "git", argv);
    const gh = (name, argv) => run(name, "gh", argv);
    async function patchId(base, head) {
      const diff = await execute("review", "git", ["diff", "--no-ext-diff", "--no-textconv", "--binary", base, head, "--"]);
      if (diff.status !== 0) return ""; // Pruned or invalid reviewed refs require a fresh review.
      const id = await execute("review", "git", ["patch-id", "--stable"], diff.text);
      return id.status === 0 ? id.text.trim().split(/\s+/)[0] : "";
    }
    const branchResult = await execute("guards", "git", ["symbolic-ref", "--short", "HEAD"]);
    if (branchResult.status !== 0) throw new Error("detached HEAD");
    const branch = branchResult.text.trim();
    // Settings problems fail here (exit 1), not as usage errors; --base defaults to the land branch.
    const settings = kitSettings(), release = kitBranch("release", settings);
    flags.base ??= kitBranch("land", settings);
    if ([kitBranch("land", settings), release, flags.base].includes(branch)) throw new Error(`refusing branch ${branch}`);
    // The scoreboard's landing record for this piece.
    // A new PR number starts a fresh landing, so an earlier PR's merge never carries over.
    land = changes => kitScore({ ticket: flags.ticket, branch, root }, record => {
      record.landed = { ...(changes.pr === undefined || record.landed?.pr === changes.pr ? record.landed : {}), ...changes };
    });
    if (flags.release && !release) throw new Error("--release needs branches.release in scripts/agents/kit.json");
    // A project that lands on its release branch (land and release both main) opens ordinary PRs into it.
    if (release && release !== kitBranch("land", settings) && flags.base === release && !flags.release) throw new Error(`--base ${release} requires --release`);
    if (flags.release && flags.base !== release) throw new Error(`--release requires --base ${release}`);
    await git("guards", ["check-ref-format", `refs/heads/${flags.base}`]);
    if (await git("guards", ["status", "--porcelain"])) throw new Error("uncommitted changes");
    // A project with no remote (research 02: astro-live-builder, tidy) has nowhere to open a PR.
    // Only git's "No such remote" (exit 2) means that; other failures surface at the fetch.
    if ((await execute("guards", "git", ["remote", "get-url", "origin"])).status === 2) {
      kitResult("fail", "no GitHub repo (no origin remote); kit pr needs one to open a PR");
      return 1;
    }
    ok("guards");
    // The deps check guards a node_modules shared between worktrees; a project with its own has none to guard.
    if (settings.sharedNodeModules) { await run("deps", kit, ["deps", "check"]); ok("deps"); }
    else console.log("deps: skipped (no sharedNodeModules in scripts/agents/kit.json)");

    async function rebase() {
      await git("fetch", ["fetch", "-q", "origin"]); ok("fetch");
      const result = await execute("rebase", "git", ["rebase", `origin/${flags.base}`]);
      if (result.status !== 0) {
        const files = await git("rebase", ["-c", "core.quotepath=false", "diff", "--name-only", "--diff-filter=U"]);
        const aborted = await execute("rebase", "git", ["rebase", "--abort"]);
        if (files) throw new Error(`conflict in ${files.split(/\r?\n/).join(", ")}${aborted.status ? "; rebase --abort failed" : ""}`);
        throw new Error(result.stderr.trim().split(/\r?\n/).at(-1) || "git rebase failed");
      }
      ok("rebase");
    }
    // Lease every push against what we knew of the PR branch before our own fetch (empty: must not exist),
    // then against our own last push, so a colleague's push to the branch is never overwritten.
    let pushed = (await execute("guards", "git", ["rev-parse", "--verify", "-q", `refs/remotes/origin/${branch}`])).text.trim();
    await rebase();

    // Scale the local checks to the PR's own diff (merge base to HEAD, after the rebase).
    step = "tier";
    const changes = parseChanges(await git("tier", ["-c", "core.quotepath=false", "diff", "--name-status", "--no-renames", `origin/${flags.base}...HEAD`]));
    const plan = classify(changes, { full: flags.full, settings });
    const { steps, review } = checkSteps(plan);
    console.log(`tier: ${plan.tier} (${plan.reason})`);
    if (plan.tier === "css") console.log("reminder: visible CSS changes need kit shots evidence");
    step = "features";
    // Releases carry slices that each passed the guard on their way into dev.
    const features = flags.release ? { ok: true }
      : featureListGuard(changes, { ticketText: flags.ticket ? readFileSync(resolve(root, flags.ticket), "utf8") : "", waive: flags.waive, settings });
    if (features.line) console.log(features.line);
    if (!features.ok) {
      console.error(`problem: ${featureListProblem(settings)}`);
      throw new Error(featureListProblem(settings));
    }
    const tests = [`Tier: ${plan.tier} (${plan.reason})`, ...(features.line ? [features.line] : []), ""];
    const sources = () => Object.fromEntries(readdirSync(join(root, "tests")).filter(name => name.endsWith(".test.ts"))
      .map(name => [`tests/${name}`, readFileSync(join(root, "tests", name), "utf8")]));
    // The project's own check commands (checks in scripts/agents/kit.json): a missing one is skipped with a line.
    const checks = settings.checks ?? {};
    const parse = text => {
      const [name, ...argv] = typeof text === "string" ? text.trim().split(/\s+/) : [];
      return name ? [[name, argv]] : [];
    };
    // Shared helpers come from KIT_HOME; one inside this project keeps its short path in the PR body.
    const shared = name => {
      const path = join(kitHome(), name), local = relative(root, path);
      return local === ".." || local.startsWith(`..${sep}`) || isAbsolute(local) ? path : local;
    };
    const commands = {
      check: () => parse(checks.check), unit: () => parse(checks.test), lint: () => parse(checks.lint),
      "kit-clean": () => (Array.isArray(checks.extra) ? checks.extra : []).flatMap(parse),
      colours: () => [["node", ["scripts/check-colours.mjs"]]], tickets: () => [["node", [shared("tickets.mjs"), "check"]]],
      "unit-files": () => {
        const files = focusedUnitFiles(changes, plan, sources(), settings);
        return files.length ? [[shared("unit.sh"), files]] : [];
      },
    };
    const setting = { check: "checks.check", unit: "checks.test", lint: "checks.lint", "kit-clean": "checks.extra" };
    // Browser specs are a project command (kit specs); a project without one skips the step.
    const hasSpecs = projectCommand("specs", root, settings);
    for (const id of steps) {
      if (id === "specs" && !hasSpecs) {
        const line = `specs: skipped (no specs command in ${settings.commands || "the project's commands folder"})`;
        console.log(line); tests.push(`- ${line}`);
        continue;
      }
      if (id === "specs") {
        const specs = await run("specs", kit, ["specs", "--affected", "--base", `origin/${flags.base}`]); ok("specs");
        tests.push(`- kit specs --affected --base origin/${flags.base}: ${specs.split(/\r?\n/).findLast(line => line.startsWith("RESULT: ")) || "ok"}`);
        continue;
      }
      const name = id === "unit-files" ? "unit" : id, list = commands[id]();
      if (!list.length && id === "unit-files") { console.log("unit: no affected unit tests"); tests.push("- unit: no affected unit tests"); continue; }
      if (!list.length) {
        console.log(`${name}: skipped (no ${setting[id]} in scripts/agents/kit.json)`);
        tests.push(`- ${name}: skipped (no ${setting[id]} in scripts/agents/kit.json)`);
        continue;
      }
      for (const command of list) {
        await run(name, ...command); ok(name);
        tests.push(`- ${[command[0], ...command[1]].join(" ")}: ok`);
      }
    }
    const skipped = Object.entries({ check: checks.check, unit: checks.test && `${checks.test} (all unit tests)`, lint: checks.lint, specs: hasSpecs && "kit specs --affected" })
      .filter(([id, label]) => label && !steps.includes(id)).map(([, label]) => label).concat(review ? [] : ["kit review"]);
    // A repo without GitHub workflows has no CI to fall back on; it is read again after every rebase.
    const ciWorkflows = async () => (await git("ci", ["ls-tree", "--name-only", "HEAD", ".github/workflows/"])).split(/\r?\n/).some(path => /\.ya?ml$/.test(path));
    const backstop = await ciWorkflows() ? "CI still runs check, unit tests, lint and smoke browser tests; no Sol review" : "no CI workflow runs them";
    if (skipped.length) tests.push(`- skipped for the ${plan.tier} tier (${backstop}): ${skipped.join(", ")}`);

    step = "body";
    let head = await git("body", ["rev-parse", "HEAD"]);
    const range = `origin/${flags.base}..HEAD`;
    const subjects = (await git("body", ["log", "--reverse", "--format=%s", range])).split(/\r?\n/).filter(Boolean);
    const title = flags.ticket ? ticketTitle(resolve(root, flags.ticket)) : "";
    const prTitle = flags.title || title || subjects.at(-1);
    if (!prTitle) throw new Error("no title or commits ahead of base");
    const trailers = await git("body", ["log", "--format=%(trailers:key=Co-Authored-By,valueonly)", range]);
    const claude = env.CLAUDECODE === "1" || /^\s*Claude\b/im.test(trailers);
    const body = join(directory, "body.md");
    writeFileSync(body, `${flags.ticket ? `Ticket: ${title || prTitle} (${flags.ticket})\n\n` : ""}## Summary\n\n${subjects.map(subject => `- ${subject}`).join("\n")}\n\n## Tests\n\n${tests.join("\n")}\n${claude ? "\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n" : ""}`);
    ok("body");
    const pushArgs = () => ["push", `--force-with-lease=refs/heads/${branch}:${pushed}`, "origin", `HEAD:refs/heads/${branch}`];
    const createArgs = ["pr", "create", "--base", flags.base, "--head", branch, "--title", prTitle, "--body-file", body];
    const reviewArgs = ["review", "--base", `origin/${flags.base}`, "--pr"];
    if (flags.dryRun) {
      console.log(`branch: ${branch}\nbase: ${flags.base}\nHEAD: ${head}\ntitle: ${prTitle}\nbody: ${body}`);
      for (const command of [["git", ...pushArgs()], ["gh", ...createArgs], ...(review ? [[kit, ...reviewArgs, "N", ...(flags.ticket ? ["--ticket", flags.ticket] : [])]] : [])])
        console.log(command.map(quote).join(" "));
      if (!flags.noMerge && !flags.release) console.log("gh pr merge N --rebase --delete-branch --repo <owner/name> (or --auto --rebase with a merge queue)");
      kitResult("ok", `dry-run ${head.slice(0, 7)} ${branch} -> ${flags.base}`);
      return 0;
    }
    const push = async () => {
      await git("push", pushArgs());
      pushed = head;
      ok("push");
    };
    await push();
    const existing = JSON.parse(await gh("open", ["pr", "list", "--head", branch, "--base", flags.base, "--state", "open", "--json", "number"]));
    let number = existing[0]?.number;
    // `gh pr edit` fails on this repo: it queries the retired Projects (classic) field
    // (repository.pullRequest.projectCards). The REST endpoint updates only the body.
    if (number) await gh("open", ["api", "--method", "PATCH", `repos/{owner}/{repo}/pulls/${number}`, "-F", `body=@${body}`]);
    else {
      const created = await gh("open", createArgs);
      number = /\/pull\/(\d+)/.exec(created)?.[1];
    }
    if (!/^[1-9]\d*$/.test(String(number))) throw new Error("could not determine PR number");
    number = String(number);
    ok("open");
    land({ pr: Number(number), tier: plan.tier });
    step = "review";
    console.log(`PR #${number}; ${review ? "review running" : `review: skipped (${plan.tier} tier)`}`);
    // The docs tier has no model review; CI still gates the merge.
    let waived = 0;
    async function recordFollowups(findings) {
      if (!findings.length) return;
      const reviewedHead = head;
      console.log(`review: ${findings.length} follow-ups after ${FIX_ROUNDS} fix rounds (non-blocking)`);
      const lines = findings.map(item => `- ${item.group} (${item.severity || "gap"}): ${item.text.slice(0, 160)}`);
      const summary = `Follow-ups (non-blocking after ${FIX_ROUNDS} fix rounds):\n${lines.join("\n")}`;
      if (!readFileSync(body, "utf8").includes(summary)) appendFileSync(body, `\n${summary}\n`);
      await gh("follow-ups", ["api", "--method", "PATCH", `repos/{owner}/{repo}/pulls/${number}`, "-F", `body=@${body}`]);
      const comments = JSON.parse(await gh("follow-ups", ["pr", "view", number, "--json", "comments"]));
      if (!comments.comments?.some(comment => comment.body === summary)) {
        const comment = join(directory, "follow-ups.md");
        writeFileSync(comment, summary);
        await gh("follow-ups", ["pr", "comment", number, "--body-file", comment]);
      }
      if (!flags.ticket) return;
      const current = args => execFileSync("git", ["-C", root, ...args],
        { cwd: root, env, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
      // Recheck the captured proof after network awaits, immediately before writing.
      if (current(["branch", "--show-current"]) !== branch || current(["rev-parse", "HEAD"]) !== reviewedHead ||
          current(["status", "--porcelain"])) throw new Error("worktree changed before recording follow-ups");
      const file = resolve(root, flags.ticket), original = readFileSync(file, "utf8");
      const sections = [...original.matchAll(doneHeading())];
      const start = sections.at(-1)?.index;
      const prefix = start === undefined ? `${original.trimEnd()}\n\n## Done (${new Date().toISOString().slice(0, 10)})` : original.slice(0, start);
      const rest = start === undefined ? "" : original.slice(start);
      const end = rest.slice(1).search(/^## /m);
      const doneEnd = end < 0 ? rest.length : end + 1;
      let done = rest.slice(0, doneEnd);
      const followups = /^### Follow-ups\s*\n([\s\S]*?)(?=^#{1,3} |$(?![\s\S]))/m.exec(done);
      const missing = lines.filter(line => !followups?.[1].split(/\r?\n/).includes(line));
      if (missing.length) {
        if (followups) {
          const position = followups.index + followups[0].trimEnd().length;
          done = `${done.slice(0, position)}\n${missing.join("\n")}${done.slice(position)}`;
        } else done = `${done.trimEnd()}\n\n### Follow-ups\n\n${missing.join("\n")}\n\n`;
      }
      const updated = prefix + done + rest.slice(doneEnd);
      if (updated === original) return;
      writeFileSync(file, updated);
      head = commitFollowups({ root, branch, head: reviewedHead, ticket: flags.ticket, content: updated, env });
      await push();
    }
    async function reviewHead() {
      if (!review) return true;
      waived = 0;
      const saved = await savedReview(head, await git("review", ["merge-base", `origin/${flags.base}`, "HEAD"]), patchId, flags.ticket, root);
      let resultPath;
      if (saved) {
        if (saved.samePatch) console.log("review: reused (same patch on new base)");
        resultPath = join(saved.folder, "result.md");
        const comment = join(directory, "review.md");
        writeFileSync(comment, `Reused review: ${saved.folder}\nHEAD: ${head}\n\n${readFileSync(resultPath, "utf8")}`);
        await gh("review", ["pr", "comment", number, "--body-file", comment]);
      } else {
        const output = await run("review", kit, [...reviewArgs, number, ...(flags.ticket ? ["--ticket", flags.ticket] : [])]);
        const evidence = /^RESULT: ok review .+ evidence (.+)$/m.exec(output)?.[1];
        if (!evidence) throw new Error("review did not name its evidence folder");
        resultPath = join(resolve(root, evidence), "result.md");
      }
      let resultMd = "";
      try { resultMd = readFileSync(resultPath, "utf8"); }
      catch { /* Missing or unreadable evidence fails closed through openFindings. */ }
      const { findings } = openFindings(resultMd);
      const relaxed = afterFixRounds(completedFixRounds(join(kitMainRoot(), ".scratch/kit-fix", encodeURIComponent(branch)),
        join(root, ".scratch/kit-fix", encodeURIComponent(branch))));
      const blocking = relaxed ? blockingFindings(findings) : findings;
      if (findings.length) {
        const ordered = [...blocking, ...findings.filter(item => !blocking.includes(item))];
        for (const finding of ordered.slice(0, 15)) console.log(`${finding.group}: ${finding.text.slice(0, 160)}`);
        if (findings.length > 15) console.log(`… and ${findings.length - 15} more`);
        if (blocking.length && !flags.waive) {
          kitResult("fail", `pr #${number} review has ${blocking.length} open findings (${resultPath})`);
          return false;
        }
        waived = blocking.length;
      }
      if (relaxed) await recordFollowups(findings.filter(item => !blocking.includes(item)));
      ok("review");
      return true;
    }
    if (!await reviewHead()) return 1;
    if (flags.noMerge || flags.release) {
      kitResult("ok", `opened #${number} ${head.slice(0, 7)}`);
      return 0;
    }
    // A lead's waiver of the feature-list guard is recorded like waived review findings.
    const featuresWaived = features.line?.startsWith("Feature list: waived");
    const waivedAny = () => waived || featuresWaived ? flags.waive : null;
    async function recordWaiver() {
      if (!waivedAny()) return;
      const reason = flags.waive.replace(/[\r\n]+/g, " ");
      const what = [waived && `with ${waived} waived findings`, featuresWaived && "without a feature-list update"].filter(Boolean).join(" and ");
      appendFileSync(body, `\nmerged ${what}: ${reason}\n`);
      await gh("waiver", ["api", "--method", "PATCH", `repos/{owner}/{repo}/pulls/${number}`, "-F", `body=@${body}`]);
      const comment = join(directory, "waiver.md");
      writeFileSync(comment, `Merged ${what}: ${reason}`);
      await gh("waiver", ["pr", "comment", number, "--body-file", comment]);
    }
    const repo = await gh("merge", ["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]);
    const [owner, name] = repo.split("/");
    if (!owner || !name) throw new Error("could not determine owner/name");
    const queue = await execute("merge", "gh", ["api", "graphql", "-f", "query=query($o:String!,$n:String!,$b:String!){repository(owner:$o,name:$n){mergeQueue(branch:$b){id}}}",
      "-F", `o=${owner}`, "-F", `n=${name}`, "-F", `b=${flags.base}`, "--jq", '.data.repository.mergeQueue.id // ""']);
    if (queue.status === 0 && queue.text.trim()) {
      await gh("merge", ["pr", "merge", number, "--auto", "--rebase", "--match-head-commit", head, "--repo", repo]); ok("merge");
      await recordWaiver();
      land({ queued: true, waived: waivedAny() });
      kitResult("ok", `queued #${number} ${head.slice(0, 7)}`);
      return 0;
    }
    // A repo without GitHub workflows has no checks to wait for: it lands once the review passes.
    // Each attempt reads the rebased HEAD, so workflows the base gained meanwhile are waited for.
    for (let attempt = 1; attempt <= 3; attempt++) {
      if (await ciWorkflows()) {
        console.log(`ci: waiting for PR #${number} checks`);
        await run("ci", kit, ["wait", "ci", "--pr", number]); ok("ci");
        land({ ci: "pass" });
      } else {
        console.log("ci: none (no .github/workflows); landing after review");
        land({ ci: "none" });
      }
      const merged = await execute("merge", "gh", ["pr", "merge", number, "--rebase", "--delete-branch", "--match-head-commit", head, "--repo", repo]);
      if (merged.status === 0) {
        const commit = await execute("merge", "gh", ["pr", "view", number, "--json", "mergeCommit", "--jq", ".mergeCommit.oid"]);
        const sha = commit.status === 0 && /^[a-f0-9]{40}$/i.test(commit.text.trim()) ? commit.text.trim() : head;
        ok("merge");
        await recordWaiver();
        land({ sha, at: new Date().toISOString(), waived: waivedAny() });
        kitResult("ok", `merged #${number} ${sha.slice(0, 7)}`);
        return 0;
      }
      // --match-head-commit refuses a head we did not push and review: stop rather than merge it.
      if (/head branch was modified/i.test(merged.stderr)) throw new Error(`PR head is no longer ${head.slice(0, 7)}; review the new head first`);
      if (!/behind|not up to date|out of date/i.test(merged.stderr))
        throw new Error(merged.failure || merged.stderr.trim().split(/\r?\n/).at(-1) || "gh pr merge failed");
      if (attempt === 3) throw new Error("still behind after 3 attempts");
      const reviewedHead = head;
      await rebase();
      head = await git("rebase", ["rev-parse", "HEAD"]);
      await push();
      if (head !== reviewedHead && !await reviewHead()) return 1;
    }
  } catch (error) {
    if (land && step === "ci") land({ ci: "fail" });
    if (directory && existsSync(join(directory, `${step}.log`))) {
      const lines = readFileSync(join(directory, `${step}.log`), "utf8").trimEnd().split(/\r?\n/).slice(-30);
      for (const line of lines) console.error(`  ${line}`);
    }
    kitResult("fail", `${step}: ${error.message}`);
    return 1;
  }
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = await main(process.argv.slice(2));
