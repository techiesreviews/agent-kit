function options(args) {
  const flags = {}, waives = [];
  for (let i = 0; i < args.length; i++) {
    const flag = args[i];
    // --waive may be given more than once (one reason per finding, say); every other option once.
    if (!["--base", "--title", "--ticket", "--no-merge", "--dry-run", "--release", "--sync-main", "--full", "--waive", "--not-visible"].includes(flag) || (flag !== "--waive" && Object.hasOwn(flags, flag)))
      throw new Error(`unknown or duplicate option: ${flag}`);
    if (["--base", "--title", "--ticket", "--waive", "--not-visible"].includes(flag)) {
      const value = args[++i];
      if (!value?.trim() || value.startsWith("-")) throw new Error(`${flag} requires a value`);
      if (flag === "--waive") waives.push(value);
      else flags[flag] = value;
    } else flags[flag] = true;
  }
  if (waives.length && !kitOwner().endsWith("-lead")) throw new Error("--waive requires a *-lead owner");
  if (flags["--not-visible"] && flags["--release"]) throw new Error("--not-visible has no use with --release: a release carries what each PR already passed");
  if (flags["--sync-main"] && flags["--release"]) throw new Error("--sync-main has no use with --release: a sync lands main into the land branch, a release the other way");
  // `waive` is every reason as one text (the PR, the RESULT line, the release check); `waives` keeps them apart for the waiver check.
  return { base: flags["--base"], title: flags["--title"], ticket: flags["--ticket"], waive: waives.length ? waives.join("; ") : undefined, waives, notVisible: flags["--not-visible"],
    noMerge: flags["--no-merge"], dryRun: flags["--dry-run"], release: flags["--release"], syncMain: flags["--sync-main"], full: flags["--full"] };
}

function ticketTitle(file) {
  const text = readFileSync(file, "utf8");
  const front = /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/.exec(text)?.[1];
  const title = /^title:\s*(.+)$/m.exec(front ?? "")?.[1].trim() ?? "";
  return title.replace(/^(["'])(.*)\1$/, "$2");
}

/** `checks.extra` as a list of commands: a string is a one-item list, anything else but a list of non-blank strings fails. */
function extraChecks(extra) {
  const command = item => typeof item === "string" && item.trim() !== "";
  if (extra === undefined) return [];
  if (command(extra)) return [extra];
  if (Array.isArray(extra) && extra.every(command)) return extra;
  throw new Error("checks.extra must be a list of commands");
}

const quote = value => `'${String(value).replaceAll("'", "'\\''")}'`;
// Short form of a finding for the console, PR body and PR comment; the ticket keeps the full text.
// The cut counts graphemes, so it never splits an emoji, flag or accented letter.
const graphemes = new Intl.Segmenter(undefined, { granularity: "grapheme" });
const findingsWord = count => `${count} open finding${count === 1 ? "" : "s"}`;
const shortText = text => {
  const characters = Array.from(graphemes.segment(text), part => part.segment);
  return characters.length > 160 ? `${characters.slice(0, 160).join("").trimEnd()}…` : text;
};

/** A YAML list or scalar as plain strings: `[main, 'dev']`, `main`, or nothing. */
const yamlList = value => {
  const text = value.trim();
  const items = text.startsWith("[") ? text.replace(/^\[|\]$/g, "").split(",") : text ? [text] : [];
  return items.map(item => item.trim().replace(/^(["'])(.*)\1$/, "$2")).filter(Boolean);
};

/** The top-level `key: value` pairs of a one-line YAML flow mapping (`{ push: { branches: [main] } }`), values as text. */
function flowMapping(text) {
  const entries = {};
  let depth = 0, part = "";
  for (const char of `${text.trim().replace(/^\{|\}$/g, "")},`) {
    if (char === "," && depth === 0) {
      const entry = /^\s*["']?([\w-]+)["']?\s*(?::([\s\S]*))?$/.exec(part);
      if (entry) entries[entry[1]] = (entry[2] ?? "").trim();
      part = "";
      continue;
    }
    if ("[{".includes(char)) depth++;
    if ("]}".includes(char)) depth--;
    part += char;
  }
  return entries;
}

/**
 * Whether a push with these filters (`branches`, `tags`, `paths`, … as lists) can run for a feature branch.
 * Only a `branches` list of plain names (`main`, `release/v1`: no `*`, `?`, `+`, `[` or `!`) rules a PR branch out;
 * `branches-ignore` and `paths` filters may match it. A tag filter with no branch filter runs for tags only,
 * as GitHub skips the branch pushes then.
 */
function pushRunsOnBranches(filters) {
  // An empty `branches: []` names nothing to rule out, so it may run: waiting is the safe answer.
  if (filters.branches) return !filters.branches.length || filters.branches.some(name => /[*?+[!]/.test(name));
  if (filters["branches-ignore"]) return true;
  return !filters.tags && !filters["tags-ignore"];
}

const flowFilters = text => Object.fromEntries(Object.entries(flowMapping(text)).map(([key, value]) => [key, yamlList(value)]));

/**
 * Whether a workflow file runs for a PR branch, read from its top-level `on:` triggers: `pull_request` or
 * `pull_request_target`, or a `push` whose filters can match a feature branch (pushRunsOnBranches). Deploy-only
 * (`push: branches: [main]`), scheduled and manual workflows never report on a PR head, so they are not CI to wait for.
 */
function runsOnPullRequests(text) {
  const lines = text.split(/\r?\n/).map(line => line.replace(/\s+#.*$|^#.*$/, ""));
  const start = lines.findIndex(line => /^["']?on["']?\s*:/.test(line));
  if (start < 0) return false;
  const inline = lines[start].replace(/^["']?on["']?\s*:/, "").trim();
  let block = [];
  if (!inline) {
    for (const line of lines.slice(start + 1)) {
      if (line.trim() && !/^\s/.test(line)) break;
      block.push(line);
    }
  }
  const triggers = inline || block.join("\n");
  if (/\bpull_request(?:_target)?\b/.test(triggers)) return true;
  if (!/\bpush\b/.test(triggers)) return false;
  // A one-line flow mapping (`on: { push: { branches: [main] } }`) carries its filters inline; a list or string none.
  if (inline) {
    if (!inline.startsWith("{")) return true;
    const push = flowMapping(inline).push ?? "";
    return !push.startsWith("{") || pushRunsOnBranches(flowFilters(push));
  }
  const push = block.findIndex(line => /^\s+push\s*:/.test(line));
  if (push < 0) return true; // A list (- push) carries no filter.
  const value = block[push].replace(/^\s+push\s*:/, "").trim();
  if (value.startsWith("{")) return pushRunsOnBranches(flowFilters(value));
  // Block filters: `branches: [main]` on one line, or `branches:` followed by `- main` items.
  const indent = block[push].search(/\S/), filters = {};
  let key;
  for (const line of block.slice(push + 1)) {
    if (!line.trim()) continue;
    if (line.search(/\S/) <= indent) break;
    const item = /^\s*-\s*(.*)$/.exec(line), entry = /^\s*([\w-]+)\s*:(.*)$/.exec(line);
    if (item) { if (key) filters[key].push(...yamlList(item[1])); }
    else if (entry) filters[key = entry[1]] = yamlList(entry[2]);
  }
  return pushRunsOnBranches(filters);
}

// Kit's own ticket-only commits: the follow-ups and the Done "Commits:" line. Whichever of them last wrote that
// line is "this commit" in it; every other commit, kit's own included, is named by subject.
const ownSubjects = ticket => ["follow-ups from review", "commits by subject"].map(what => `docs: ${basename(ticket, ".md")} ${what}`);
const ownTrailer = "Co-Authored-By: Agent Kit <noreply@openai.com>";

/** Where a commit list ends: its first `.` or `;` before a space or the end, outside brackets, quotes and code; -1 for none. */
function listEnd(body) {
  let depth = 0, quote = "";
  for (let i = 0; i < body.length; i++) {
    const char = body[i];
    if (quote) { if (char === quote) quote = ""; continue; }
    if (char === '"' || char === "`") quote = char;
    else if ("([{".includes(char)) depth++;
    else if (")]}".includes(char)) depth = Math.max(0, depth - 1);
    else if (!depth && ".;".includes(char) && (i + 1 === body.length || /\s/.test(body[i + 1]))) return i;
  }
  return -1;
}

/**
 * The ticket with its last Done's "Commits:" list naming these subjects and then "this commit", as rebases and
 * GitHub's rebase merge rewrite every SHA; a Done without the line is unchanged. The list runs from the label
 * (kept as written) over the lines indented under it, sub-items included, to its first sentence end (listEnd);
 * what follows, such as evidence, and every other line stay as they are.
 */
function commitsBySubject(text, subjects) {
  const start = [...text.matchAll(doneHeading())].at(-1)?.index;
  if (start === undefined) return text;
  const rest = text.slice(start), end = rest.slice(1).search(/^## /m), doneEnd = end < 0 ? rest.length : end + 1;
  const done = rest.slice(0, doneEnd);
  const line = /^([ \t]*)((?:[-*+][ \t]+)?(?:\*\*)?Commits\b[^:\r\n]*:(?:\*\*)?)[^\n]*/m.exec(done);
  if (!line) return text;
  let stop = line.index + line[0].length;
  for (let next; (next = /^\n([ \t]*)([^\n]*)/.exec(done.slice(stop))) && next[1].length > line[1].length && next[2].trim();)
    stop += next[0].length;
  const label = line.index + line[1].length + line[2].length, body = done.slice(label, stop), cut = listEnd(body);
  // Without a sentence end the whole span is the list; its line ending stays.
  const after = cut < 0 ? `.${/\s*$/.exec(body)[0]}` : body.slice(cut);
  const names = [...subjects.map(subject => `"${subject}"`), "this commit"];
  const list = names.length > 1 ? `${names.slice(0, -1).join(", ")} and ${names.at(-1)}` : names[0];
  return text.slice(0, start) + done.slice(0, label) + ` ${list}${after}` + done.slice(stop) + rest.slice(doneEnd);
}

// Isolate both HEAD and the index: concurrent work must never enter a follow-up commit. `git(args, env)` runs one git
// call in the worktree with the build's Git settings switched off (main's gitSync).
function commitFollowups({ root, branch, head, ticket, content, env, git, message = ownSubjects(ticket)[0] }) {
  const run = (args, environment = env) => git(args, environment);
  const file = resolve(root, ticket), path = relative(root, file);
  const assertScope = (expected = head) => {
    if (run(["branch", "--show-current"]) !== branch || run(["rev-parse", "HEAD"]) !== expected)
      throw new Error("worktree branch or HEAD changed during commit; refusing stale work");
    if (readFileSync(file, "utf8") !== content) throw new Error("ticket changed during follow-ups commit");
  };
  assertScope();
  const directory = mkdtempSync(join(tmpdir(), "kit-follow-up-"));
  try {
    const common = run(["rev-parse", "--path-format=absolute", "--git-common-dir"]);
    const gitDir = join(directory, "git"); mkdirSync(gitDir);
    writeFileSync(join(gitDir, "HEAD"), `${head}\n`);
    writeFileSync(join(gitDir, "commondir"), `${common}\n`);
    const indexEnv = { ...env, GIT_INDEX_FILE: join(directory, "index") };
    run(["read-tree", head], indexEnv);
    run(["add", "--", path], indexEnv);
    assertScope();
    const blob = run(["rev-parse", `:${path}`], indexEnv);
    const detachedEnv = { ...indexEnv, GIT_DIR: gitDir, GIT_WORK_TREE: root };
    let failure;
    try { run(["commit", "-m", message, "-m", ownTrailer], detachedEnv); }
    catch (error) { failure = error; }
    assertScope();
    if (failure) throw new Error(`git commit failed: ${failure.stderr?.toString().trim() || failure.message}`);
    const next = run(["rev-parse", "HEAD"], detachedEnv);
    const parents = run(["rev-list", "--parents", "-n", "1", next], detachedEnv).split(/\s+/).slice(1);
    if (run(["branch", "--show-current"], detachedEnv) || parents.length !== 1 || parents[0] !== head || next === head)
      throw new Error("follow-ups commit must be one detached commit from the captured HEAD");
    const paths = run(["diff", "--name-only", "--no-renames", "-z", head, next, "--"], detachedEnv).split("\0").filter(Boolean);
    if (paths.length !== 1 || paths[0] !== path || run(["rev-parse", `${next}:${path}`], detachedEnv) !== blob)
      throw new Error("follow-ups commit changed files outside the captured ticket update");
    assertScope();
    run(["update-ref", "--no-deref", "-m", `commit: ${message}`, `refs/heads/${branch}`, next, head], detachedEnv);
    assertScope(next);
    // Refresh only this ticket in the real index; preserve concurrent staging of other files.
    run(["restore", "--staged", "--source", next, "--", path]);
    // restore --staged writes the entry from the tree, with no file details, so git reset --keep (which does not refresh)
    // would call the ticket changed; a refresh fills them in from the file, which matches. It stages nothing.
    run(["update-index", "-q", "--refresh"]);
    assertScope(next);
    return next;
  } finally { rmSync(directory, { recursive: true, force: true }); }
}

async function main(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    process.stderr.write(usage);
    kitResult("fail", `invalid arguments: ${error.message}`);
    return 2;
  }
  let step = "guards", directory, land;
  try {
    // Every gh call is told origin's repo (GH_REPO, GH_HOST); the kit commands that call gh work it out themselves,
    // and the project's own checks run without it.
    // What a build left must not run here with the keys (TOOLS-303). Under the key lock the PATH folders inside the
    // worktree or its Git folder leave PATH before the first git (npm puts <worktree>/node_modules/.bin there), the
    // start-up file a bash child would read first (BASH_ENV, sh's ENV) is dropped, git starts by its full path found
    // outside both, and every git call (gh's and the kit commands' too) gets gitSafety's settings: no hook, no filter,
    // diff tool or other program the repository's Git settings name, no global or system config without the network.
    // The project's checks (check, unit, lint, specs...), the build's own code, run inside the key lock (checkLock).
    // The programs this process and the kit commands it starts find by their bare names (git, node, gh, bash, sh) are
    // found once, past any link a PATH folder elsewhere holds into the worktree or its Git folder, and stand first on
    // PATH through a private folder of links; KIT_NODE is this very Node.
    const guarded = keyGuardOn(process.env);
    const top = gitTop(process.env.KIT_ROOT || process.cwd());
    // The start-up files they name are still locked for the checks (checkLock reads these).
    const startupFiles = { BASH_ENV: process.env.BASH_ENV, ENV: process.env.ENV };
    if (guarded && top) {
      delete process.env.BASH_ENV; delete process.env.ENV;
      const topCommon = gitCommonDir(top) ?? undefined;
      const path = runPath(process.env, { worktree: top, common: topCommon });
      if (path !== undefined) process.env.PATH = path;
      programs = mkdtempSync(join(tmpdir(), "kit-pr-programs-"));
      process.once("exit", () => rmSync(programs, { recursive: true, force: true }));
      linked.node = process.execPath;
      for (const name of ["git", "gh", "bash", "sh"]) {
        const found = runProgram(name, process.env, { worktree: top, common: topCommon, kind: "kit pr" });
        if (found.includes("/")) linked[name] = found;
      }
      for (const [name, target] of Object.entries(linked)) symlinkSync(target, join(programs, name));
      process.env.PATH = `${programs}${process.env.PATH ? `:${process.env.PATH}` : ""}`;
      process.env.KIT_NODE = process.execPath;
    }
    const root = resolve(kitRoot()), common = gitCommonDir(root) ?? undefined;
    // The real git, never the link in the private folder: kit pr starts it by that path, and a git script by its
    // interpreter's full path (gitStart: [program, arguments before git's own]).
    const gitBin = guarded ? linked.git ?? runProgram("git", process.env, { worktree: root, common, kind: "kit pr" }) : "git";
    const gitStart = guarded ? startCommand(gitBin, [], process.env, { worktree: root, common, kind: "kit pr" }).flat() : [gitBin];
    const gitArgs = args => [gitStart[0], [...gitStart.slice(1), ...args]];
    const env = nodeEnv(), ghEnv = kitGhEnv(env, root);
    // The variables one call gets on top of its own: gitSafety's (a git call's network or not, as its arguments say).
    const safety = (environment, network = false) => {
      if (!guarded) return {};
      const { env: safe, problem } = gitSafety({ worktree: root, env: environment, network, git: gitStart, common });
      if (problem) throw new Error(problem);
      return safe;
    };
    // The kit's own helpers in this process (kit-lib, the review and UX gates) run git by its bare name with this
    // process's variables: they get the settings too, read again after every check (the build's code, which may write the
    // Git settings even inside the lock). env above keeps the lead's own, so a fetch or push still reads the global config.
    const gitVariable = /^GIT_CONFIG_(COUNT|GLOBAL|NOSYSTEM|KEY_\d+|VALUE_\d+)$/;
    const ownGitVariables = Object.fromEntries(Object.entries(process.env).filter(([key]) => gitVariable.test(key)));
    // Locked checks see the private folder read-only, but checks that run unlocked (no bubblewrap), another build running
    // meanwhile or one run without the lock may write it: a link that no longer leads where it did stops kit pr,
    // checked before every program it starts and after every check.
    const checkLinks = () => {
      for (const [name, target] of Object.entries(linked)) {
        let now = null;
        try { now = readlinkSync(join(programs, name)); } catch { /* Gone. */ }
        if (now !== target) throw new Error(`kit pr's own link to ${name} (${join(programs, name)}) was changed while it ran; run kit pr again`);
      }
    };
    const shieldProcess = () => {
      if (!guarded) return;
      checkLinks();
      for (const key of Object.keys(process.env)) if (gitVariable.test(key) && !Object.hasOwn(ownGitVariables, key)) delete process.env[key];
      Object.assign(process.env, ownGitVariables, safety(env));
    };
    shieldProcess();
    // `network` reads the config as a fetch or push does (the global and system config too), for a read that must see
    // what such a call will (its push addresses).
    const gitSync = (args, environment = env, network = gitNetworkCall(args)) => execFileSync(...gitArgs(["-C", root, ...args]),
      { cwd: root, env: { ...environment, ...safety(environment, network) }, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
    // A ticket outside the repo, or one git ignores (kit brief writes its briefs into the ignored .scratch folder, often of
    // another checkout), is no file of the repo: kit's notes go into it, and no commit is made for it (TOOLS-337). The words
