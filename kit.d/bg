#!/usr/bin/env node
// kit: start, list or stop detached jobs by name
import { spawn } from "node:child_process";
import { closeSync, existsSync, mkdirSync, openSync, readFileSync, readdirSync, realpathSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { constants } from "node:os";
import { Socket } from "node:net";
import { dirname, join, resolve } from "node:path";
import { setTimeout as delay } from "node:timers/promises";
import { kitJob, kitJobDirectory, kitJobExit, kitJobGroup, kitJobMembers, kitJobProcess, kitJobRecord, kitJobRunning, kitResult } from "../kit-lib.mjs";

const usage = `Usage: kit bg <name> [--cwd DIR] -- <command…>
       kit bg --list
       kit bg --stop <name>
Names: [a-z0-9][a-z0-9._-]*. Records/logs: <worktree>/.scratch/kit-jobs/<name>/.
Jobs use setsid + nohup, their own process group, and stdin /dev/null.
Stop sends SIGTERM to that group, then SIGKILL after a 2s grace period.`;
const args = process.argv.slice(2);
const quote = value => `'${value.replace(/'/g, "'\\''")}'`;

// Do not let a detached child start work until its parent has durably pinned it.
// Pipe EOF without the handoff also cancels a child whose parent died mid-launch.
function gatedSpawn(command, argv, stdio, record) {
  const child = spawn(command, argv, { stdio: [...stdio, "pipe"] });
  const gate = child.stdio[3];
  gate.on("error", () => {});
  child.on("error", () => {});
  try {
    const identity = kitJobProcess(child.pid);
    if (!identity) throw new Error("bg child failed before launch handoff");
    record({ pid: child.pid, started: identity.started });
    gate.end("launch\n");
  } catch (error) { gate.destroy(); child.kill("SIGKILL"); throw error; }
  return child;
}

function childStatus(child) {
  return new Promise((resolve, reject) => {
    child.once("error", reject);
    child.once("exit", (code, signal) => resolve(code ?? 128 + constants.signals[signal]));
  });
}

async function wrapper(kind, directory, cwd, command) {
  const gate = new Socket({ fd: 3, readable: true, writable: false });
  let handoff = "";
  for await (const chunk of gate) handoff += chunk;
  if (handoff !== "launch\n") return;
  if (kind === "--command") {
    // This pinned supervisor survives the session leader. Keep it alive until
    // all descendants in the group finish, even if the command daemonizes.
    const pgid = kitJobProcess(process.pid).pgid;
    const child = spawn(command[0], command.slice(1), { cwd, stdio: "inherit" });
    const status = await childStatus(child);
    while (kitJobGroup(pgid).some(member => member.pid !== pgid && member.pid !== process.pid)) await delay(25);
    process.exitCode = status;
    return;
  }
  let terminated = false;
  process.on("SIGTERM", () => { terminated = true; });
  writeFileSync(join(directory, "identity"), readFileSync(`/proc/${process.pid}/stat`, "utf8"));
  writeFileSync(join(directory, "pgid"), `${process.pid}\n`);
  const started = kitJobProcess(process.pid).started;
  const child = gatedSpawn(process.execPath, [process.argv[1], "--command", directory, cwd, ...command], ["ignore", "inherit", "inherit"], member => {
    writeFileSync(join(directory, "members"), JSON.stringify({ started, members: [member] }));
    writeFileSync(join(directory, "pid.tmp"), `${process.pid}\n`);
    renameSync(join(directory, "pid.tmp"), join(directory, "pid"));
  });
  const status = await childStatus(child);
  writeFileSync(join(directory, "ended"), `${new Date().toISOString()}\n`);
  writeFileSync(join(directory, "exit.tmp"), `${terminated ? 143 : status}\n`);
  renameSync(join(directory, "exit.tmp"), join(directory, "exit"));
}

function parse() {
  if (args[0] === "--list" && args.length === 1) return { kind: "list" };
  if (args[0] === "--stop" && args.length === 2) return { kind: "stop", name: args[1] };
  const name = args[0];
  let index = 1;
  let cwd = process.cwd();
  if (args[index] === "--cwd" && args[index + 1]) { cwd = args[index + 1]; index += 2; }
  if (args[index] !== "--" || !args[index + 1]) throw new Error("expected <name> [--cwd DIR] -- <command…>");
  return { kind: "start", name, cwd: realpathSync(resolve(cwd)), command: args.slice(index + 1) };
}

async function lockJob(path, name) {
  // flock releases on pipe EOF even if the launcher is killed during startup.
  // Keep the lock in a separate process so detached jobs cannot inherit it.
  const child = spawn("flock", ["--nonblock", path, "/bin/sh", "-c", "printf 'locked\\n'; read -r release || :"], { stdio: ["pipe", "pipe", "ignore"] });
  const closed = new Promise(resolve => child.once("close", resolve));
  child.stdin.on("error", () => {});
  await new Promise((resolve, reject) => {
    child.once("error", reject);
    child.stdout.once("data", resolve);
    child.once("close", () => reject(new Error(`bg ${name} is busy; retry after its current operation`)));
  });
  return async () => { child.stdin.end(); await closed; };
}

function list() {
  const root = dirname(kitJobDirectory("unused"));
  const entries = existsSync(root) ? readdirSync(root, { withFileTypes: true }) : [];
  for (const entry of entries.filter(entry => entry.isDirectory() && /^[a-z0-9]/.test(entry.name)).sort((a, b) => a.name.localeCompare(b.name))) {
    const directory = kitJobDirectory(entry.name);
    let state = "died";
    try {
      const job = kitJob(directory);
      const status = kitJobExit(job);
      state = kitJobRunning(job) ? "running" : status !== null ? `exit ${status}` : "died";
    } catch { /* An incomplete record is a died job. */ }
    const started = Date.parse(kitJobRecord(directory, "started"));
    const age = Number.isFinite(started) ? `${Math.max(0, Math.floor((Date.now() - started) / 1000))}s` : "unknown";
    console.log(`${entry.name}\t${state}\t${age}\t${join(directory, "log")}`);
  }
  kitResult("ok", "bg list");
}

async function start(config, directory) {
  if (existsSync(directory)) {
    if (existsSync(join(directory, "pid"))) {
      const job = kitJob(directory);
      if (kitJobRunning(job)) throw new Error(`bg ${config.name} already running (pid ${job.pid})`);
    } else {
      // With the name lock held, a missing pid is an abandoned reservation
      // unless its recorded, gated launcher is still publishing the job.
      const record = kitJobRecord(directory, "launch");
      const launch = record === null ? null : JSON.parse(record);
      if (launch && kitJobProcess(launch.pid)?.started === launch.started)
        throw new Error(`bg ${config.name} already running (pid ${launch.pid}, starting)`);
    }
    rmSync(directory, { recursive: true });
  }
  mkdirSync(directory);
  writeFileSync(join(directory, "command"), `${config.command.map(quote).join(" ")}\n`);
  writeFileSync(join(directory, "cwd"), `${config.cwd}\n`);
  writeFileSync(join(directory, "started"), `${new Date().toISOString()}\n`);
  const log = join(directory, "log");
  const fd = openSync(log, "w");
  let child;
  try {
    child = gatedSpawn("setsid", ["nohup", process.execPath, process.argv[1], "--wrapper", directory, config.cwd, ...config.command], ["ignore", fd, fd], launch => {
      writeFileSync(join(directory, "launch.tmp"), JSON.stringify(launch));
      renameSync(join(directory, "launch.tmp"), join(directory, "launch"));
    });
  } finally { closeSync(fd); }
  let failure;
  child.on("error", error => { failure = error; });
  child.unref();
  const deadline = Date.now() + 5000;
  while (!existsSync(join(directory, "pid"))) {
    if (failure) throw failure;
    if (child.exitCode !== null || child.signalCode !== null || Date.now() >= deadline)
      throw new Error(`bg ${config.name} wrapper failed to start; see ${log}`);
    await delay(10);
  }
  const job = kitJob(directory);
  console.log(`name: ${config.name}\npid: ${job.pid}\nlog: ${log}`);
  kitResult("ok", `bg ${config.name} pid ${job.pid}`);
}

async function stop(name, directory) {
  const job = kitJob(directory);
  if (!kitJobRunning(job)) {
    console.log(`${name}: not running (pid ${job.pid})`);
    kitResult("ok", `bg stop ${name} not running`);
    return;
  }
  // Pin existing group members too: a command may leave a descendant ignoring
  // TERM after the wrapper exits. Never escalate against a reused process group.
  const members = kitJobMembers(job);
  const alive = () => members.some(({ pid, started }) => {
    const current = kitJobProcess(pid);
    return current?.pgid === job.pgid && current.session === job.pgid && current.started === started;
  });
  const signal = value => {
    if (!alive()) return false;
    try { process.kill(-job.pgid, value); return true; }
    catch (error) { if (error.code === "ESRCH") return false; throw error; }
  };
  signal("SIGTERM");
  const deadline = Date.now() + 2000;
  while (alive() && Date.now() < deadline) await delay(25);
  const escalated = signal("SIGKILL");
  console.log(`${name}: stopped pid ${job.pid}, process group ${job.pgid} (${escalated ? "SIGTERM, SIGKILL" : "SIGTERM"})`);
  kitResult("ok", `bg stop ${name} pgid ${job.pgid}`);
}

if (args[0] === "--wrapper" || args[0] === "--command") {
  try { await wrapper(args[0], args[1], args[2], args.slice(3)); }
  catch (error) { console.error(error.message); process.exitCode = 1; }
} else if (args[0] === "--help" || args[0] === "-h") console.log(usage);
else {
  let unlock;
  try {
    const config = parse();
    if (config.kind === "list") list();
    else {
      const directory = kitJobDirectory(config.name);
      mkdirSync(dirname(directory), { recursive: true });
      const path = join(dirname(directory), `.${config.name}.lock`);
      unlock = await lockJob(path, config.name);
      if (config.kind === "start") await start(config, directory);
      else await stop(config.name, directory);
    }
  } catch (error) {
    console.error(error.message);
    kitResult("fail", error.message);
    process.exitCode = 1;
  } finally { if (unlock) await unlock(); }
}
