#!/usr/bin/env node
// kit: try the features a diff touches, run scripted UX checks and pack a small review bundle
import { execFileSync, spawn } from "node:child_process";
import { closeSync, copyFileSync, existsSync, mkdirSync, openSync, readFileSync, writeFileSync } from "node:fs";
import { basename, dirname, join, matchesGlob, normalize, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { checkColours } from "../../check-colours.mjs";

const { kitRoot, kitMainRoot, kitOwner, kitResult } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);

export const bundleLimit = 60_000, imageLimit = 12, imageBytes = 300_000;
const usage = `Usage: kit ux [--base REF] [--features F-…,…] [--all] [--no-review] [--ticket FILE]
       kit ux --help
Touched features: the diff against the merge-base with --base (default origin/dev), plus
uncommitted and untracked files, matched against each feature's Files globs in
docs/agents/features.md. --features names them instead; --all takes every feature.
Tries: each feature's Steps file through kit shots --steps at 1280 px (and 390 px when
Phone: yes), light and dark. A feature without Steps gets the named screens its Files map
to, marked untried.
Scripted checks: layout findings, tap targets under 44 px at 390, raw colours in changed
CSS, new visible text over 60 characters, new hint/tip/count/badge class names, and raw px
spacing and timings in changed CSS counted against the base (reported, never blocking).
Bundle: <main root>/.scratch/ux/<owner>/<time>/bundle.md (under 60 KB) and at most 12
images of at most 300 KB (contact sheets and record strips); the lowest-value items are
trimmed first and named. Raw tries: <main root>/.scratch/ux-tries/<owner>/<time>/.
The ticket (for its mock-up link) is --ticket, else the ticket the branch name ends with.
The model review is not part of this command yet; --no-review is accepted and changes nothing.
KIT_UX_SHOTS: executable replacing kit shots, called with the same arguments (tests).
A failed try fails: RESULT: fail ux … broken: <feature,…>.
`;

