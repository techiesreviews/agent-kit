  "editor": ["src/components/publish-menu.*", "src/components/agent-menu.*", "src/components/repository-menu.ts", "src/components/site-actions.ts", "src/components/canvas-bar.ts"],
  "media-gallery": ["src/page-builder/media-library-view.ts", "src/page-builder/media-library-grid.ts", "src/page-builder/media-library-filter.ts", "src/page-builder/media-library-input.ts", "src/page-builder/media-picker.css"],
  "media-select": ["src/page-builder/media-library-shell.ts", "src/page-builder/media-collection-choices.ts"],
  "file-details": ["src/page-builder/media-library-details.ts", "src/page-builder/media-file-details.ts", "src/page-builder/media-detail.css", "src/page-builder/media-descriptions.ts", "src/page-builder/media-metadata.ts"],
  "image-popup": ["src/page-builder/image-popup*.ts", "src/page-builder/shape-menu.ts"],
  "picker": ["src/page-builder/media-picker.ts", "src/page-builder/media-place.ts", "src/page-builder/media-picker-close.ts"],
  "files": ["src/controllers/files-tree-controller.ts", "src/components/files-tree.css", "src/components/file-type-icons.ts", "src/components/file-row-actions.ts"],
  "pages": ["src/components/pages-tree.ts", "src/components/pages-tree.css", "src/controllers/pages-controller.ts", "src/controllers/pages-state.ts"],
  "site-settings": ["src/components/site-settings.ts", "src/page-builder/site-identity.ts", "src/page-builder/site-address-rewrite.ts"],
  "cleanup": ["src/page-builder/media-library-clean-up.ts", "src/page-builder/media-clean-up*.ts"],
