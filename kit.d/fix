#!/usr/bin/env node
// kit: send open review findings back to the original builder
import { execFileSync, spawn } from "node:child_process";
import { closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readFileSync, readdirSync, realpathSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { openFindings } from "../review-findings.mjs";

const { kitRoot, kitMainRoot, kitOwner, kitResult, nodeEnv, commitBuilderWork, builderAuthor } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit fix [--review DIR | --note FILE] [--run DIR] [--ticket FILE] [--builder MODEL] [--effort E]\nResume the builder with open findings or a failure note, commit its fixes, and review again.\nWith --builder (and --effort when given), resume only a saved session of that model and effort, else start fresh with them (without either: latest slice model and effort, else gpt-6.1-sol and high).\nAn explicit --run DIR that is missing, unreadable or belongs to another worktree errors; one that belongs to another model is ignored with a line and a fresh builder starts.\nA pending builder round from another model or effort switches to the requested one and keeps its edits; a pending commit or review round still refuses.\nFailed rounds resume their saved builder/commit/review phase without discarding edits.\n";
const kit = resolve(import.meta.dirname, "../kit");
const agent = resolve(import.meta.dirname, "../agent.sh");
const modelName = value => value === "sol" ? "gpt-6.1-sol" : value;

function options(args) {
  const flags = {};
  for (let i = 0; i < args.length; i += 2) {
    const flag = args[i], value = args[i + 1];
    if (!["--review", "--note", "--run", "--ticket", "--builder", "--effort"].includes(flag) || !value?.trim() || value.startsWith("-") || Object.hasOwn(flags, flag)) {
      throw new Error(`invalid option: ${flag}`);
    }
    flags[flag] = value;
  }
  if (flags["--review"] && flags["--note"]) throw new Error("--review and --note are mutually exclusive");
  return flags;
}

function newestDirectories(parent) {
  if (!existsSync(parent)) return [];
  return readdirSync(parent, { withFileTypes: true }).filter(entry => entry.isDirectory())
    .map(entry => entry.name).sort((a, b) => b.localeCompare(a, "en", { numeric: true }))
    .map(name => join(parent, name));
}

function coveringReview(head) {
  for (const folder of newestDirectories(join(kitMainRoot(), ".scratch/reviews", kitOwner()))) {
    try {
      if (readFileSync(join(folder, "refs.txt"), "utf8").split(/\r?\n/)[0] === head) return folder;
    } catch { /* A partial folder without refs cannot cover HEAD. */ }
  }
}

function latestSlice(root, branch) {
  const states = [];
  for (const folder of newestDirectories(join(root, ".scratch/kit-slice"))) {
    try {
      const path = join(folder, "state.json"), state = JSON.parse(readFileSync(path, "utf8"));
      if (state.branch === branch && typeof state.model === "string" && state.model.trim() &&
          typeof state.ticket === "string" && existsSync(resolve(root, state.ticket))) {
        states.push({ state, modified: statSync(path).mtimeMs });
      }
    } catch { /* Ignore incomplete or foreign slice states. */ }
  }
  return states.sort((a, b) => b.modified - a.modified)[0]?.state;
}

function builderRun(root, explicit, slice, model, effort) {
  const implicit = newestDirectories(join(root, ".scratch/agent")).filter(folder => folder.split("/").at(-1).startsWith("build-"));
  if (slice?.build) implicit.unshift(resolve(root, slice.build));
  const label = (status, wantedEffort) => wantedEffort && status.effort !== wantedEffort
    ? `${status.model} (${status.effort})` : status.model;
  const builders = [];
  for (const folder of explicit ? [resolve(root, explicit)] : implicit) {
    let status;
    try {
      status = JSON.parse(readFileSync(join(folder, "status.json"), "utf8"));
      if (status.kind !== "build" || !status.session || realpathSync(status.worktree) !== realpathSync(root)) throw new Error("foreign");
    } catch {
      if (explicit) throw new Error("invalid builder run for this worktree");
      continue; // Ignore incomplete or foreign builder records.
    }
    if ((model && status.model !== model) || (effort && status.effort !== effort)) {
      if (explicit) {
        const wanted = effort && effort !== "high" ? `${model || status.model} (${effort})` : model || status.model;
        console.log(`--run ${explicit} is ${label(status, effort)}; starting fresh with ${wanted}`);
      }
      continue;
    }
    builders.push({ folder, status });
  }
  // A slice's original builder must not hide a newer fallback or manual builder.
  if (builders.length) return builders.sort((a, b) => (Date.parse(b.status.started) || 0) - (Date.parse(a.status.started) || 0))[0];
}

function declinedFindings(report) {
  const lines = report.split(/\r?\n/), declined = [];
  let collecting = false;
  for (const line of lines) {
    const heading = /^\s*(?:#{1,6}\s*)?(?:\*\*)?Declined:(?:\*\*)?\s*(.*)$/i.exec(line);
    if (heading) {
      collecting = true;
      if (heading[1].trim() && !/^none\b/i.test(heading[1])) declined.push(heading[1].trim());
      continue;
    }
    if (!collecting) continue;
    if (/^\s*(?:#{1,6}\s+|(?:\*\*)?[A-Z][\w ]+:)/.test(line)) break;
    const text = line.replace(/^\s*(?:[-+*]|\d+[.)])\s+/, "").trim();
    if (text && !/^none\b/i.test(text)) declined.push(text);
  }
  return declined;
}

async function fix(args) {
  let flags;
  try { flags = options(args); }
  catch (error) { process.stderr.write(usage); kitResult("fail", `fix ${error.message}`); return 2; }
  try {
    const root = resolve(kitRoot()), env = nodeEnv();
    const git = (...argv) => execFileSync("git", ["-C", root, ...argv], { env, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
    const branch = git("symbolic-ref", "--short", "HEAD");
    const directory = join(root, ".scratch/kit-fix", encodeURIComponent(branch));
    const pendingPath = join(directory, "pending.json");
    let pending = existsSync(pendingPath) ? JSON.parse(readFileSync(pendingPath, "utf8")) : null;
    const requested = flags["--builder"] ? modelName(flags["--builder"]) : undefined;
    const requestedEffort = flags["--effort"];
    const modelChanged = Boolean(pending && requested && requested !== pending.model);
    // Rounds saved before effort was recorded ran at the high default.
    const pendingEffort = pending?.effort || "high";
    const effortChanged = Boolean(pending && requestedEffort && requestedEffort !== pendingEffort);
    // A round that never reached the builder can switch model or effort and keep its edits.
    const retarget = Boolean(pending && pending.phase === "builder" && (modelChanged || effortChanged));
    // A fresh or re-targeted round still answers to the --run its runner first passed.
    const requestedRun = flags["--run"] && resolve(root, flags["--run"]);
    if (pending && (pending.root !== root || pending.branch !== branch ||
        (flags["--review"] && resolve(root, flags["--review"]) !== pending.review) ||
        (requestedRun && requestedRun !== pending.run && requestedRun !== pending.requestedRun) ||
        (flags["--note"] && resolve(root, flags["--note"]) !== pending.note) ||
        ((modelChanged || effortChanged) && !retarget) ||
        (flags["--ticket"] && resolve(root, flags["--ticket"]) !== resolve(root, pending.ticket))))
      throw new Error("pending fix belongs to a different worktree, branch, review, builder, effort or ticket");
    const head = pending?.head || git("rev-parse", "HEAD");
    const note = pending?.note || (flags["--note"] ? resolve(root, flags["--note"]) : undefined);
    const review = pending?.review || (!note && (flags["--review"] ? resolve(root, flags["--review"]) : coveringReview(head)));
    if (!review && !note) throw new Error("no review covers HEAD");
    const resultPath = note || join(review, "result.md");
    let original = pending?.original || "";
    if (!pending) {
      if (note) {
        original = readFileSync(note, "utf8");
        if (!original.trim()) throw new Error("failure note is empty");
      } else try { original = readFileSync(resultPath, "utf8"); } catch { /* Fail closed below. */ }
    }
    const { findings, readable } = note ? { findings: [], readable: true } : openFindings(original);
    if (!readable) throw new Error(`${findings.length} open findings (${resultPath}): review format unreadable`);
    if (!note && !findings.length) { kitResult("ok", "fix clean"); return 0; }
    const slice = latestSlice(root, branch);
    const builder = pending ? undefined : builderRun(root, flags["--run"], slice, requested, requestedEffort);
    let ticket = pending?.ticket || flags["--ticket"];
    if (!ticket && builder) {
      const brief = readFileSync(resolve(root, builder.status.brief), "utf8");
      ticket = [...brief.matchAll(/(?:`|\s|^)(docs\/[^\s`]+\.md)/g)].map(match => match[1])
        .find(path => existsSync(resolve(root, path)) && /(?:^|\/)tickets\//.test(path));
    }
    ticket ||= slice?.ticket;
    if (!ticket) throw new Error("no ticket found in builder brief; pass --ticket FILE");
    readFileSync(resolve(root, ticket));
    // A branch owns its rounds even if the worktree later switches branches.
    const assertScope = (expectedHead = head) => {
      if (git("symbolic-ref", "--quiet", "HEAD") !== `refs/heads/${branch}` || git("rev-parse", "HEAD") !== expectedHead) {
        throw new Error("worktree branch or HEAD changed during fix; refusing stale work");
      }
    };
    assertScope(pending?.phase === "review" ? pending.reviewHead : head);
    if (!pending && git("status", "--porcelain", "--untracked-files=normal")) throw new Error("uncommitted changes before builder resume");
    mkdirSync(directory, { recursive: true });
    const rounds = readdirSync(directory).map(name => /^round-(\d+)\.md$/.exec(name)).filter(Boolean).map(match => Number(match[1]));
    const round = pending?.round || Math.max(0, ...rounds) + 1;
    const brief = join(directory, `round-${round}.md`);
    if (!pending) writeFileSync(brief, `Ticket: ${ticket}\n\nUse Agent Kit at scripts/agents/kit: run doctor first, focused unit --affected, npm run lint and touched specs. Report RESULT lines.\nFix real defects within the ticket's Files. For a finding you reject, list it under\n\`Declined:\` with a one-line reason.\n\n${note ? `Failure note (verbatim):\n${original}` : `Open findings:\n${findings.map(item => `- ${item.group}: ${item.text}`).join("\n")}\n\nReview evidence (verbatim; Optional nits are not open findings):\n${original}`}`, { flag: "wx" });

    const save = () => {
      writeFileSync(`${pendingPath}.tmp`, JSON.stringify(pending, null, 2) + "\n");
      renameSync(`${pendingPath}.tmp`, pendingPath);
    };
    if (retarget) {
      const label = (model, effort) => effort && effort !== "high" ? `${model} (${effort})` : model;
      if (modelChanged)
        pending.previousModels = [...(Array.isArray(pending.previousModels) ? pending.previousModels : []), pending.model];
      if (effortChanged)
        pending.previousEfforts = [...(Array.isArray(pending.previousEfforts) ? pending.previousEfforts : []), pendingEffort];
      console.log(`builder switched: ${label(pending.model, pendingEffort)} -> ${label(requested || pending.model, requestedEffort || pendingEffort)}`);
      const artifacts = join(root, ".scratch/agent");
      mkdirSync(artifacts, { recursive: true });
      pending.model = requested || pending.model;
      pending.effort = requestedEffort || pendingEffort;
      pending.requestedRun ||= requestedRun || pending.run;
      pending.run = mkdtempSync(join(artifacts, `build-${Date.now()}-${process.pid}-`));
      pending.fresh = true;
      save();
    }
    if (!pending) {
      const model = requested || builder?.status.model || slice?.model || "gpt-6.1-sol";
      const effort = requestedEffort || builder?.status.effort || slice?.effort || "high";
      let run = builder?.folder;
      if (!run) {
        const artifacts = join(root, ".scratch/agent");
        mkdirSync(artifacts, { recursive: true });
        run = mkdtempSync(join(artifacts, `build-${Date.now()}-${process.pid}-`));
      }
      pending = { root, branch, head, review, note, run, requestedRun, ticket, round,
        original, model: modelName(model), effort, fresh: !builder, phase: "builder", declined: [], reviewHead: head };
      save();
    }

    // Keep child reports and RESULT lines in logs; this command emits one RESULT.
    async function execute(name, command, argv, overrides = {}) {
      const log = join(directory, `round-${round}-${name}.log`);
      const previous = existsSync(log) ? readFileSync(log, "utf8").length : 0;
      const fd = openSync(log, "a");
      let code;
      try {
        code = await new Promise((accept, reject) => {
          const child = spawn(command, argv, { cwd: root, env: { ...env, ...overrides }, stdio: ["ignore", fd, fd] });
          const interrupt = () => child.kill("SIGINT"), terminate = () => child.kill("SIGTERM");
          process.once("SIGINT", interrupt); process.once("SIGTERM", terminate);
          const clear = () => { process.removeListener("SIGINT", interrupt); process.removeListener("SIGTERM", terminate); };
          child.once("error", error => { clear(); reject(error); });
          child.once("close", status => { clear(); accept(status ?? 1); });
        });
      } finally { closeSync(fd); }
      if (code !== 0) throw new Error(`${name} failed (${code}); see ${log}`);
      return readFileSync(log, "utf8").slice(previous);
    }

    if (pending.phase === "builder") {
      assertScope();
      const reportPath = join(pending.run, "out.md");
      let resume = !pending.fresh;
      if (pending.fresh) {
        try { resume = Boolean(JSON.parse(readFileSync(join(pending.run, "status.json"), "utf8")).session); }
        catch { /* A fresh round has no session until agent.sh records one. */ }
      }
      const previousReport = resume && existsSync(reportPath) ? readFileSync(reportPath, "utf8") : "";
      if (!resume) console.log(`builder: no resumable builder run; starting fresh agent.sh build (${pending.model})`);
      await execute("builder", agent, resume ? ["--resume", pending.run, "--brief", brief] :
        ["build", root, brief, "--model", pending.model, "--effort", pending.effort || "high", "--out", pending.run]);
      assertScope();
      const report = readFileSync(reportPath, "utf8");
      if (!report.startsWith(previousReport)) throw new Error("builder replaced its saved report");
      const declined = declinedFindings(report.slice(previousReport.length));
      if (!git("status", "--porcelain", "--untracked-files=normal") && !declined.length)
        throw new Error("builder made no changes");
      pending.declined = declined; pending.phase = "commit"; save();
    }
    if (pending.phase === "commit") {
      assertScope();
      if (git("status", "--porcelain", "--untracked-files=normal")) {
        pending.reviewHead = commitBuilderWork({ root, branch, head, message: `Review fixes round ${round}`,
          author: builderAuthor(pending.model), env });
      } else if (!pending.declined.length) throw new Error("pending fix changes are missing; refusing to discard the round");
      pending.phase = "review"; save();
    }
    const reviewHead = pending.reviewHead, declined = pending.declined;
    assertScope(reviewHead);
    const output = await execute("review", kit, ["review", "--ticket", ticket], { ASE_REVIEW_DECLINED: JSON.stringify(declined) });
    assertScope(reviewHead);
    const evidence = /^RESULT: ok review .+ evidence (.+)$/m.exec(output)?.[1];
    if (!evidence) throw new Error("review did not name its evidence folder");
    const reviewed = resolve(root, evidence), nextResult = join(reviewed, "result.md");
    if (readFileSync(join(reviewed, "refs.txt"), "utf8").split(/\r?\n/)[0] !== reviewHead) {
      throw new Error("new review does not cover HEAD");
    }
    let result = "";
    try { result = readFileSync(nextResult, "utf8"); } catch { /* Missing evidence is an open finding. */ }
    const remaining = openFindings(result).findings.length;
    rmSync(pendingPath);
    kitResult(remaining ? "fail" : "ok", remaining ? `fix ${remaining} open findings (${nextResult})` : "fix clean");
    return remaining ? 1 : 0;
  } catch (error) { kitResult("fail", `fix ${error.message}`); return 1; }
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = await fix(process.argv.slice(2));
