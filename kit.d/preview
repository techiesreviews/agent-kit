#!/usr/bin/env node
// kit: deploy origin/dev from a cached detached worktree and verify the live bundle
import { spawn } from "node:child_process";
import { closeSync, lstatSync, mkdirSync, openSync, readFileSync, readdirSync, realpathSync, rmSync, statSync, symlinkSync } from "node:fs";
import { constants } from "node:os";
import { join, resolve } from "node:path";
import { setTimeout as delay } from "node:timers/promises";
import { pathToFileURL } from "node:url";

const { kitMainRoot, kitJobGroup, kitResult, nodeEnv } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit preview [--dry-run] [--help]\nDeploy origin/dev from a detached worktree; --dry-run only prepares the worktree.\nASE_PREVIEW_TIMEOUT: positive integer seconds or s/m/h (at most 2147483 seconds).\nDefaults: git 2m, deploy 10m, verification 2m; expiry kills the step's process group.\n";

let previewTimeout;
function duration(value) {
  const match = /^([1-9][0-9]*)([smh]?)$/.exec(value);
  const ms = match ? Number(match[1]) * ({ "": 1, s: 1, m: 60, h: 3600 }[match[2]]) * 1000 : NaN;
  if (!Number.isSafeInteger(ms) || ms > 2_147_483_647) throw new Error("invalid ASE_PREVIEW_TIMEOUT: expected positive integer seconds or s/m/h, at most 2147483 seconds");
  return ms;
}

class StepTimeout extends Error {}

// Children run in their own process group; a signal is forwarded to it and the lock
// is held until the group's leader exits, so a cancelled deploy never races the next one.
let current, interrupted;
const stop = new AbortController();
function onSignal(signal) {
  interrupted ??= signal;
  stop.abort();
  if (current) { try { process.kill(-current.pid, signal); } catch { /* Already gone. */ } }
}
for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, onSignal);
function checkInterrupted() {
  if (interrupted) throw new Error(`interrupted by ${interrupted}`);
}

async function run(command, args, { cwd, env = process.env, fd, lock, step = command, timeout = "2m" } = {}) {
  checkInterrupted();
  const limit = previewTimeout ?? timeout;
  const ms = duration(limit);
  const child = spawn(command, args, { cwd, env, detached: true, stdio: ["ignore", fd ?? "pipe", fd ?? "pipe", ...(lock === undefined ? [] : [lock])] });
  current = child;
  let termination, expired;
  const timer = setTimeout(() => {
    expired = new StepTimeout(`${step} timed out after ${limit} (killed pgid ${child.pid})`);
    const signal = name => {
      try { process.kill(-child.pid, name); }
      catch (error) { if (error.code !== "ESRCH") throw error; }
    };
    // A leader can exit on SIGTERM while a descendant ignores it and still owns
    // the lock or log fd. Complete the grace and kill the group even after close.
    termination = (async () => {
      signal("SIGTERM");
      await delay(500);
      signal("SIGKILL");
      while (kitJobGroup(child.pid).length) await delay(10);
    })();
    termination.catch(() => {}); // Observed below, after the leader has been reaped.
  }, ms);
  let result;
  try {
    result = await new Promise((accept, reject) => {
      let stdout = "", stderr = "";
      child.stdout?.setEncoding("utf8").on("data", chunk => { stdout += chunk; });
      child.stderr?.setEncoding("utf8").on("data", chunk => { stderr += chunk; });
      child.once("error", reject);
      child.once("close", code => { accept({ status: code ?? 1, stdout: stdout.trimEnd(), stderr: stderr.trimEnd() }); });
    });
  } finally {
    clearTimeout(timer);
    try { await termination; } finally { current = undefined; }
  }
  if (expired) throw expired;
  checkInterrupted();
  return result;
}

async function git(root, args, required = true) {
  const result = await run("git", ["-C", root, ...args], { step: `git ${args[0]}` });
  if (required && result.status) throw new Error(`git ${args[0]} failed: ${result.stderr || result.status}`);
  return result;
}

async function worktree(root, main, sha) {
  const dir = join(main, ".scratch/preview-deploy");
  mkdirSync(join(main, ".scratch"), { recursive: true });
  let reused = false;
  try {
    // A plain folder inside the checkout otherwise reports the enclosing repo's HEAD.
    const head = await git(dir, ["rev-parse", "--show-toplevel", "HEAD"], false);
    const [top, commit] = head.stdout.split("\n");
    reused = head.status === 0 && top === realpathSync(dir) && /^[a-f0-9]{40}$/.test(commit)
      && lstatSync(join(dir, "node_modules")).isSymbolicLink() && statSync(join(dir, "node_modules")).isDirectory();
  } catch (error) { if (error.code !== "ENOENT") throw error; }
  if (reused) {
    await git(dir, ["checkout", "-q", "-f", "--detach", sha]);
    await git(dir, ["clean", "-fdq"]);
  } else {
    let modules;
    try {
      modules = realpathSync(join(root, "node_modules"));
      if (!statSync(modules).isDirectory()) throw new Error("not a directory");
    } catch { throw new Error(`missing node_modules: ${join(root, "node_modules")}`); }
    await git(root, ["worktree", "remove", "--force", dir], false);
    rmSync(dir, { recursive: true, force: true });
    await git(root, ["worktree", "prune"]);
    await git(root, ["worktree", "add", "--detach", dir, sha]);
    symlinkSync(modules, join(dir, "node_modules"));
  }
  if ((await git(dir, ["rev-parse", "HEAD"])).stdout !== sha) throw new Error("worktree HEAD differs from origin/dev");
  const state = reused ? "reused" : "created";
  console.log(`worktree: ${dir} (${state}) at ${sha.slice(0, 7)}`);
  return { dir, state };
}

function bundle(html) {
  return /(?:^|[\/"'])assets\/(index-[^\/"'?#\s<>]+\.js)(?=[?#"'\s<>]|$)/.exec(html)?.[1];
}

function builtBundle(dir) {
  try {
    const name = bundle(readFileSync(join(dir, "dist/index.html"), "utf8"));
    if (name && statSync(join(dir, "dist/assets", name)).isFile()) return name;
  } catch (error) { if (error.code !== "ENOENT") throw error; }
  let names = [];
  try { names = readdirSync(join(dir, "dist/assets")).filter(name => /^index-.+\.js$/.test(name) && statSync(join(dir, "dist/assets", name)).isFile()); }
  catch (error) { if (error.code !== "ENOENT") throw error; }
  if (names.length === 1) return names[0];
  throw new Error("built bundle not found");
}

function milliseconds(name, fallback) {
  const value = Number(process.env[name] ?? fallback);
  if (!Number.isSafeInteger(value) || value <= 0) throw new Error(`invalid ${name}`);
  return value;
}

async function verify(built) {
  const limit = duration(previewTimeout ?? "2m");
  const deadline = Date.now() + Math.min(milliseconds("KIT_PREVIEW_VERIFY_MS", limit), limit);
  const interval = milliseconds("KIT_PREVIEW_INTERVAL_MS", 5_000);
  const url = new URL(process.env.KIT_PREVIEW_URL || "https://preview-editor.techies.tools");
  let live = "unreachable";
  while (Date.now() < deadline) {
    checkInterrupted();
    url.searchParams.set("v", String(Date.now()));
    try {
      const response = await fetch(url, { cache: "no-store", signal: AbortSignal.any([stop.signal, AbortSignal.timeout(Math.min(15_000, Math.max(1, deadline - Date.now())))]) });
      const html = await response.text();
      live = response.ok ? bundle(html) || "unreachable" : "unreachable";
    } catch (error) {
      // A poll cut short by the verification deadline keeps the bundle the last answer named;
      // any other failure means the site is unreachable now.
      if (!(error instanceof DOMException && error.name === "TimeoutError" && Date.now() >= deadline - 1)) live = "unreachable";
    }
    checkInterrupted();
    if (live === built) return { matches: true, live };
    console.log(`live: ${live}; waiting for ${built}`);
    const remaining = deadline - Date.now();
    if (remaining > 0) await delay(Math.min(interval, remaining), undefined, { signal: stop.signal }).catch(checkInterrupted);
  }
  return { matches: false, live };
}

async function preview(args) {
  if (args.some(arg => !["--dry-run", "--help", "-h"].includes(arg))) {
    process.stderr.write(usage);
    kitResult("fail", "preview invalid arguments");
    return 2;
  }
  if (args.some(arg => ["--help", "-h"].includes(arg))) {
    process.stdout.write(usage);
    kitResult("ok", "preview help");
    return 0;
  }
  try {
    previewTimeout = process.env.ASE_PREVIEW_TIMEOUT;
    if (previewTimeout !== undefined) duration(previewTimeout);
  } catch (error) {
    kitResult("fail", `preview ${error.message}`);
    return 2;
  }
  let lock, deployDir, status = 1, result;
  try {
    lock = openSync(process.env.KIT_PREVIEW_LOCK || "/tmp/ase-deploy-preview.lock", "a");
    let acquired = await run("flock", ["-n", "-E", "75", "3"], { lock });
    if (acquired.status === 75) {
      console.log("waiting for preview lock");
      acquired = await run("flock", ["-w", "900", "-E", "75", "3"], { lock, timeout: "16m" });
    }
    if (acquired.status) throw new Error(acquired.status === 75 ? "lock busy" : `lock failed: ${acquired.stderr || acquired.status}`);
    // Keep discovery git calls under the same deadline as the worktree steps.
    const root = resolve(process.env.KIT_ROOT || (await run("git", ["rev-parse", "--show-toplevel"], { step: "git rev-parse" })).stdout || resolve(import.meta.dirname, "../../.."));
    const main = resolve(kitMainRoot());
    deployDir = join(main, ".scratch/preview-deploy");
    let owner = process.env.ASE_OWNER;
    if (!owner) {
      try { owner = readFileSync(join(root, ".scratch/owner"), "utf8").split(/\r?\n/, 1)[0].trim().split(/\s+/)[1]; }
      catch { /* No owner file: use the branch. */ }
      if (!owner || owner === "unknown") owner = (await git(root, ["branch", "--show-current"], false)).stdout || "unknown";
    }
    console.log(`owner: ${owner.replace(/[\n\r]/g, " ")}`);
    await git(root, ["fetch", "-q", "origin", "dev"]);
    const sha = (await git(root, ["rev-parse", "origin/dev^{commit}"])).stdout;
    if (!/^[a-f0-9]{40}$/.test(sha)) throw new Error("invalid origin/dev commit");
    const { dir, state } = await worktree(root, main, sha);
    if (args.includes("--dry-run")) {
      result = `dry-run ${sha} ${state} ${dir}`;
      status = 0;
    } else {
      const parent = join(main, ".scratch/deploy");
      mkdirSync(parent, { recursive: true });
      const stamp = new Date().toISOString().replace(/[-:]/g, "").replace("T", "-").slice(0, 15);
      const log = join(parent, `${stamp}-${process.pid}.log`);
      console.log(`log: ${log}`);
      rmSync(join(dir, "dist"), { recursive: true, force: true });
      const env = nodeEnv({ ...process.env, NO_COLOR: "1", CI: "1" });
      const fd = openSync(log, "w");
      let deployed;
      // npm also holds the lock fd, so even a SIGKILL of this process keeps the lock until npm ends.
      try { deployed = await run("npm", ["run", "deploy:preview"], { cwd: dir, env, fd, lock, step: "deploy", timeout: "10m" }); }
      finally { closeSync(fd); }
      const output = readFileSync(log, "utf8");
      if (deployed.status) {
        for (const line of output.trimEnd().split(/\r?\n/).slice(-30)) console.error(`  ${line}`);
        throw new Error(`deploy failed (log ${log})`);
      }
      const version = [...output.matchAll(/Version ID: *([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/gi)].at(-1)?.[1];
      if (!version) throw new Error(`missing Version ID (log ${log})`);
      const built = builtBundle(dir);
      const { matches, live } = await verify(built);
      result = `${version} ${sha}${matches ? "" : ` live ${live} != built ${built}`}`;
      status = matches ? 0 : 1;
    }
  } catch (error) {
    result = error.message;
    if (error instanceof StepTimeout && deployDir) {
      try {
        for (const path of ["dist", ".wrangler/tmp"]) rmSync(join(deployDir, path), { recursive: true, force: true });
      } catch (cleanupError) { result += `; cleanup failed: ${cleanupError.message}`; }
    }
  }
  finally {
    if (lock !== undefined) {
      try { closeSync(lock); }
      catch (error) { status = 1; result = error.message; }
    }
  }
  kitResult(status === 0 ? "ok" : "fail", `preview ${result}`);
  return interrupted ? 128 + constants.signals[interrupted] : status;
}

process.exitCode = await preview(process.argv.slice(2));
