#!/usr/bin/env bash
# kit: check this worktree is safe to build in
set -euo pipefail
# shellcheck source=scripts/agents/kit-lib.sh
source "${KIT_LIB:-$(dirname -- "${BASH_SOURCE[0]}")/../kit-lib.sh}"

usage() {
  printf 'Usage: kit doctor [--quiet]\nCheck this worktree is safe to build in.\n'
}
quiet=false
for argument in "$@"; do
  case $argument in
    --help|-h) usage; exit 0 ;;
    --quiet) quiet=true ;;
    *) usage >&2; kit_result fail "doctor unknown argument $argument"; exit 2 ;;
  esac
done

# Without jq every setting reads as unset: the settings line names jq, and the checks that need a setting say
# they were skipped rather than blame scripts/agents/kit.json; the rest run on.
setting() { kit_setting "$1" 2>/dev/null || :; }
jq_missing=false
command -v jq > /dev/null || jq_missing=true
root=$(cd -- "$(kit_root)" && pwd -P)
main=$(realpath -m -- "$(kit_main_root)")
dev=$(kit_dev_root 2>/dev/null || :)
[[ -z $dev ]] || dev=$(realpath -m -- "$dev")
failed=() skipped=() checks=0
# KIT_DOCTOR_SKIP=help (agent.sh sets it for builds): a broken --help prints a problem: line and does not fail,
# so the builder that should repair it can start; so does a failing kit home check (it runs kit version)
# when version's help fails or hangs.
# Doctor honours no other name.
skip_help=false
if [[ ,${KIT_DOCTOR_SKIP:-}, == *,help,* ]]; then skip_help=true; fi
pass() {
  checks=$((checks + 1))
  if [[ $quiet == false ]]; then printf '✓ %s: %s\n' "$1" "$2"; fi
}
fail() {
  checks=$((checks + 1))
  failed+=("$1")
  printf '✗ %s: %s; fix: %s\n' "$1" "$2" "$3"
}

land=''
if problems=$(kit_settings_problems); then
  land=$(setting .branches.land)
  pass settings "scripts/agents/kit.json ($(setting .project), lands on $land)"
elif [[ $jq_missing == true ]]; then
  fail settings 'jq is not installed, so scripts/agents/kit.json cannot be read' 'install jq'
else
  if [[ -f $(kit_settings_file) ]]; then fix='edit scripts/agents/kit.json as the problem says'
  else fix='add scripts/agents/kit.json with "project" and "branches": { "land": "<branch>" }'; fi
  fail settings "${problems//$'\n'/; }" "$fix"
fi

# allowMainCheckout: a project worked on in its main checkout (chat) builds there.
allow_main=$(setting '.allowMainCheckout == true')
if [[ $jq_missing == true ]]; then
  pass place 'skipped (jq is not installed)'
elif [[ $root != "$main" && $root != "$dev" ]]; then
  pass place "$root"
elif [[ $root == "$main" && $allow_main == true ]]; then
  pass place "$root (main checkout; allowMainCheckout)"
else
  fail place "main or dev worktree ($root)" "create a worktree with scripts/agents/worktree.sh <branch> origin/${land:-<land>}"
fi

# Local clones are often behind GitHub (research 02): fetch the land branch before judging the base.
# Only git's "No such remote" (exit 2) means there is no GitHub repo; other git failures surface below.
fetched='' remote=true code=0
git -C "$root" remote get-url origin > /dev/null 2>&1 || code=$?
if (( code == 2 )); then remote=false; fi
if [[ -n $land && $remote == true ]] &&
  ! GIT_TERMINAL_PROMPT=0 timeout "${KIT_DOCTOR_FETCH_TIMEOUT:-20}" git -C "$root" fetch -q origin "$land" > /dev/null 2>&1; then
  fetched=" (fetch failed; judged the last fetched origin/$land)"
fi
current=$(git -C "$root" branch --show-current 2>/dev/null) || current=''
if [[ $jq_missing == true ]]; then
  pass base 'skipped (jq is not installed)'
elif [[ -z $land ]]; then
  fail base 'no land branch' 'fix scripts/agents/kit.json first'
elif [[ $remote == false ]]; then
  pass base "no GitHub repo (no origin remote); nothing to fetch"
elif ! tip=$(git -C "$root" rev-parse --verify "refs/remotes/origin/$land" 2>/dev/null); then
  fail base "missing origin/$land$fetched" 'git fetch origin'
elif [[ $root == "$dev" && $current == "$land" ]]; then
  pass base "$land in the dev worktree$fetched"
elif [[ $root == "$main" && $allow_main == true && $current == "$land" ]]; then
  behind=$(git -C "$root" rev-list --count "HEAD..origin/$land")
  pass base "$land in the main checkout, $behind commits behind origin/$land$fetched"
elif git -C "$root" merge-base --is-ancestor "origin/$land" HEAD; then
  pass base "contains origin/$land ${tip:0:7}$fetched"
else
  base=$(git -C "$root" merge-base HEAD "origin/$land" 2>/dev/null) || base=''
  # origin/<land> is shared by every worktree, so another runner's fetch moves it under us.
  # Accept a base that was the fetched land tip until less than a day ago.
  replaced='' newer=''
  if [[ -n $base ]]; then
    while read -r hash selector; do
      if [[ $hash == "$base" ]]; then replaced=$newer; break; fi
      newer=${selector##*@\{}
      newer=${newer%\}}
    done < <(git -C "$root" reflog show --date=unix --format='%H %gd' "refs/remotes/origin/$land" 2>/dev/null)
  fi
  age=-1
  if [[ $replaced =~ ^[0-9]+$ ]]; then age=$(( $(date +%s) - replaced )); fi
  if (( age >= 0 && age < 86400 )); then
    behind=$(git -C "$root" rev-list --count "HEAD..origin/$land")
    pass base "$behind commits behind origin/$land; rebase before landing$fetched"
  elif (( age >= 86400 )); then
    fail base "stale: origin/$land moved on from merge-base ${base:0:7} over a day ago" "rebase onto origin/$land"
  else
    base=${base:-none}
    fail base "not based on origin/$land (merge-base ${base:0:7})" "rebase onto origin/$land or recreate with scripts/agents/worktree.sh"
  fi
fi

missing=()
for config in .claude/settings.json .codex/hooks.json; do
  [[ -f $root/$config ]] || missing+=("$config")
done
if (( ${#missing[@]} == 0 )); then
  pass 'hook config' '.claude/settings.json and .codex/hooks.json exist'
else
  fail 'hook config' "missing ${missing[*]}" 'restore the missing hook configuration files'
fi

# The probe runs as a hook starts: without the KIT_HOME this command runs on, so a hook launcher has to find a kit itself.
status=0
probe=$(printf '%s\n' '{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"git stash push -m probe"}}' |
  env -u KIT_HOME -u KIT_HOME_DEFAULT CLAUDE_PROJECT_DIR="$root" timeout 5 bash "$root/scripts/agents/hooks/run.sh" bash-guard 2>/dev/null) || status=$?
if (( status == 2 )); then
  pass 'hooks live' 'bash-guard rejects the probe (status 2)'
elif [[ $probe == *'Agent Kit not found'* ]]; then
  fail 'hooks live' 'hooks cannot reach a kit (Agent Kit not found)' 'run scripts/agents/kit update to fill the machine copy'
else
  fail 'hooks live' "bash-guard returned status $status (expected 2)" 'check jq and scripts/agents/hooks/bash-guard.sh'
fi

if node=$(kit_node_find); then
  pass node "$("$node" --version)"
else
  fail node 'Node >=24 not found' 'install Node 24 (nvm) or fix PATH'
fi

modules='' shared=''
shared_path=$(setting .sharedNodeModules)
if [[ -d $root/node_modules ]]; then modules=$(cd -- "$root/node_modules" && pwd -P); fi
if [[ -n $shared_path && -d $shared_path ]]; then shared=$(cd -- "$shared_path" && pwd -P); fi
if [[ $jq_missing == true ]]; then
  pass node_modules 'skipped (jq is not installed)'
elif [[ -n $dev && $root == "$dev" && -n $modules ]]; then
  pass node_modules "$modules (dev worktree)"
elif [[ -z $shared_path ]]; then
  # No sharedNodeModules: the project keeps its own dependencies, or none, so there is nothing shared to check.
  if [[ -n $modules ]]; then pass node_modules "$modules (not shared: no sharedNodeModules in scripts/agents/kit.json)"
  else pass node_modules 'skipped (no sharedNodeModules in scripts/agents/kit.json)'; fi
elif [[ -z $shared ]]; then
  fail node_modules "shared $shared_path is missing or dangling" 'restore it or fix sharedNodeModules in scripts/agents/kit.json'
elif [[ ! -L $root/node_modules || -z $modules ]]; then
  fail node_modules 'missing, dangling or non-symlink node_modules' "ln -s \"\$(realpath $shared_path)\" node_modules"
elif [[ $modules != "$shared" ]]; then
  fail node_modules "node_modules differs from sharedNodeModules ($shared_path)" "ln -s \"\$(realpath $shared_path)\" node_modules"
else
  pass node_modules "$modules"
fi

# playwright: where Playwright comes from for a project without its own (a module file or folder,
# relative to the project's top folder or absolute); KIT_PLAYWRIGHT_MODULE overrides it.
playwright=${KIT_PLAYWRIGHT_MODULE:-$(setting .playwright)}
if [[ -n $playwright ]]; then
  [[ $playwright == /* ]] || playwright=$root/$playwright
  if [[ -e $playwright ]]; then pass playwright "$playwright"
  else fail playwright "$playwright is missing" 'install Playwright there or fix "playwright" in scripts/agents/kit.json'; fi
fi

# checks.doctor: the project's own doctor lines, each a shell command run in the top folder (one or a list).
while IFS= read -r line; do
  [[ -n $line ]] || continue
  code=0
  output=$(cd -- "$root" && timeout -k 2 "${KIT_DOCTOR_CHECK_TIMEOUT:-20}" bash -c "$line" 2>&1 < /dev/null) || code=$?
  last=${output##*$'\n'}
  if (( code == 0 )); then pass "$line" "${last:-ok}"
  elif (( code == 124 || code == 137 )); then fail "$line" 'timed out' 'see "checks.doctor" in scripts/agents/kit.json'
  else fail "$line" "exit $code${last:+: $last}" 'see "checks.doctor" in scripts/agents/kit.json'; fi
done < <(setting '.checks.doctor | if type == "array" then .[] else . end')

status=0
matches=$(git -C "$root" grep -nE '^(<<<<<<<|>>>>>>>)( |$)' 2>/dev/null) || status=$?
if (( status == 1 )); then
  pass conflicts 'no conflict markers in tracked files'
elif (( status == 0 )); then
  locations=()
  while IFS=: read -r file line _text; do
    locations+=("$file:$line")
    (( ${#locations[@]} < 3 )) || break
  done <<< "$matches"
  fail conflicts "${locations[*]}" 'resolve the conflict markers'
else
  fail conflicts "git grep returned status $status" 'check tracked files with git grep'
fi

# Shared commands sit beside doctor, the project's own in the folder "commands" names; KIT_COMMANDS_DIR (tests) replaces both.
# A project command may not take a shared name: it would hide a fix to the shared one.
own_setting='' own_shared=false
if [[ -n ${KIT_COMMANDS_DIR:-} ]]; then
  folders=("$KIT_COMMANDS_DIR")
else
  folders=("$(dirname -- "${BASH_SOURCE[0]}")")
  own_setting=$(setting .commands)
  if [[ -n $own_setting ]]; then
    own=$own_setting
    [[ $own == /* ]] || own=$root/$own
    if [[ $own -ef ${folders[0]} ]]; then own_shared=true; else folders+=("$own"); fi
  fi
fi
commands=() files=() counts=() clashes=()
declare -A shared_files=()
for group in "${!folders[@]}"; do
  counts[group]=0
  for file in "${folders[group]}"/*; do
    base=${file##*/}
    [[ -f $file && -x $file && $base != [._]* ]] || continue
    name=${base%.*}
    if (( group == 0 )); then shared_files[$name]=$file
    elif [[ -n ${shared_files[$name]-} ]]; then clashes+=("$name in both ${shared_files[$name]} and $file")
    fi
    commands+=("$name") files+=("$file")
    counts[group]=$((counts[group] + 1))
  done
done
if [[ -n $own_setting && ! -d $own ]]; then
  fail commands "no folder $own" 'create it or fix "commands" in scripts/agents/kit.json'
elif [[ $own_shared == true ]]; then
  fail commands "\"commands\" names the shared folder $own_setting" 'point "commands" in scripts/agents/kit.json at the project'"'"'s own folder'
elif (( ${#clashes[@]} )); then
  list=$(printf '%s; ' "${clashes[@]}")
  fail commands "${list%; }" 'rename the project command'
elif [[ -n ${KIT_COMMANDS_DIR:-} ]]; then
  pass commands "${counts[0]} in $KIT_COMMANDS_DIR (KIT_COMMANDS_DIR)"
elif [[ $jq_missing == true ]]; then
  pass commands "${counts[0]} shared, project folder skipped (jq is not installed)"
elif [[ -n $own_setting ]]; then
  pass commands "${counts[0]} shared, ${counts[1]} in $own_setting"
else
  pass commands "${counts[0]} shared, no project folder (no \"commands\" in scripts/agents/kit.json)"
fi

# Every command answers --help, so a broken pull or a missing import shows here.
# The helps run side by side to keep doctor quick.
help_dir=$(mktemp -d)
trap 'rm -rf -- "$help_dir"' EXIT
for index in "${!files[@]}"; do
  file=${files[index]}
  (
    code=0
    cd -- "$root" && timeout -k 2 "${KIT_HELP_TIMEOUT:-10}" "$file" --help > "$help_dir/$index.out" 2>&1 < /dev/null || code=$?
    printf '%s\n' "$code" > "$help_dir/$index.code"
    # The help's own output is in its file; this hides bash's "Killed" line when timeout -k has to SIGKILL.
  ) 2>/dev/null &
done
wait
broken=() version_broken=false
for index in "${!commands[@]}"; do
  code=$(< "$help_dir/$index.code")
  # 137: timeout -k had to kill a help that ignored SIGTERM.
  if (( code == 124 || code == 137 )); then broken+=("${commands[index]} (timed out)")
  elif (( code != 0 )); then broken+=("${commands[index]} (exit $code)")
  elif ! grep -q 'Usage:' "$help_dir/$index.out"; then broken+=("${commands[index]} (no usage)")
  fi
done
# Only a version that fails or hangs breaks kit home; a help without a Usage: line still runs.
for entry in "${broken[@]}"; do [[ $entry != 'version (exit '* && $entry != 'version (timed out)' ]] || version_broken=true; done
if (( ${#commands[@]} == 0 )); then
  fail help "no commands in ${folders[*]}" 'restore scripts/agents/kit.d or the "commands" folder'
elif (( ${#broken[@]} == 0 )); then
  pass help "${#commands[@]} commands answer --help"
else
  list=$(IFS=,; printf '%s' "${broken[*]}")
  if [[ $skip_help == true ]]; then
    skipped+=(help)
    printf 'problem: help: %s; fix: run scripts/agents/kit <command> --help and repair it\n' "${list//,/, }"
  else
    fail help "${list//,/, }" 'run scripts/agents/kit <command> --help and repair it'
  fi
fi

# The shared kit runs from anywhere: a copy outside the project, named by KIT_HOME, runs a shared command
# for a temporary project holding only the settings, the front door and the project's own commands, so a
# command that still reached a helper through this project's scripts/agents/ fails here.
# The copy leaves out the project's own commands folder when it sits inside the kit's.
home=$(kit_home) copy=$help_dir/kit-home project=$help_dir/project output='' code=0
if ! cp -R -- "$home" "$copy" 2>/dev/null || ! mkdir -p -- "$project/scripts/agents" || ! cp -- "$copy/kit" "$project/scripts/agents/kit" 2>/dev/null; then
  code=1 output="cannot copy $home"
else
  # A machine copy is read-only (kit update); the copy is not.
  chmod -R u+w -- "$copy"
  if [[ -n ${own:-} && $own == "$home"/* ]]; then rm -rf -- "${copy:?}/${own#"$home"/}"; fi
  [[ ! -f $(kit_settings_file) ]] || cp -- "$(kit_settings_file)" "$project/scripts/agents/kit.json"
  if [[ -n ${own:-} && -d $own && $own_setting != /* ]]; then
    mkdir -p -- "$project/$(dirname -- "$own_setting")" && cp -R -- "$own" "$project/$own_setting"
  fi
  output=$(cd -- "$project" && env -u KIT_COMMANDS_DIR KIT_HOME="$copy" KIT_ROOT="$project" timeout -k 2 10 "$project/scripts/agents/kit" version 2>&1 < /dev/null) || code=$?
fi
if (( code == 0 )) && [[ ${output##*$'\n'} == 'RESULT: ok version '* ]]; then
  pass 'kit home' "a copy of $home runs kit version for a project with only its settings and front door"
elif [[ $skip_help == true && $version_broken == true && $output != 'cannot copy '* ]]; then
  # The copy runs the broken version command, so this follows the help skip: the builder repairs both.
  skipped+=('kit home')
  printf 'problem: kit home: a copy of %s fails kit version: %s; fix: repair kit version (its --help is broken too)\n' "$home" "${output##*$'\n'}"
else
  fail 'kit home' "a copy of $home fails kit version: ${output##*$'\n'}" 'reach shared helpers through KIT_HOME, not scripts/agents/'
fi

# The kit's commit and age beside the project's, from kit version: a note, never a failure. A machine copy
# without an update for over a day warns, also when quiet, and the RESULT says so.
kit_warning='' version=$(timeout -k 2 10 "$home/kit.d/version" 2>/dev/null < /dev/null) || version=''
if [[ $version =~ (^|$'\n')commit\ ([^$'\n']*)$'\n'kit\ ([^$'\n']*)$'\n'project\ ([^$'\n']*) ]]; then
  kit_line="commit ${BASH_REMATCH[2]} (${BASH_REMATCH[3]}); project ${BASH_REMATCH[4]}"
  if [[ $version =~ (^|$'\n')warning\ ([^;$'\n']*)\;\ ([^$'\n']*) ]]; then
    kit_warning=${BASH_REMATCH[2]}
    printf '✗ kit: %s; %s; fix: %s\n' "$kit_line" "$kit_warning" "${BASH_REMATCH[3]}"
  elif [[ $quiet == false ]]; then
    printf '✓ kit: %s\n' "$kit_line"
  fi
fi

# Grok is an optional second reviewer: report it, never fail on it.
if [[ $quiet == false ]]; then
  grok=${KIT_GROK:-grok}
  if ! command -v -- "$grok" >/dev/null 2>&1; then
    printf '✗ grok: not installed (optional reviewer); fix: install the grok CLI for Grok reviews\n'
  else
    code=0
    models=$(timeout "${KIT_GROK_TIMEOUT:-10}" "$grok" models 2>&1) || code=$?
    if grep -q '^You are logged in' <<< "$models"; then
      printf '✓ grok: installed and logged in (optional reviewer)\n'
    elif (( code == 124 )); then
      printf "✗ grok: 'grok models' timed out (optional reviewer); fix: check the network or the grok CLI\n"
    elif grep -qi 'not logged in' <<< "$models"; then
      printf '✗ grok: not logged in (optional reviewer); fix: grok login\n'
    elif (( code == 0 )); then
      printf "✗ grok: unrecognised 'grok models' output (optional reviewer); fix: run grok models and check its login line\n"
    else
      printf "✗ grok: 'grok models' failed with status %s (optional reviewer); fix: check the network or the grok CLI\n" "$code"
    fi
  fi
fi

if (( ${#failed[@]} )); then
  names=$(IFS=,; printf '%s' "${failed[*]}")
  kit_result fail "doctor ${#failed[@]} failed: $names"
  exit 1
fi
skipped_list=$(IFS=,; printf '%s' "${skipped[*]}")
kit_result ok "doctor $checks/$checks checks passed${skipped_list:+; skipped ${skipped_list//,/, } (KIT_DOCTOR_SKIP)}${kit_warning:+; warning: $kit_warning}"
