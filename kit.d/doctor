#!/usr/bin/env bash
# kit: check this worktree is safe to build in
set -euo pipefail
# shellcheck source=scripts/agents/kit-lib.sh
source "${KIT_LIB:-$(dirname -- "${BASH_SOURCE[0]}")/../kit-lib.sh}"

usage() {
  printf 'Usage: kit doctor [--quiet]\nCheck this worktree is safe to build in.\n'
}
quiet=false
for argument in "$@"; do
  case $argument in
    --help|-h) usage; exit 0 ;;
    --quiet) quiet=true ;;
    *) usage >&2; kit_result fail "doctor unknown argument $argument"; exit 2 ;;
  esac
done

root=$(cd -- "$(kit_root)" && pwd -P)
main=$(realpath -m -- "$(kit_main_root)")
dev=$(realpath -m -- "$(kit_main_root)-dev")
failed=()
pass() {
  if [[ $quiet == false ]]; then printf '✓ %s: %s\n' "$1" "$2"; fi
}
fail() {
  failed+=("$1")
  printf '✗ %s: %s; fix: %s\n' "$1" "$2" "$3"
}

if [[ $root != "$main" && $root != "$dev" ]]; then
  pass place "$root"
else
  fail place "main or dev worktree ($root)" 'create a worktree with scripts/agents/worktree.sh <branch> origin/dev'
fi

if ! tip=$(git -C "$root" rev-parse --verify refs/remotes/origin/dev 2>/dev/null); then
  fail base 'missing origin/dev' 'git fetch origin'
elif [[ $root == "$dev" ]] && [[ $(git -C "$root" branch --show-current) == dev ]]; then
  pass base 'dev in the dev worktree'
elif git -C "$root" merge-base --is-ancestor origin/dev HEAD; then
  pass base "contains origin/dev ${tip:0:7}"
else
  base=$(git -C "$root" merge-base HEAD origin/dev 2>/dev/null) || base=''
  # origin/dev is shared by every worktree, so another runner's fetch moves it under us.
  # Accept a base that was the fetched dev tip until less than a day ago.
  replaced='' newer=''
  if [[ -n $base ]]; then
    while read -r hash selector; do
      if [[ $hash == "$base" ]]; then replaced=$newer; break; fi
      newer=${selector##*@\{}
      newer=${newer%\}}
    done < <(git -C "$root" reflog show --date=unix --format='%H %gd' refs/remotes/origin/dev 2>/dev/null)
  fi
  age=-1
  if [[ $replaced =~ ^[0-9]+$ ]]; then age=$(( $(date +%s) - replaced )); fi
  if (( age >= 0 && age < 86400 )); then
    behind=$(git -C "$root" rev-list --count HEAD..origin/dev)
    pass base "$behind commits behind origin/dev; rebase before landing"
  elif (( age >= 86400 )); then
    fail base "stale: origin/dev moved on from merge-base ${base:0:7} over a day ago" 'rebase onto origin/dev'
  else
    base=${base:-none}
    fail base "not based on origin/dev (merge-base ${base:0:7})" 'rebase onto origin/dev or recreate with scripts/agents/worktree.sh'
  fi
fi

missing=()
for config in .claude/settings.json .codex/hooks.json; do
  [[ -f $root/$config ]] || missing+=("$config")
done
if (( ${#missing[@]} == 0 )); then
  pass 'hook config' '.claude/settings.json and .codex/hooks.json exist'
else
  fail 'hook config' "missing ${missing[*]}" 'restore the missing hook configuration files'
fi

status=0
printf '%s\n' '{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"git stash push -m probe"}}' |
  CLAUDE_PROJECT_DIR="$root" timeout 5 bash "$root/scripts/agents/hooks/run.sh" bash-guard >/dev/null 2>&1 || status=$?
if (( status == 2 )); then
  pass 'hooks live' 'bash-guard rejects the probe (status 2)'
else
  fail 'hooks live' "bash-guard returned status $status (expected 2)" 'check jq and scripts/agents/hooks/bash-guard.sh'
fi

if node=$(kit_node_find); then
  pass node "$("$node" --version)"
else
  fail node 'Node >=24 not found' 'install Node 24 (nvm) or fix PATH'
fi

modules='' shared=''
if [[ -d $root/node_modules ]]; then modules=$(cd -- "$root/node_modules" && pwd -P); fi
if [[ -d $dev/node_modules ]]; then shared=$(cd -- "$dev/node_modules" && pwd -P); fi
if [[ $root == "$dev" && -n $modules ]]; then
  pass node_modules "$modules (dev worktree)"
elif [[ -z $shared ]]; then
  fail node_modules "shared $dev/node_modules is missing or dangling" 'restore node_modules in the dev worktree'
elif [[ ! -L $root/node_modules || -z $modules ]]; then
  fail node_modules 'missing, dangling or non-symlink node_modules' "ln -s \"\$(realpath $dev/node_modules)\" node_modules"
elif [[ $modules != "$shared" ]]; then
  fail node_modules 'node_modules differs from the dev worktree' "ln -s \"\$(realpath $dev/node_modules)\" node_modules"
else
  pass node_modules "$modules"
fi

status=0
matches=$(git -C "$root" grep -nE '^(<<<<<<<|>>>>>>>)( |$)' 2>/dev/null) || status=$?
if (( status == 1 )); then
  pass conflicts 'no conflict markers in tracked files'
elif (( status == 0 )); then
  locations=()
  while IFS=: read -r file line _text; do
    locations+=("$file:$line")
    (( ${#locations[@]} < 3 )) || break
  done <<< "$matches"
  fail conflicts "${locations[*]}" 'resolve the conflict markers'
else
  fail conflicts "git grep returned status $status" 'check tracked files with git grep'
fi

# Grok is an optional second reviewer: report it, never fail on it.
if [[ $quiet == false ]]; then
  grok=${KIT_GROK:-grok}
  if ! command -v -- "$grok" >/dev/null 2>&1; then
    printf '✗ grok: not installed (optional reviewer); fix: install the grok CLI for Grok reviews\n'
  else
    code=0
    models=$(timeout "${KIT_GROK_TIMEOUT:-10}" "$grok" models 2>&1) || code=$?
    if grep -q '^You are logged in' <<< "$models"; then
      pass grok 'installed and logged in (optional reviewer)'
    elif (( code == 124 )); then
      printf "✗ grok: 'grok models' timed out (optional reviewer); fix: check the network or the grok CLI\n"
    elif grep -qi 'not logged in' <<< "$models"; then
      printf '✗ grok: not logged in (optional reviewer); fix: grok login\n'
    elif (( code == 0 )); then
      printf "✗ grok: unrecognised 'grok models' output (optional reviewer); fix: run grok models and check its login line\n"
    else
      printf "✗ grok: 'grok models' failed with status %s (optional reviewer); fix: check the network or the grok CLI\n" "$code"
    fi
  fi
fi

if (( ${#failed[@]} )); then
  names=$(IFS=,; printf '%s' "${failed[*]}")
  kit_result fail "doctor ${#failed[@]} failed: $names"
  exit 1
fi
kit_result ok 'doctor 7/7 checks passed'
