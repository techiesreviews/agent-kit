#!/usr/bin/env node
// kit: one table of tickets, PRs, CI and the live preview
import { execFile } from "node:child_process";
import { readFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { promisify } from "node:util";
import { FLAKY_DAYS, flakyFiles } from "../browser-runs.mjs";
import { loadTickets } from "../tickets.mjs";
import { onOrbit, openOrbitTickets, orbitProblem } from "../ticket-cards.mjs";

const { kitBranch, kitGhEnv, kitOwner, kitRoot, kitResult, kitSettings, kitStateDir } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = "Usage: kit status [map] [--ref <ref>] [--no-fetch] [--help]\nOn Orbit (\"tickets\": \"orbit\") the rows are the cards of the project's board: status name,\nthe owner on its \"Claimed by:\" line and the PR naming its key; a map does not apply there.\n";
const execute = promisify(execFile);
const clean = value => String(value).replace(/[\x00-\x1f\x7f]/g, " ").trim();
function cut(value, width) {
  const chars = Array.from(clean(value));
  return chars.length > width ? `${chars.slice(0, width - 1).join("")}…` : chars.join("");
}
const print = value => console.log(cut(value, 100));
const result = (state, text) => kitResult(state, cut(`status ${text}`, state === "ok" ? 89 : 87));

function options(args) {
  let map, ref, noFetch = false, help = false;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (["--help", "-h"].includes(arg)) help = true;
    else if (arg === "--no-fetch" && !noFetch) noFetch = true;
    else if (arg === "--ref" && ref === undefined && args[i + 1] && !args[i + 1].startsWith("-")) ref = args[++i];
    else if (!arg.startsWith("-") && /^[\w-]+$/.test(arg) && map === undefined) map = arg;
    else throw new Error(`invalid argument: ${arg}`);
  }
  return { map, ref, noFetch, help };
}

function reason(error) {
  if (error.code === "ENOENT") return "executable not found";
  if (error.killed || error.code === "ETIMEDOUT") return "timed out";
  return cut(String(error.stderr || error.message).trim().split(/\r?\n/)[0], 48);
}

async function command(command, args, cwd, env = process.env) {
  const { stdout } = await execute(command, args, {
    cwd, env, encoding: "utf8", timeout: 20_000, killSignal: "SIGKILL", maxBuffer: 32 * 1024 * 1024,
  });
  return stdout.trim();
}

// GitHub returns CheckRun and StatusContext entries in the same PR rollup.
function ci(checks) {
  if (!checks.length) return "-";
  let pending = false;
  for (const check of checks) {
    const outcome = (check.conclusion || check.state || "").toLowerCase();
    const status = (check.status || "").toLowerCase();
    if (["failure", "error", "cancelled", "canceled", "timed_out", "action_required", "startup_failure"].includes(outcome)) return "fail";
    if ((status && status !== "completed") || !["success", "skipped", "neutral"].includes(outcome)) pending = true;
  }
  return pending ? "run" : "pass";
}

// gh lists runs newest first; only each workflow's latest run counts, as in ci-summary.mjs.
function latest(runs) {
  const seen = new Set();
  return runs.filter(run => !seen.has(run.workflowName) && seen.add(run.workflowName));
}

// A card's PR, in any letter case (KIT-12 is not KIT-121): first one on its own branch (build/kit-12-…, as kit next
// names it), then one whose title or "Ticket:" line names the key, and only then one whose body mentions it, since a PR
// body lists every commit subject and another card's PR can name this key in passing.
function cardPR(key, prs) {
  const name = key.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), match = new RegExp(`(?<![A-Za-z0-9])${name}(?![0-9])`, "i");
  const branch = new RegExp(`^build/${name}(?:-|$)`, "i");
  const rank = state => state === "OPEN" ? 0 : state === "MERGED" ? 1 : 2;
  const tiers = [pr => branch.test(pr.headRefName || ""), pr => match.test(pr.title || ""),
    pr => (pr.body || "").split("\n").some(line => line.startsWith("Ticket: ") && match.test(line)), pr => match.test(pr.body || "")];
  for (const tier of tiers) {
    const found = prs.filter(tier).sort((a, b) => rank(a.state) - rank(b.state) || b.number - a.number)[0];
    if (found) return found;
  }
}

function ticketPR(ticket, prs) {
  const slug = ticket.slug.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = new RegExp(`(?<![A-Za-z0-9])${slug}(?![A-Za-z0-9-])`);
  const rank = state => state === "OPEN" ? 0 : state === "MERGED" ? 1 : 2;
  return prs.filter(pr => [pr.title, pr.body, pr.headRefName].some(text => match.test(text || "")))
    .sort((a, b) => rank(a.state) - rank(b.state) || b.number - a.number)[0];
}

async function preview(address) {
  try {
    const url = new URL(address);
    url.searchParams.set("kit", String(Date.now()));
    const response = await fetch(url, { cache: "no-store", signal: AbortSignal.timeout(10_000) });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const html = await response.text();
    const bundle = /(?:^|[\/"'])assets\/(index-[^\/"'?#\s<>]+\.js)(?=[?#"'\s<>]|$)/.exec(html)?.[1];
    if (!bundle) throw new Error("bundle not found");
    return { line: `preview: ${bundle}` };
  } catch (error) {
    const detail = error.name === "TimeoutError" ? "timed out" : reason(error);
    return { line: `preview: unknown (${detail})`, note: `preview unavailable (${detail})` };
  }
}

async function status(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    process.stderr.write(usage);
    result("fail", error.message);
    return 2;
  }
  if (flags.help) { process.stdout.write(usage); return 0; }
  const { map, noFetch } = flags;
  const root = kitRoot(), notes = [];
  let settings;
  try { settings = kitSettings(root); }
  catch (error) {
    console.error(cut(error.message, 100));
    result("fail", error.message);
    return 1;
  }
  // No preview address: the preview row is left out.
  const address = process.env.KIT_PREVIEW_URL || settings.preview;
  const git = args => command("git", ["-C", root, ...args], root);
  // With no origin remote (git's "No such remote", exit 2) there is no GitHub repo: the land branch is read
  // locally and PR and CI are left out. Any other git failure keeps the remote view and fails where it used to.
  const remote = await git(["remote", "get-url", "origin"]).then(() => true, error => error.code !== 2);
  const ref = flags.ref ?? `${remote ? "origin/" : ""}${kitBranch("land", settings)}`;
  const onRef = async oid => {
    if (!/^[0-9a-f]{40}$/.test(oid || "")) return "";
    try {
      await git(["merge-base", "--is-ancestor", oid, ref]);
      return await git(["rev-parse", "--short", oid]);
    } catch { return ""; }
  };
  try {
    if (!noFetch && ref.startsWith("origin/")) {
      try { await git(["fetch", "-q", "origin"]); }
      catch { notes.push(`fetch failed; using cached ${ref}`); }
    }
    // On Orbit the rows are the board's cards; no maps folder: no ticket rows, with a line saying why.
    const orbit = onOrbit(settings);
    if (orbit && map) throw new Error(`a map does not apply on Orbit: the rows are the cards of the board in scripts/agents/kit.json`);
    let board = "", cards = [], more = "";
    if (orbit) {
      let redact;
      try {
        const opened = openOrbitTickets({ settings, who: kitOwner() });
        redact = opened.redact;
        const read = await opened.store.board({ project: opened.project, parent: opened.parent });
        ({ board, cards } = read);
        if (read.more) more = `board ${board} holds more than 1000 cards; only the first 1000 are shown`;
      } catch (error) { throw new Error(orbitProblem(error, redact)); }
    }
    const { tickets } = orbit ? { tickets: cards.map(card => ({ slug: card.identifier, map: board, status: card.status_name, done: card.stage === "done", assignee: card.stage === "working" ? card.claimed_by ?? "" : "", card: true })) }
      : settings.maps ? loadTickets(settings.maps, map, { ref, cwd: root }) : { tickets: [] };
    const sha = await git(["rev-parse", "--verify", `${ref}^{commit}`]);
    const branch = ref.replace(/^(?:refs\/remotes\/)?origin\//, "").replace(/^refs\/heads\//, "");
    const gh = process.env.KIT_STATUS_GH || "gh", ghEnv = kitGhEnv(process.env, root);
    const [github, live] = await Promise.all([
      !remote ? { prs: [], runs: [], none: true } : Promise.allSettled([
        command(gh, ["pr", "list", "--state", "all", "--base", branch, "--limit", "200", "--json", "number,state,title,body,headRefName,mergeCommit,statusCheckRollup"], root, ghEnv),
        command(gh, ["run", "list", "--branch", branch, "--limit", "100", "--json", "headSha,status,conclusion,workflowName,event"], root, ghEnv),
      ]).then(responses => {
        const failed = responses.find(response => response.status === "rejected");
        if (failed) throw failed.reason;
        const [prs, runs] = responses.map(response => response.value);
        const data = { prs: JSON.parse(prs), runs: JSON.parse(runs) };
        if (!Array.isArray(data.prs) || !Array.isArray(data.runs)) throw new Error("invalid gh response");
        return data;
      }).catch(error => ({ prs: [], runs: [], unavailable: reason(error) })),
      address ? preview(address) : {},
    ]);
    if (github.none) notes.push("no GitHub repo (no origin remote); no PRs or CI");
    if (github.unavailable) notes.push(`gh unavailable (${github.unavailable}); PR and CI unknown`);
    if (live.note) notes.push(live.note);
    const currentRuns = github.runs.filter(run => run.headSha === sha);
    const older = !currentRuns.length && github.runs.length > 0;
    const branchCI = github.unavailable ? "?" : github.none ? "-" : ci(latest(currentRuns.length ? currentRuns : github.runs.slice(0, 1)));
    print(`ref ${ref} ${sha.slice(0, 7)}  ${branch} CI: ${branchCI}${older ? " (older sha)" : ""}`);
    if (live.line) print(live.line);
    if (!orbit && !settings.maps) print("tickets: none (no maps folder in scripts/agents/kit.json)");
    for (const note of more ? [...notes, more] : notes) print(`note: ${note}`);
    const widths = [32, 15, 10, 21, 4];
    const row = cells => print(cells.map((cell, i) => cut(cell, widths[i]).padEnd(widths[i])).join("  ").trimEnd());
    row(["TICKET", "STATUS", "WHO", "LANDED", "CI"]);
    if (!orbit) tickets.sort((a, b) => a.map.localeCompare(b.map) || a.slug.localeCompare(b.slug, "en", { numeric: true }));
    const groups = new Set(tickets.map(ticket => ticket.map));
    // An open PR counts once, even when more than one ticket names it.
    let group;
    const openPRs = new Set();
    for (const ticket of tickets) {
      if (groups.size > 1 && group !== ticket.map) { group = ticket.map; print(`== ${group} ==`); }
      const pr = ticket.card ? cardPR(ticket.slug, github.prs) : ticketPR(ticket, github.prs);
      if (pr?.state === "OPEN") openPRs.add(pr.number);
      const merged = pr?.state === "MERGED";
      // Closed tickets land with the commit that closed them; an open ticket can still have a merged PR.
      const landed = !ticket.card && ticket.status === "closed"
        ? await git(["log", ref, "-1", "--format=%h", "-G", "^status:[[:space:]]*closed", "--", ticket.file])
        : merged ? await onRef(pr.mergeCommit?.oid) : "";
      // CI always describes the commit or PR shown in LANDED.
      const ticketCI = github.unavailable ? "?"
        : pr?.state === "OPEN" ? ci(pr.statusCheckRollup || [])
        : landed ? ci(latest(github.runs.filter(run => run.headSha?.startsWith(landed)))) : "-";
      const location = pr?.state === "OPEN" ? `#${pr.number} open`
        : landed ? `${landed}${merged ? ` #${pr.number}` : ""}` : merged ? `#${pr.number} merged` : "-";
      const who = clean(ticket.assignee || ticket.builder || "-").split(/\s+/)[0];
      row([ticket.slug, ticket.status, who, location, ticketCI]);
    }
    // Spec files that kit pr forgave as flaky under load too often (ticket ke-88) want a real fix.
    let log = "";
    try { log = readFileSync(join(kitStateDir(), "flaky.jsonl"), "utf8"); } catch { /* No flaky run on this machine. */ }
    const flaky = flakyFiles(log, { project: settings.project });
    for (const { file, count } of flaky) print(`flaky: ${file} ${count} times in ${FLAKY_DAYS} days (give it a fix ticket)`);
    const flakyCount = flaky.length ? `, ${flaky.length} flaky file${flaky.length === 1 ? "" : "s"}` : "";
    const counted = orbit ? `${board} ${tickets.length} card${tickets.length === 1 ? "" : "s"}, ${tickets.filter(ticket => ticket.done).length} done`
      : `${map || "all"} ${tickets.length} tickets, ${tickets.filter(ticket => ticket.status === "closed").length} closed`;
    result("ok", `${counted}, ${openPRs.size} open PRs${github.none ? ", no GitHub repo" : notes.length ? ", offline" : ""}${flakyCount}`);
    return 0;
  } catch (error) {
    console.error(cut(error.message, 100));
    result("fail", error.message);
    return 1;
  }
}

process.exitCode = await status(process.argv.slice(2));
