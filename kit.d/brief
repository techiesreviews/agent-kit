#!/usr/bin/env node
// kit: print the brief for a delegated child (build, review, second look or fix) from the ticket and the rules
import { mkdirSync, realpathSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { basename, join, resolve } from "node:path";
import { composeBrief, kitVersion, nextTalkStyle, readTicket, skillSettingsProblems, STAGES } from "../brief-lib.mjs";
import { kitHome, kitMessagesToLexRule, kitOwner, kitResult, kitReviewLoopRule, kitRoot, kitRulebookPins, kitSettings } from "../kit-lib.mjs";
import { briefTicket } from "../ticket.mjs";
import { doneWhen } from "../ticket-cards.mjs";

const usage = `Usage: kit brief <ticket> [--stage build|review|second-look|fix] [--owner ID] [--repo PATH] [--model M] [--note "<text>"]
       kit brief --task "<title>" --owner ID --note "<what to do>" [--stage …] [--repo PATH] [--model M]
Prints the whole brief for one child: owner, worktree setup, builder and review pins, the commands to run and the
evidence to report, the house rules, the Messages to Lex rule, the wait rule (kit go), the skills for the ticket's files (the skills map,
skills.json; "skills": { "add", "remove" } in scripts/agents/kit.json), the talk style and the report's last line.
It ends with the marker line "kit-brief: <kit version> <ticket> <stage>", which the brief-guard hook looks for; pass
everything above the RESULT line to delegate_task. A copy is kept in .scratch/kit-briefs/<ticket>-<stage>.md
(task-<slug>-<stage>.md for --task).
--stage defaults to build. --owner defaults to the ticket's assignee; a ticket with neither is refused. --repo is the
project's top folder (default: this one); the ticket path is read from there. --model names the child's model
(default: the stage's pin), which picks how skills are named: /name for Claude, $name for Codex, the kit's own
words for models without skills.
The ticket may be an Orbit card KEY such as KIT-12, in any project (a ticket file at that very path wins): the brief
holds the card's title, text and comments in place of a ticket file's, and --owner defaults to its "Claimed by:" owner
(else its "Assignee:" line). On an Orbit project a lead's build brief (ORBIT_ROLE=lead; anyone else gets a warning)
claims a card nobody holds (Todo, Backlog, or In Progress with no claim, assignee or next step) for the owner: In
Progress and "Claimed by:". A Todo or Backlog card that is blocked or waits for Lex is refused. Any
other card is left as it is, with a warning that says why (someone else holds it, it waits for Lex, it is Done or in
another status); the owner's own card gets none. The claim reads the card again right before its write, so a card
moved meanwhile to a status the brief does not take (Ideas, say) is left as it is too, with a warning that it changed
and why; one that someone else took, or that is Done by then, fails the brief. On a board with no Todo status, every status not yet started counts as Todo. In a project that keeps ticket files the kit neither claims nor closes the card: the
build brief has the builder ask the lead to close it after the merge.
--task is for a job with no ticket file or card: the note holds the task, the marker names it task:<slug>, and the
brief lands it with kit pr --title.
A build brief carries the grill and prototype step and asks for proof lines: per "Done when" item, what was really
tried on the real thing. A card or ticket without a "Done when" list gets a warning on stderr.
Talk style: short English; KIT_TALK_STYLE=plain turns it off. Review briefs stay plain English.`;

function parse(args) {
  const options = { stage: "build" };
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (["--stage", "--owner", "--repo", "--note", "--model", "--task"].includes(arg)) {
      if (args[i + 1] === undefined || (arg !== "--note" && args[i + 1].startsWith("-"))) throw new Error(`${arg} needs a value`);
      options[arg.slice(2)] = args[++i];
    } else if (arg.startsWith("-")) throw new Error(`unknown option ${arg}`);
    else rest.push(arg);
  }
  if (options.task !== undefined) {
    if (rest.length) throw new Error("give a ticket path or --task, not both");
    if (!options.task.trim() || !options.owner || !options.note) throw new Error("--task needs a title, --owner and --note (the task itself)");
    if (!STAGES.includes(options.stage)) throw new Error(`--stage must be ${STAGES.join(", ")}, not ${options.stage}`);
    return { ...options };
  }
  if (rest.length !== 1) throw new Error("expected one ticket path");
  if (!STAGES.includes(options.stage)) throw new Error(`--stage must be ${STAGES.join(", ")}, not ${options.stage}`);
  return { ...options, ticket: rest[0] };
}

const args = process.argv.slice(2);
if (args.includes("--help") || args.includes("-h")) { console.log(usage); process.exit(0); }
try {
  const options = parse(args);
  const root = realpathSync(resolve(options.repo ?? kitRoot()));
  let ticket, text, card, claim = async () => async () => "";
  if (options.task !== undefined) {
    // A task with no ticket file: its title stands in for the ticket's, the note for its body.
    ticket = `task:${options.task.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 60).replace(/^-+|-+$/g, "") || "task"}`;
    text = `---\ntitle: ${JSON.stringify(options.task.trim())}\n---\n`;
  } else ({ ticket, text, card, claim } = await briefTicket({ root, ticket: options.ticket, who: kitOwner() }));
  const settings = kitSettings(root);
  const problems = skillSettingsProblems(settings);
  if (problems.length) throw new Error(problems.join("; "));
  // A group ran as one kit next job; kit next was cut (TOOLS-235), so the lead briefs its tickets one by one or as a task.
  const { group } = readTicket(text);
  if (group) throw new Error(`${ticket} is in group ${group}: kit brief writes a brief for one ticket; brief the group's tickets one at a time (take the group: line off each), or the whole group as one --task`);
  // The proof lines go per Done when item (TOOLS-235): a list under "## Done when", or the card standard's "Done when:" line.
  if (options.task === undefined && !doneWhen(text))
    console.error(`warning: ${ticket} has no "Done when" list; the proof lines need one (the card standard's "Done when:" line)`);
  const pins = kitRulebookPins(root, settings);
  const messages = kitMessagesToLexRule(), reviewLoop = kitReviewLoopRule();
  // The child's owner is the claim's: a brief written before the claim would hand it the lead's own owner.
  const owner = options.owner || readTicket(text).assignee;
  if (!owner) throw new Error(`${ticket} has no assignee; claim it first or pass --owner`);
  // Review briefs carry no talk style: their findings go to GitHub.
  const style = options.stage === "review" || options.stage === "second-look" ? "plain" : nextTalkStyle();
  const brief = composeBrief({ messages, reviewLoop, root, settings, ticket, text, stage: options.stage, owner, note: options.note, model: options.model, style, pins, version: kitVersion(kitHome()), task: options.task?.trim(), card });
  const file = join(".scratch/kit-briefs", `${basename(ticket).replace(/^task:/, "task-").replace(/\.md$/i, "")}-${options.stage}.md`);
  mkdirSync(join(root, ".scratch/kit-briefs"), { recursive: true });
  // The brief is written to a file of its own, claimed, then moved into place: no later step can fail and leave the card
  // held for a brief nobody has, and a brief whose claim loses never touches the copy of the one that won.
  const saved = join(root, file), temporary = `${saved}.${process.pid}.tmp`;
  writeFileSync(temporary, `${brief}\n`);
  let giveBack = async () => "";
  // A build brief claims an Orbit project's card; a ticket file, a task and a card in a files project claim nothing.
  if (options.stage === "build") {
    try { giveBack = await claim(owner); }
    catch (error) { rmSync(temporary, { force: true }); throw error; }
  }
  try { renameSync(temporary, saved); }
  catch (error) {
    rmSync(temporary, { force: true });
    throw new Error(`the brief could not be saved as ${file} (${error.message})${await giveBack()}`);
  }
  console.log(brief);
  kitResult("ok", `brief ${ticket} ${options.stage} (talk ${style}) ${file}`);
} catch (error) {
  console.error(error.message);
  kitResult("fail", `brief ${error.message}`);
  process.exitCode = 1;
}
