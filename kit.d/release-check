#!/usr/bin/env node
// kit: before going live: nothing unsaved, and HEAD exactly the release branch on origin
// The check itself is release-check.mjs, which kit pr --release calls in its own process.
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { releaseCheck } from "../release-check.mjs";

const { kitHideUserInfo, kitOwner, kitResult, kitRoot, kitSettingsFile } = await import(
  pathToFileURL(process.env.KIT_LIB_MJS || resolve(import.meta.dirname, "../kit-lib.mjs")).href
);
const usage = `Usage: kit release-check [--land] [--waive "<reason>"]
Run first by a project's live deploy command, and by kit pr --release. Fails unless the working tree is
clean (no changed or untracked files outside .scratch/) and HEAD is exactly origin/<release> after a
fetch (branches.release in ${kitSettingsFile}, the same branch the push guard reads). Pushes nothing.
--land compares HEAD with origin/<land> instead: kit pr --release checks that the release is cut exactly
from what landed, before origin/<release> is merged into the cut. --waive requires a *-lead owner;
the RESULT line names the reason and what it let through. KIT_RELEASE_CHECK_TIMEOUT: the fetch's limit
in seconds (default 120).
Where land and release are two branches, a warning (never a failure) names the commits origin/<release>
holds outside origin/<land>'s history, merges left out: copies a rebase or squash merge made, or work made
straight on <release>; kit pr --sync-main joins them, or names the merge to make by hand and then lands
that merge when it cannot tell which they are.
`;

class UsageError extends Error {}

function options(args) {
  const flags = {};
  for (let i = 0; i < args.length; i++) {
    const flag = args[i];
    if (!["--land", "--waive"].includes(flag) || Object.hasOwn(flags, flag)) throw new UsageError(`unknown or duplicate option: ${flag}`);
    if (flag === "--waive") {
      const value = args[++i];
      if (!value?.trim() || value.startsWith("-")) throw new UsageError("--waive requires a value");
      flags[flag] = value;
    } else flags[flag] = true;
  }
  if (flags["--waive"] && !kitOwner().endsWith("-lead")) throw new UsageError("--waive requires a *-lead owner");
  return { land: Boolean(flags["--land"]), waive: flags["--waive"] };
}

function main(args) {
  let flags;
  try { flags = options(args); }
  catch (error) {
    if (!(error instanceof UsageError)) throw error;
    process.stderr.write(usage);
    kitResult("fail", `invalid arguments: ${error.message}`);
    return 2;
  }
  try {
    const checked = releaseCheck({ root: resolve(kitRoot()), ...flags });
    for (const warning of checked.warnings) console.log(kitHideUserInfo(warning));
    if (checked.passed) {
      kitResult("ok", `release-check ${checked.summary}`);
      return 0;
    }
    for (const item of checked.problems) console.error(`problem: ${item.what}: ${item.advice}`);
    kitResult("fail", checked.failure);
    return 1;
  } catch (error) {
    kitResult("fail", error.message);
    return 1;
  }
}

if (process.argv.length === 3 && ["--help", "-h"].includes(process.argv[2])) process.stdout.write(usage);
else process.exitCode = main(process.argv.slice(2));
