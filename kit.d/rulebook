#!/usr/bin/env bash
# kit: print the kitchen rulebook: the shared one, then the project's extras
set -euo pipefail
# shellcheck source=scripts/agents/kit-lib.sh
source "${KIT_LIB:-$(dirname -- "${BASH_SOURCE[0]}")/../kit-lib.sh}"
usage='Usage: kit rulebook'
case ${1-} in
  --help|-h)
    printf '%s\n' "$usage"
    printf "Print the kit's shared kitchen rulebook (docs/kitchen.md in the kit), then the project's extras:\n"
    printf 'the file rulebookExtras names in scripts/agents/kit.json, relative to the top folder or absolute.\n'
    printf 'Where they differ, the extras win. Without rulebookExtras only the shared part prints, with a line saying so.\n'
    printf 'A named extras file that cannot be read, or a settings file that cannot be read (broken, or no jq), fails after the shared part.\n'
    exit 0
    ;;
  '') ;;
  *) printf '%s\n' "$usage" >&2; kit_result fail "rulebook unknown argument $1"; exit 2 ;;
esac
# A file without a final newline still leaves the next line, and the RESULT line, on a line of its own.
end_line() { [[ ! -s $1 || -z $(tail -c1 -- "$1") ]] || printf '\n'; }
shared=$(kit_home)/docs/kitchen.md
[[ -r $shared ]] || { kit_result fail "rulebook no shared rulebook at $shared"; exit 1; }
cat -- "$shared"
end_line "$shared"
# Settings that cannot be read (no jq, or a broken file) are not the same as no extras.
extras=$(kit_setting .rulebookExtras) || { kit_result fail 'rulebook cannot read scripts/agents/kit.json without jq; install jq'; exit 1; }
settings=$(kit_settings_file)
if [[ -f $settings ]] && ! problem=$(jq empty -- "$settings" 2>&1); then
  kit_result fail "rulebook cannot read scripts/agents/kit.json: ${problem//$'\n'/ }"
  exit 1
fi
if [[ -z $extras ]]; then
  printf '\nNo project extras: add "rulebookExtras" to scripts/agents/kit.json.\n'
  kit_result ok 'rulebook shared only'
  exit 0
fi
file=$extras
[[ $file == /* ]] || file=$(kit_root)/$file
if [[ ! -f $file || ! -r $file ]]; then
  kit_result fail "rulebook extras $extras cannot be read"
  exit 1
fi
printf '\n'
cat -- "$file"
end_line "$file"
kit_result ok "rulebook shared and $extras"
